---
// Fonts are self-hosted via @fontsource (no Google Fonts CDN, for privacy).
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/bricolage-grotesque/latin-500.css';
import '@fontsource/bricolage-grotesque/latin-700.css';
import '@fontsource/bricolage-grotesque/latin-800.css';
import '../styles/global.css';

import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getSite } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  /** Path under /uploads/ for the social share image */
  ogImage?: string;
}

const site = await getSite();
const { title, description = site.description, ogImage } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.tagline.replace(/\.$/, '')}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Pages with their own photo use it; everything else uses the branded share card (public/og-image.jpg,
// made from scripts/qa/og-image-source.html)
const ogImageUrl = new URL(url(ogImage ?? '/og-image.jpg'), Astro.site).href;
const ogIsDefault = !ogImage;

// Site search (Pagefind): index each page's main content, tagged with a type for the search filters.
// The homepage and search page are left out (they only repeat what's on other pages).
const path = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '');
const noSearch = path === '/' || path.startsWith('/search') || path.startsWith('/404');
const searchType = path.startsWith('/news/')
  ? 'News'
  : path.startsWith('/photos/')
    ? 'Photos'
    : /^\/(wolfspit|tour-of-bradwell|races)\//.test(path)
      ? 'Results'
      : path.startsWith('/events/')
        ? 'Events'
        : path.startsWith('/members/')
          ? 'Members'
          : 'Pages';
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="192x192" href={url('/icon-192.png')} />
    <link rel="apple-touch-icon" href={url('/apple-touch-icon.png')} />
    <link rel="manifest" href={url('/manifest.webmanifest')} />
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta name="theme-color" content="#1D3B2C" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImageUrl} />
    {ogIsDefault && <meta property="og:image:width" content="1200" />}
    {ogIsDefault && <meta property="og:image:height" content="630" />}
    <meta property="og:image:alt" content={ogIsDefault ? 'Bradda Dads: raising money for Bradwell since 1999' : fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" data-pagefind-body={noSearch ? undefined : ''} data-pagefind-filter={noSearch ? undefined : `type:${searchType}`}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
