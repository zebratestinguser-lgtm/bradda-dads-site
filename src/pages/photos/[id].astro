---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import ComingUp from '../../components/ComingUp.astro';
import { getAlbums, photoDate, categorySlug } from '../../lib/albums';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const albums = await getAlbums();
  return albums.map((album, i) => ({
    params: { id: album.id },
    props: { album, newer: albums[i - 1], older: albums[i + 1] },
  }));
}

const { album, newer, older } = Astro.props;
const { Content } = await render(album);
const event = album.data.event ? await getEntry(album.data.event) : undefined;
const story = (await getCollection('news', (n) => !n.data.draft)).find((n) => n.data.album?.id === album.id);
const when = photoDate(album);
const photos = album.data.photos;
const cat = album.data.category;
---

<BaseLayout
  title={`${album.data.title}: photos`}
  description={`${photos.length} photos from ${album.data.title}, taken ${when}.`}
  ogImage={album.data.cover ?? photos[0]?.src}
>
  <PageHeader eyebrow="Photo album" title={album.data.title}>
    <p class="album-when">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path>
      </svg>
      <span>Photos taken <strong>{when}</strong> · {photos.length} photo{photos.length === 1 ? '' : 's'}</span>
    </p>
    <ul class="album-links" role="list">
      {story && <li><a href={url(`/news/${story.id}/`)}>Read the story →</a></li>}
      {cat && <li><a href={url(`/photos/category/${categorySlug(cat)}/`)}>All {cat} photos →</a></li>}
      {event && <li><a href={url(`/events/${event.id}/`)}>About the {event.data.name} →</a></li>}
      <li><a href={url('/photos/')}>All albums →</a></li>
    </ul>
  </PageHeader>

  <section class="container page-section">
    {photos.length === 0 ? <p class="note">Photos for this album are coming soon.</p> : <PhotoGrid album={album} eagerCount={8} />}

    <div class="prose album-text"><Content /></div>

    {album.data.source && (
      <p class="album-source">
        From the old Bradda Dads website: <a href={album.data.source}>view the original</a>.
      </p>
    )}

    <ComingUp topic={cat} />

    <nav class="album-nav" aria-label="More albums">
      {newer ? <a href={url(`/photos/${newer.id}/`)}>← Newer: {newer.data.title} ({photoDate(newer)})</a> : <span />}
      {older && <a href={url(`/photos/${older.id}/`)}>Older: {older.data.title} ({photoDate(older)}) →</a>}
    </nav>
  </section>

  <Lightbox />
</BaseLayout>

<style>
  .album-when {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 17px;
    color: var(--on-dark-soft);
  }
  .album-when strong {
    color: var(--yellow);
  }
  .album-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .album-links a {
    color: var(--white);
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .album-text {
    margin-top: 32px;
  }
  /* Phones: the four links sit as compact pills two to a row rather than four long lines */
  @media (max-width: 600px) {
    .album-links {
      gap: 8px;
    }
    .album-links a {
      font-size: 14px;
      min-height: 40px;
      padding: 0 14px;
      border-radius: var(--radius-pill);
      background: rgba(255, 255, 255, 0.1);
      text-decoration: none;
    }
  }
  .album-text:empty {
    display: none;
  }
  .album-source {
    margin-top: 24px;
    font-size: 15px;
    color: var(--muted);
  }
  .album-nav {
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-weight: 600;
  }
  .album-nav a {
    padding-block: 10px;
  }
</style>
