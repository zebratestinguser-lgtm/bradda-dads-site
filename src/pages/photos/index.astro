---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { NEWS_TAGS } from '../../content.config';
import { getAlbums, photoYear, categorySlug, CATEGORY_ORDER } from '../../lib/albums';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
const albums = await getAlbums();
const total = albums.reduce((n, a) => n + a.data.photos.length, 0);

// Categories in a friendly order, with photo counts; each links to a page showing every photo in it
const categories = [...NEWS_TAGS]
  .sort((a, b) => CATEGORY_ORDER.indexOf(a) - CATEGORY_ORDER.indexOf(b))
  .map((c) => ({ name: c, photos: albums.filter((a) => a.data.category === c).reduce((n, a) => n + a.data.photos.length, 0) }))
  .filter((c) => c.photos > 0);

// Group by the year the photos were taken; newest first, "Various years" last
const groups = new Map<string, typeof albums>();
for (const a of albums) {
  const y = photoYear(a);
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(a);
}
const years = [...groups.keys()].sort((a, b) => (a === 'Other' ? 1 : b === 'Other' ? -1 : Number(b) - Number(a)));
const yearName = (y: string) => (y === 'Other' ? 'Various years' : y);
---

<BaseLayout title="Photos" description={`${albums.length} photo albums from Bradda Dads events in Bradwell since 2001.`}>
  <PageHeader
    eyebrow="Photos"
    title="Photo albums"
    intro={`${albums.length} albums and ${total.toLocaleString('en-GB')} photos from Bradda Dads events, going back to 2001. Every album shows when the photos were taken.`}
  >
    <a class="btn btn--yellow btn--md" href={url(site.sharePhotosUrl)}>Share your photos</a>
  </PageHeader>

  <div class="container filters">
    <nav class="filter-row" aria-labelledby="cat-label">
      <p class="filter-row__label" id="cat-label">All photos of:</p>
      <ul class="chips chips--scroll" role="list">
        {
          categories.map((c) => (
            <li>
              <a class="chip" href={url(`/photos/category/${categorySlug(c.name)}/`)}>
                {c.name} <span class="count">{c.photos}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <nav class="filter-row" aria-labelledby="year-label">
      <p class="filter-row__label" id="year-label">Year:</p>
      <ul class="chips chips--small chips--scroll" role="list">
        {years.map((y) => <li data-year-chip={y}><a class="chip" href={`#year-${y}`}>{yearName(y)}</a></li>)}
      </ul>
    </nav>
  </div>

  {
    years.map((y, gi) => (
      <section class="container year-group" id={`year-${y}`} aria-labelledby={`year-${y}-title`} data-year-group={y}>
        <h2 class="subhead" id={`year-${y}-title`}>{yearName(y)}</h2>
        <ul class="card-grid" role="list">
          {groups.get(y)!.map((a, i) => (
            <li data-album-cat={a.data.category ?? ''}>
              <AlbumCard album={a} index={gi + i} />
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>

<script>
  // Old links like /photos/?category=Bonfire now go to that category's own page
  const cat = new URLSearchParams(location.search).get('category');
  if (cat) {
    const slug = cat.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    location.replace(`${location.pathname.replace(/\/?$/, '/')}category/${slug}/`);
  }
</script>

<style>
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    align-self: flex-start;
    margin-top: 6px;
  }
  .filters {
    padding-block: 28px 8px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
  }
  .filter-row__label {
    font-weight: 600;
    color: var(--muted);
    min-width: 110px;
  }
  .filter-row .chips {
    min-width: 0;
    max-width: 100%;
  }
  @media (max-width: 600px) {
    .filter-row {
      flex-direction: column;
      align-items: stretch;
    }
  }
  .chip .count {
    font-size: 13px;
    opacity: 0.7;
    margin-left: 6px;
  }
  .chips--small .chip {
    min-height: 40px;
    font-size: 14px;
  }
  .year-group {
    padding-block: 28px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    scroll-margin-top: 90px;
  }
  .year-group:last-child {
    padding-bottom: var(--section-pad);
  }
</style>
