---
import { getWording } from '../../lib/wording';
const w = await getWording('photos'); // Page wording form
import { url } from '../../lib/url';
import Img from '../../components/Img.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import PageHeader from '../../components/PageHeader.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { getAlbums, photoYear, categorySlug } from '../../lib/albums';
import { categoryNames } from '../../lib/categories';
import { getSite } from '../../lib/site';
import { categoryPhoto, photoMatching } from '../../lib/photos';

const site = await getSite();
const albums = await getAlbums();
const total = albums.reduce((n, a) => n + a.data.photos.length, 0);

// Categories in a friendly order, with photo counts; each links to a page showing every photo in it
const listed = await categoryNames();
const categories = [...listed, ...new Set(albums.map((a) => a.data.category ?? '').filter((c) => c && !listed.includes(c)))]
  .map((c) => ({ name: c, photos: albums.filter((a) => a.data.category === c).reduce((n, a) => n + a.data.photos.length, 0) }))
  .filter((c) => c.photos > 0);
// A photo for each category tile, and one for the page header
const tiles = await Promise.all(categories.map(async (c) => ({ ...c, photo: await categoryPhoto(c.name) })));
const header = await photoMatching(/ducks pour over the yellow barrier/i, /ducks tumbling over the weir/i);

// Group by the year the photos were taken; newest first, "Various years" last
const groups = new Map<string, typeof albums>();
for (const a of albums) {
  const y = photoYear(a);
  if (!groups.has(y)) groups.set(y, []);
  groups.get(y)!.push(a);
}
const years = [...groups.keys()].sort((a, b) => (a === 'Other' ? 1 : b === 'Other' ? -1 : Number(b) - Number(a)));
const yearName = (y: string) => (y === 'Other' ? 'Various years' : y);
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description', { albums: albums.length, photos: total.toLocaleString('en-GB') })} ogImage={header?.src} ogImageAlt={header?.alt}>
  <PageHeader
    eyebrow={w.text('eyebrow')}
    title={w.text('title')}
    intro={w.text('intro', { albums: albums.length, photos: total.toLocaleString('en-GB') })}
    image={header?.src}
    imageLabel={header?.label}
  >
    <a class="btn btn--yellow btn--md" href={url(site.sharePhotosUrl)}>{w.text('shareButton')}</a>
  </PageHeader>

  <!-- Browse by event: one big photo tile per category -->
  <Band first>
    <section class="container page-section stack" aria-labelledby="browse-title">
      <h2 class="subhead" id="browse-title">{w.text('browseTitle')}</h2>
      <ul class="tiles" role="list">
        {
          tiles.map((c) => (
            <li>
              <a class="tile" href={url(`/photos/category/${categorySlug(c.name)}/`)}>
                {c.photo && <Img kind="grid" class="tile__img" src={c.photo.src} sizes="(max-width: 600px) 50vw, 320px" alt="" loading="lazy" decoding="async" />}
                <span class="tile__shade" aria-hidden="true" />
                <span class="tile__text">
                  <span class="tile__name">{c.name}</span>
                  <span class="tile__count">{c.photos.toLocaleString('en-GB')} photos</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Band>

  <!-- Every album, newest first, in one continuous grid; the year buttons jump to each year's first album -->
  <Band tone="mist">
    <section class="container page-section stack" aria-labelledby="all-title">
      <div class="all-head">
        <h2 class="subhead" id="all-title">{w.text('allTitle')}</h2>
        <nav aria-label="Jump to a year">
          <ul class="chips chips--small chips--scroll" role="list">
            {years.map((y) => <li><a class="chip" href={`#year-${y}`}>{yearName(y)}</a></li>)}
          </ul>
        </nav>
      </div>
      <ul class="albums" role="list">
        {
          years.map((y, gi) =>
            groups.get(y)!.map((a, i) => (
              <li id={i === 0 ? `year-${y}` : undefined} class:list={{ 'year-start': i === 0 }}>
                <AlbumCard album={a} index={gi + i} />
              </li>
            )),
          )
        }
      </ul>
    </section>
  </Band>
</BaseLayout>

<script>
  // Old links like /photos/?category=Bonfire now go to that category's own page
  const cat = new URLSearchParams(location.search).get('category');
  if (cat) {
    const slug = cat.toLowerCase().replace(/['’]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');
    location.replace(`${location.pathname.replace(/\/?$/, '/')}category/${slug}/`);
  }
</script>

<style>
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    align-self: flex-start;
    margin-top: 6px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .tiles {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(210px, 100%), 1fr));
    gap: 14px;
  }
  .tile {
    position: relative;
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--green);
    color: var(--white);
    text-decoration: none;
  }
  .tile:hover {
    color: var(--white);
  }
  .tile__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(16, 36, 26, 0) 35%, rgba(16, 36, 26, 0.88) 100%);
  }
  .tile__text {
    position: absolute;
    left: 16px;
    right: 16px;
    bottom: 14px;
    display: flex;
    flex-direction: column;
  }
  .tile__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.1;
  }
  .tile__count {
    font-size: 14px;
    color: var(--on-dark-soft);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile__img {
      transition: transform 0.3s ease;
    }
    .tile:hover .tile__img {
      transform: scale(1.05);
    }
  }
  .all-head {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .chips--small .chip {
    min-height: 40px;
    font-size: 14px;
  }
  .albums {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr));
    gap: 24px 18px;
  }
  .year-start {
    scroll-margin-top: 96px;
  }
  @media (max-width: 600px) {
    .albums {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px 12px;
    }
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px;
    }
    .tile {
      aspect-ratio: 1 / 1;
    }
    .tile__text {
      left: 12px;
      right: 12px;
      bottom: 10px;
    }
    .tile__name {
      font-size: 17px;
    }
    .tile__count {
      font-size: 12.5px;
    }
  }
</style>
