---
// Meet the dads: a group photo and introduction, then a card per member.
// A member's card (and profile page) only appears once their real name replaces "[MEMBER NAME]"
// in src/content/members/, so the page never shows blank placeholder cards.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import PageHeader from '../../components/PageHeader.astro';
import MemberAvatar from '../../components/MemberAvatar.astro';
import { getPublishedMembers, memberSince } from '../../lib/members';
import { dadsGroupPhoto } from '../../lib/photos';
import { photoDate } from '../../lib/albums';
import { getSite } from '../../lib/site';
import { isPlaceholder } from '../../lib/events';
import { url } from '../../lib/url';

const site = await getSite();
const members = await getPublishedMembers();
const group = await dadsGroupPhoto();
---

<BaseLayout title="Meet the dads" description="The volunteers behind Bradda Dads: who they are, what they do, and how long they've been part of it.">
  <PageHeader eyebrow="Meet the dads" title="The people behind the ducks" intro="Every event is run by volunteers: dads from the parish who give up their evenings, weekends and Boxing Day mornings for the village." />

  <Band first>
    <section class="container page-section intro" aria-labelledby="intro-title">
      {
        group && (
          <figure class="intro__photo">
            <img src={url(group.src)} alt={group.alt} loading="eager" decoding="async" />
            <figcaption>Photo taken {photoDate(group.album)}</figcaption>
          </figure>
        )
      }
      <div class="intro__text">
        <h2 class="subhead" id="intro-title">Come and meet us</h2>
        <p>We meet {site.meetingInfo}. New faces are always welcome, whether you want to join or just lend a hand at an event.</p>
        <div class="intro__actions">
          <a class="btn btn--green btn--md" href={url('/get-involved/')}>Get involved</a>
          <a class="link-arrow" href={url('/our-story/')}>Our story →</a>
        </div>
      </div>
    </section>
  </Band>

  <Band tone="mist">
    <section class="container page-section stack" aria-labelledby="members-title">
      <h2 class="subhead" id="members-title">The dads</h2>
      {
        members.length > 0 ? (
          <ul class="members" role="list">
            {members.map((m) => (
              <li>
                <a class="member" href={url(`/members/${m.id}/`)}>
                  <MemberAvatar member={m} size={112} />
                  <div class="member__body">
                    <h3 class="member__name">{m.data.name}</h3>
                    {m.data.role && <span class="member__role">{m.data.role}</span>}
                    {m.data.joined && <span class="member__since">{memberSince(m)}</span>}
                    {!isPlaceholder(m.data.summary) && <p class="member__summary">{m.data.summary}</p>}
                  </div>
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="note soon">
            Profiles are on their way: we're asking each of the dads whether they're happy to appear here. In the meantime, the best way to meet them is at one of
            our <a href={url('/events/')}>events</a>.
          </p>
        )
      }
    </section>
  </Band>
</BaseLayout>

<style>
  .intro {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 36px 48px;
    align-items: center;
  }
  .intro__photo {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .intro__photo img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-lg);
  }
  .intro__photo figcaption {
    font-size: 14px;
    color: var(--muted);
  }
  .intro__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
    font-size: 18px;
    line-height: 1.6;
    color: var(--muted-strong);
  }
  .intro__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    margin-top: 4px;
  }
  .btn--md {
    min-height: 50px;
    padding: 0 24px;
    font-size: 17px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .soon {
    max-width: 68ch;
    font-size: 17px;
    line-height: 1.6;
  }
  .members {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 20px;
  }
  .member {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 16px;
    padding: 30px 24px 26px;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    color: var(--text);
    text-decoration: none;
    background: var(--white);
  }
  .member:hover {
    color: var(--text);
  }
  .member:hover .member__name {
    text-decoration: underline;
  }
  .member__body {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
  }
  .member__name {
    font-size: 23px;
    line-height: 1.15;
  }
  .member__role {
    background: var(--green);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
  }
  .member__since {
    font-size: 14px;
    font-weight: 600;
    color: var(--yellow-ink);
  }
  .member__summary {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-strong);
    margin-top: 4px;
  }
  @media (max-width: 800px) {
    .intro {
      grid-template-columns: 1fr;
    }
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .member {
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .member:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(16, 36, 26, 0.14);
    }
  }
</style>
