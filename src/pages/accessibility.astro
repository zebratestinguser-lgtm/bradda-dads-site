---
import { getWording } from '../lib/wording';
const w = await getWording('accessibility'); // Page wording form
// Accessibility statement: what standard the site aims for, how it's checked, what isn't finished yet,
// and how to report a problem. The number of photos still awaiting a description is counted at build.
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import { getAlbums } from '../lib/albums';
import { GENERIC } from '../lib/photos';

const albums = await getAlbums();
const photos = albums.flatMap((a) => a.data.photos);
const generic = photos.filter((p) => GENERIC.test(p.alt)).length;
const described = photos.length - generic;
// The automatic sentence the statement's {photo-descriptions} marker turns into
const photoSentence =
  generic === 0
    ? `Every one of our ${photos.length.toLocaleString('en-GB')} photos has a short description, with when it was taken.`
    : `We have described ${described.toLocaleString('en-GB')} of our ${photos.length.toLocaleString('en-GB')} photos. The other ${generic.toLocaleString('en-GB')} only say which album they're from and when they were taken.`;
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description')}>
  <PageHeader eyebrow={w.text('eyebrow')} title={w.text('title')} intro={w.text('intro')} />

  <Band first>
    <section class="container page-section prose statement">
      <Fragment set:html={w.html('statement', { 'photo-descriptions': photoSentence })} />
      <p class="updated">{w.text('updatedNote')}</p>
    </section>
  </Band>
</BaseLayout>

<style>
  .statement {
    max-width: 72ch;
  }
  .updated {
    font-size: 15px;
    color: var(--muted);
  }
</style>
