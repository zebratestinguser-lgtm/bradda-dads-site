---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite } from '../lib/site';
import { url } from '../lib/url';

const site = await getSite();
const card = await getEntry('events', 'christmas-card');
const { Content } = card ? await render(card) : { Content: null };
const open = card?.data.status === 'open';
---

<BaseLayout title="Village Christmas card" description="One shared Christmas card for the whole village. Add your family's message for £5, and every penny goes back into Bradwell.">
  <PageHeader eyebrow={open ? 'Open now' : 'Village Christmas card'} title={card?.data.heroTitle ?? 'One card for the whole village'} intro={card?.data.heroText ?? card?.data.summary}>
    {card?.data.heroNote && <p class="closes">{card.data.heroNote}</p>}
  </PageHeader>

  <section class="container page-section layout">
    <div class="steps-col">
      <h2 class="subhead">How it works</h2>
      <ol class="steps">
        <li>
          <strong>Write your message.</strong> A line or two from your family to the village, such as "Merry Christmas from the family at No. 12".
        </li>
        <li>
          <strong>Pay £5.</strong> Secure payment by SumUp.
        </li>
        <li>
          <strong>Look out for the card.</strong> Every message goes on the one shared village card, and every penny goes back into Bradwell.
        </li>
      </ol>

      {
        open ? (
          <div class="enter">
            <a class="btn btn--green btn--md" href={url(site.christmasCardPaymentUrl)}>Pay £5 with SumUp</a>
            <p class="note">
              [PLACEHOLDER: the message form arrives in milestone 5. Until then, explain how families send their message, e.g. with the SumUp payment note or by email.]
            </p>
          </div>
        ) : (
          <p class="note">Entries for this year's card aren't open yet. Check back in December, or follow us on <a href={site.facebookUrl}>Facebook</a>.</p>
        )
      }
    </div>

    <div class="prose details">
      {Content && <Content />}
      <p>
        The 'Dads have a long history of Christmas cards: in 2008 the infant and junior schools designed a card that was given to every pensioner at the Christmas lunch (<a href={url('/news/2008-12-09-christmas-card-competition-2008/')}>read about it</a>).
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .closes {
    font-weight: 600;
    color: var(--yellow);
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }
  .steps-col {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .details {
    flex: 1 1 340px;
  }
  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
  }
  .steps strong {
    color: var(--text);
  }
  .enter {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .btn--md {
    min-height: 50px;
    padding: 0 24px;
    font-size: 17px;
  }
</style>
