---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite } from '../lib/site';
import { url } from '../lib/url';
import { getWording } from '../lib/wording';
import { isOpen } from '../lib/events';

const site = await getSite();
const w = await getWording('christmas-card'); // Page wording → Christmas card page
const steps = w.list<{ title: string; text: string }>('steps');
const card = await getEntry('events', 'christmas-card');
// Open only until the deadline (entriesClose), not just while the status says "open"
const open = card ? isOpen(card) : false;
---

<BaseLayout title="Village Christmas card" description={w.text('description')}>
  <PageHeader eyebrow={open ? 'Open now' : 'Village Christmas card'} title={card?.data.heroTitle ?? 'One card for the whole village'} intro={card?.data.heroText ?? card?.data.summary}>
    {open && card?.data.heroNote && <p class="closes">{card.data.heroNote}</p>}
  </PageHeader>

  <section class="container page-section layout">
    <div class="steps-col">
      <h2 class="subhead">{w.text('stepsTitle')}</h2>
      <ol class="steps">
        {steps.map((st) => (
          <li>
            <strong>{st.title}</strong> {st.text}
          </li>
        ))}
      </ol>

      {
        open ? (
          <div class="enter">
            <a class="btn btn--green btn--md" href={url(site.christmasCardPaymentUrl)}>{w.text('payButton')}</a>
            <div class="note" set:html={w.html('openNote')} />
          </div>
        ) : (
          <div class="note" set:html={w.html('closedNote', { facebook: site.facebookUrl })} />
        )
      }
    </div>

    <div class="prose details" set:html={w.html('details')} />
  </section>
</BaseLayout>

<style>
  .closes {
    font-weight: 600;
    color: var(--yellow);
  }
  .layout {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
  }
  .steps-col {
    flex: 1 1 340px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .details {
    flex: 1 1 340px;
  }
  .steps {
    margin: 0;
    padding-left: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
  }
  .steps strong {
    color: var(--text);
  }
  .enter {
    display: flex;
    flex-direction: column;
    gap: 12px;
    align-items: flex-start;
  }
  .btn--md {
    min-height: 50px;
    padding: 0 24px;
    font-size: 17px;
  }
</style>
