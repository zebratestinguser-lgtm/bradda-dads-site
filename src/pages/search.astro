---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Search" description="Search news, photo albums, race results and events on the Bradda Dads website.">
  <PageHeader eyebrow="Search" title="Search the site" intro="News going back to 2001, photo albums, race results and events. Try a year, an event or a runner's name." />
  <section class="container page-section">
    <link rel="stylesheet" href={url('/pagefind/pagefind-ui.css')} />
    <label class="search__label" id="search-label">Search the site</label>
    <div id="search" class="search" data-bundle={url('/pagefind/')} data-base={import.meta.env.BASE_URL}></div>
    <noscript><p class="note">Search needs JavaScript. You can browse <a href={url('/news/')}>news</a>, <a href={url('/photos/')}>photos</a> and <a href={url('/races/')}>race results</a> instead.</p></noscript>
    <p class="note search__dev" hidden data-search-missing>
      The search index is created when the site is built (<code>npm run build</code>), so search isn't available in the local preview.
    </p>
    <div class="ideas">
      <p>Try:</p>
      <ul class="chips" role="list">
        {['duck race 2008', 'carnival float', 'pensioners lunch', 'bonfire', 'Wolf\'s Pit 2025'].map((q) => (
          <li><a class="chip" href={`?q=${encodeURIComponent(q)}`}>{q}</a></li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  // Pagefind UI is created at build time in /pagefind/ (see "postbuild" in package.json)
  const el = document.getElementById('search');
  if (el) {
    const bundle = el.dataset.bundle!;
    const s = document.createElement('script');
    s.src = `${bundle}pagefind-ui.js`;
    s.onload = () => {
      // @ts-expect-error: global added by pagefind-ui.js
      const ui = new window.PagefindUI({
        element: '#search',
        bundlePath: bundle,
        baseUrl: el.dataset.base,
        showSubResults: true,
        showImages: true,
        resetStyles: false,
        translations: { placeholder: 'Search news, photos, results…', zero_results: 'Nothing found for [SEARCH_TERM]. Try fewer or different words.' },
      });
      const q = new URLSearchParams(location.search).get('q');
      if (q) ui.triggerSearch(q);
      // Pagefind's input only has a placeholder; give it a real, visible label (WCAG 3.3.2 / 4.1.2)
      const input = el.querySelector<HTMLInputElement>('input');
      const label = document.getElementById('search-label') as HTMLLabelElement | null;
      if (input && label) {
        input.id = 'site-search';
        label.htmlFor = 'site-search';
        input.removeAttribute('title');
      }
      input?.focus();
    };
    s.onerror = () => {
      const msg = document.querySelector<HTMLElement>('[data-search-missing]');
      if (msg) msg.hidden = false;
    };
    document.head.appendChild(s);
  }
</script>

<style>
  .search {
    /* Pagefind UI, in Bradda Dads colours */
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: var(--green);
    --pagefind-ui-text: var(--text);
    --pagefind-ui-background: var(--white);
    --pagefind-ui-border: var(--input-border);
    --pagefind-ui-tag: var(--yellow-panel);
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 14px;
    --pagefind-ui-image-border-radius: 12px;
    --pagefind-ui-font: var(--font-body);
    max-width: 860px;
  }
  .search :global(.pagefind-ui__search-input) {
    min-height: 56px;
    font-size: 18px;
  }
  .search :global(.pagefind-ui__result-link) {
    color: var(--green);
  }
  .search :global(mark) {
    background: var(--yellow-panel);
    color: var(--text);
  }
  /* Pagefind's own rule loads later with equal specificity, so these need !important */
  .search :global(.pagefind-ui__filter-checkbox) {
    width: 24px !important;
    height: 24px !important;
  }
  .search :global(.pagefind-ui__filter-label) {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
  }
  .search__label {
    display: block;
    font-weight: 600;
    color: var(--muted-strong);
    margin-bottom: 8px;
  }
  .ideas {
    margin-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
    color: var(--muted);
  }
  .search__dev {
    margin-top: 16px;
  }
</style>
