---
// Donate: the online giving box, other ways to help, and a pointer to where the money goes.
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import DonateSection from '../components/home/DonateSection.astro';
import { photoMatching } from '../lib/photos';
import { url } from '../lib/url';
import { getWording } from '../lib/wording';
import { featuredProjects } from '../lib/funded';

const header = await photoMatching(/two children sitting in a giant wooden duck/i, /giant wooden duck/i);
const w = await getWording('donate');
// The projects ticked "Show on the homepage" (editor: Where the money goes); wording: Page wording → Donate
const { shown: funded, more } = await featuredProjects();
const ways = w.list<{ title: string; text: string; link: string; label: string }>('ways');
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description')} ogImage={header?.src} ogImageAlt={header?.alt}>
  <PageHeader
    eyebrow={w.text('eyebrow')}
    title={w.text('title')}
    intro={w.text('intro')}
    image={header?.src}
    imageLabel={header?.label}
  />

  <Band first>
    <DonateSection wording={w} />
    <div class="container page-section money">
      <p class="money__text">{w.text('moneyLead')}</p>
      <ul class="money__list" role="list">
        {funded.map((f) => <li>{f.data.name}</li>)}
        {more > 0 && <li class="money__more"><a href={url('/where-the-money-goes/')}>and {more} more</a></li>}
      </ul>
      <a class="link-arrow" href={url('/where-the-money-goes/')}>{w.text('moneyLink')}</a>
    </div>
  </Band>

  <Band tone="mist">
    <section class="container page-section stack" aria-labelledby="ways-title">
      <h2 class="subhead" id="ways-title">{w.text('waysTitle')}</h2>
      <ul class="ways" role="list">
        {
          ways.map((way) => (
            <li class="way">
              <h3 class="way__title">{way.title}</h3>
              <p class="way__text">{way.text}</p>
              <a class="link-arrow" href={url(way.link)}>
                {way.label} →
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </Band>
</BaseLayout>

<style>
  .money {
    padding-top: 28px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .money__text {
    font-weight: 600;
    color: var(--muted-strong);
  }
  .money__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .money__list li {
    background: var(--yellow-panel);
    color: var(--yellow-ink);
    font-size: 14px;
    font-weight: 600;
    padding: 6px 12px;
    border-radius: var(--radius-pill);
  }
  .money__list li.money__more {
    background: none;
    border: 1px dashed var(--yellow-ink);
  }
  .money__more a {
    color: inherit;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 16px;
  }
  .way {
    background: var(--panel);
    border-radius: var(--radius-card);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .way__title {
    font-size: 21px;
  }
  .way__text {
    font-size: 16px;
    line-height: 1.5;
    color: var(--muted-strong);
    flex-grow: 1;
  }
</style>
