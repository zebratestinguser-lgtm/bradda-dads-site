---
import { getWording } from '../lib/wording';
// Contact: a message form (Formspree, free plan) once contactFormUrl is set in site.yaml, plus the other ways
// to reach us. Without JavaScript the form still works: Formspree shows its own thank-you page.
import BaseLayout from '../layouts/BaseLayout.astro';
import MeetingPubs from '../components/MeetingPubs.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite } from '../lib/site';
import { photoMatching } from '../lib/photos';
import { url } from '../lib/url';

const site = await getSite();
const hasEmail = !site.contactEmail.startsWith('[');
const hasForm = site.contactFormUrl.startsWith('https://');
// "What's it about?" choices. Other pages can link straight to one, e.g. /contact/?topic=support
const w = await getWording('contact'); // Page wording → Contact
// Form topics: key goes in links (/contact/?topic=support), label is what people see
const TOPICS = w.list<{ key: string; label: string }>('topics').map((t) => ({ value: t.key, label: t.label }));
const header = await photoMatching(/two dads shaking hands/i, /dads round a long table/i);
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description')} ogImage={header?.src} ogImageAlt={header?.alt}>
  <PageHeader eyebrow={w.text('eyebrow')} title={w.text('title')} intro={w.text('intro')} image={header?.src} imageLabel={header?.label} />

  <Band first>
    <section class:list={['container', 'page-section', 'layout', { 'layout--form': hasForm }]}>
      {
        hasForm && (
          <div class="form-card">
            <h2 class="subhead">{w.text('formTitle')}</h2>
            <form class="form" action={site.contactFormUrl} method="POST" data-contact-form>
              <input type="hidden" name="_subject" value="Message from the Bradda Dads website" />
              {/* Spam trap: hidden from people, bots fill it in and Formspree drops the message */}
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" aria-hidden="true" class="gotcha" />
              <div class="form-field">
                <label for="c-topic">What's it about?</label>
                <select id="c-topic" name="topic" data-topic>
                  {TOPICS.map((t) => <option value={t.label} data-key={t.value}>{t.label}</option>)}
                </select>
              </div>
              <div class="form-field">
                <label for="c-name">Your name</label>
                <input id="c-name" name="name" type="text" autocomplete="name" required />
              </div>
              <div class="form-field">
                <label for="c-email">Your email</label>
                <input id="c-email" name="email" type="email" autocomplete="email" required />
                <p class="hint">{w.text('emailHint')}</p>
              </div>
              <div class="form-field">
                <label for="c-message">Message</label>
                <textarea id="c-message" name="message" rows="6" required />
              </div>
              <button class="btn btn--green btn--md" type="submit" data-submit>
                {w.text('sendButton')}
              </button>
              <p class="status" role="status" aria-live="polite" data-status />
              <p class="small" set:html={w.inline('formNote')} />
            </form>
          </div>
        )
      }

      <div class="cards">
        <div class="card">
          <h2 class="card__title">{w.text('facebookTitle')}</h2>
          <p>{w.text('facebookText')}</p>
          <a class="btn btn--green btn--md" href={site.facebookUrl} rel="noopener">
            {w.text('facebookButton')}
          </a>
        </div>
        {
          hasEmail && (
            <div class="card">
              <h2 class="card__title">{w.text('emailTitle')}</h2>
              <p>
                <a href={`mailto:${site.contactEmail}`}>{site.contactEmail}</a>
              </p>
            </div>
          )
        }
        <div class="card">
          <h2 class="card__title">{w.text('meetTitle')}</h2>
          <p>We meet {site.meetingInfo}.</p>
          <MeetingPubs />
          <a class="link-arrow" href={url('/get-involved/')}>Get involved →</a>
        </div>
        <div class="card">
          <h2 class="card__title">{w.text('extraTitle')}</h2>
          <Fragment set:html={w.html('extraText')} />
        </div>
      </div>
    </section>
  </Band>
</BaseLayout>

<script>
  // Send in the background and show the result here, instead of leaving for Formspree's page
  const form = document.querySelector<HTMLFormElement>('[data-contact-form]');
  if (form) {
    // Pre-pick the topic from the link (?topic=support etc.)
    const key = new URLSearchParams(location.search).get('topic');
    const opt = key && form.querySelector<HTMLOptionElement>(`[data-topic] option[data-key="${CSS.escape(key)}"]`);
    if (opt) opt.selected = true;
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const button = form.querySelector<HTMLButtonElement>('[data-submit]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      button.disabled = true; // avoid sending twice
      status.className = 'status';
      status.textContent = 'Sending…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form), headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        status.classList.add('status--ok');
        status.textContent = "Thanks, your message has been sent. We'll get back to you soon.";
      } catch {
        status.classList.add('status--error');
        status.textContent = "Sorry, that didn't send. Please try again, or email us instead.";
      } finally {
        button.disabled = false;
      }
    });
  }
</script>

<style>
  .gotcha {
    display: none;
  }
  .layout {
    display: grid;
    gap: 24px;
  }
  .layout--form {
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: start;
  }
  @media (max-width: 860px) {
    .layout--form {
      grid-template-columns: 1fr;
    }
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 16px;
  }
  .layout--form .cards {
    grid-template-columns: 1fr;
  }
  .card,
  .form-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px 26px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    font-size: 17px;
    color: var(--muted-strong);
    background: var(--white);
  }
  .form-card {
    gap: 18px;
  }
  .card__title {
    color: var(--text);
    font-size: 22px;
  }
  .form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .hint,
  .small {
    font-size: 14px;
    color: var(--muted);
  }
  .status:empty {
    display: none;
  }
  .status {
    font-weight: 600;
  }
  .status--ok {
    color: var(--green);
  }
  .status--error {
    color: #a3361b;
  }
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    align-self: flex-start;
  }
</style>
