  }
  .ctrl:active {
    background: var(--green-hover);
  }
  .ctrl-stack {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .ctrl--small {
    min-height: 48px;
  }
  .ctrl--pause {
    flex: 0 0 auto;
    min-height: 44px;
    padding: 0 28px;
    background: var(--white);
    color: var(--green);
    border: 2px solid var(--green);
  }
  .how {
    display: flex;
    flex-direction: column;
    gap: 16px;
    max-width: 72ch;
  }
  .how__list {
    margin: 0;
    padding-left: 20px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
  }
  .how__more {
    font-size: 17px;
  }

  .hud__gold {
    position: absolute;
    top: 46px;
    left: 50%;
    transform: translateX(-50%);
    background: #ffd84d;
    color: var(--text);
    font-weight: 700;
    white-space: nowrap;
  }
  .overlay__season {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    color: var(--on-dark-soft);
  }
  .controls-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
  }
</style>
