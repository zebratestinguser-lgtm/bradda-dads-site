---
// Duck Dash: a little game. Steer a duck down Bradwell Brook between its stone walls. Dodge branches, rocks,
// and whirlpools; rescue ducklings (they follow in a line and act as lives); numbered race ducks knock
// you about if you bump them; catch the golden duck for double points. The brook changes with the seasons. Optional quacks
// and vibration. Everything is drawn on a canvas; no libraries, no sound files (sounds are synthesised).
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import { url } from '../lib/url';
---

<BaseLayout title="Duck Dash" description="A little game: steer a duck down Bradwell Brook, dodge the branches and whirlpools, and rescue the lost ducklings.">
  <PageHeader eyebrow="Just for fun" title="Duck Dash" intro="Steer your duck down Bradwell Brook. Dodge the branches, rocks and whirlpools, and rescue the lost ducklings." />

  <Band first>
    <section class="container page-section game-wrap" aria-labelledby="game-title">
      <h2 class="visually-hidden" id="game-title">The game</h2>
      <div class="game" data-game>
        <canvas class="game__canvas" data-canvas tabindex="0" role="img" aria-label="Duck Dash game. Use the arrow keys or the buttons below to steer."></canvas>
        <div class="game__hud" aria-hidden="true">
          <span class="hud__pill">Score <strong data-score>0</strong></span>
          <span class="hud__pill">Ducklings <strong data-chicks>0</strong></span>
          <span class="hud__pill">Best <strong data-best>0</strong></span>
        </div>
        <span class="hud__pill hud__gold" data-gold hidden aria-hidden="true">Golden duck ×2</span>
        <div class="game__overlay" data-overlay>
          <p class="overlay__season" data-season></p>
          <p class="overlay__title" data-overlay-title>Ready?</p>
          <p class="overlay__text" data-overlay-text>Drag, tap or use the arrow keys to steer.</p>
          <button type="button" class="btn btn--yellow overlay__btn" data-start>Start swimming</button>
        </div>
        <p class="visually-hidden" aria-live="polite" data-announce></p>
      </div>
      <div class="controls">
        <button type="button" class="ctrl" data-dir="-1" aria-label="Steer left">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="ctrl-stack">
          <button type="button" class="ctrl ctrl--small" data-diry="-1" aria-label="Swim up">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6" /></svg>
          </button>
          <button type="button" class="ctrl ctrl--small" data-diry="1" aria-label="Swim down">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
        </div>
        <button type="button" class="ctrl" data-dir="1" aria-label="Steer right">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
        </button>
      </div>
      <div class="controls-row">
        <button type="button" class="ctrl ctrl--pause" data-pause>Pause</button>
        <button type="button" class="ctrl ctrl--pause" data-sound aria-pressed="false">Sound &amp; buzz: off</button>
      </div>
    </section>
  </Band>

  <Band tone="mist">
    <section class="container page-section how" aria-labelledby="how-title">
      <h2 class="subhead" id="how-title">How to play</h2>
      <ul class="how__list">
        <li><strong>Steer</strong> left, right, up and down by dragging your finger, using the arrow keys (or W, A, S and D), or the buttons under the game.</li>
        <li><strong>Rescue ducklings</strong> by swimming into them: 10 points each, and they follow you in a line. They're your lives too.</li>
        <li><strong>Bump</strong> a branch or rock and the duckling at the back of your line scatters. Bump with no ducklings left and it's game over.</li>
        <li><strong>Avoid whirlpools.</strong> They pull you in, and their middle spins a duckling away.</li>
        <li><strong>Numbered race ducks</strong> drift down the brook too. Bump one and you both bounce apart, which might send you towards a branch.</li>
        <li>Catch the rare <strong>golden duck</strong> for double points for 10 seconds.</li>
        <li><strong>Swim through the year.</strong> You start in today's season, and every 30 seconds the brook moves on to the next one and runs a little faster. Make it through all four seasons to finish the game, with 25 bonus points for every duckling still in your line.</li>
        <li><strong>Space</strong> or <strong>P</strong> pauses. Quacks and phone buzzes are off until you switch them on.</li>
      </ul>
      <p class="how__more">
        Want to see the real thing? Come to the <a href={url('/events/duck-race/')}>Boxing Day Duck Race</a>.
      </p>
    </section>
  </Band>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-game]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d')!;
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const scoreEl = $('[data-score]');
    const chicksEl = $('[data-chicks]');
    const bestEl = $('[data-best]');
    const goldEl = $('[data-gold]');
    const overlay = $('[data-overlay]');
    const overlayTitle = $('[data-overlay-title]');
    const overlayText = $('[data-overlay-text]');
    const seasonEl = $('[data-season]');
    const startBtn = $<HTMLButtonElement>('[data-start]');
    const pauseBtn = $<HTMLButtonElement>('[data-pause]');
    const soundBtn = $<HTMLButtonElement>('[data-sound]');
    const announce = $('[data-announce]');

    // The game is worked out on a fixed 360 × 560 "board", then scaled to fit the screen
    const W = 360;
    const H = 560;
    const WALL = 30; // stone walls each side of the brook
    const LEFT = WALL;
    const RIGHT = W - WALL;
    const TOP_Y = 170; // how far up the brook the duck can swim…
    const BOTTOM_Y = H - 40; // …and how far back
    const DUCK_R = 14;
    const MAX_LINE = 8; // longest line of ducklings that fits on screen
    // ?test in the address makes the duck unbumpable, so automated checks can play long enough to meet everything
    const TEST = new URLSearchParams(location.search).has('test');

    // ---------- Seasons: the brook follows the calendar ----------
    const month = new Date().getMonth();
    type Season = 'winter' | 'spring' | 'summer' | 'autumn';
    const fromDate: Season = month === 11 || month <= 1 ? 'winter' : month <= 4 ? 'spring' : month <= 7 ? 'summer' : 'autumn';
    // ?season=winter (etc.) previews another season, for checking the look
    const asked = new URLSearchParams(location.search).get('season') as Season | null;
    const startSeason: Season = asked && ['winter', 'spring', 'summer', 'autumn'].includes(asked) ? asked : fromDate;
    // Four levels, one per season: start in today's season and swim through the year in order
    const ORDER: Season[] = ['winter', 'spring', 'summer', 'autumn'];
    const LEVEL_TIME = 30; // seconds per season
    const LOOKS = {
      winter: { name: 'Winter', label: 'Winter on the brook', grass: '#dfe9ee', water: '#93b9d3', deep: '#7aa6c6', bar: '#ffffff' },
      spring: { name: 'Spring', label: 'Spring on the brook', grass: '#6f9a45', water: '#8fb7d6', deep: '#6f9fc4', bar: '#f3a6c2' },
      summer: { name: 'Summer', label: 'Summer on the brook', grass: '#5b8a34', water: '#88b8d8', deep: '#679ec7', bar: '#5f9c45' },
      autumn: { name: 'Autumn', label: 'Autumn on the brook', grass: '#8a7a3a', water: '#8db2cf', deep: '#6d9bbd', bar: '#d9822b' },
    };
    const yearOrder = Array.from({ length: 4 }, (_, i) => ORDER[(ORDER.indexOf(startSeason) + i) % 4]);
    let season: Season = startSeason;
    let SEASON = LOOKS[season];
    let level = 0; // 0–3
    let levelTime = 0;
    let banner: { text: string; sub: string; t: number } | null = null;
    seasonEl.textContent = `Starting in ${LOOKS[startSeason].name.toLowerCase()}` + (month === 11 ? ' · Merry Christmas!' : '');

    // Colours from the site
    const C = {
      ripple: 'rgba(255,255,255,0.45)',
      wall: '#9b9384',
      wallDark: '#7d7566',
      yellow: '#f6c343',
      yellowDark: '#d9a21e',
      gold: '#ffd84d',
      orange: '#e8702a',
      ink: '#1a1f1c',
      bark: '#6b4a2b',
      barkDark: '#4f361f',
      leaf: '#3f6b2f',
      rock: '#8a8f8c',
      rockDark: '#6c716e',
    };

    // ---------- Sound & buzz (off until switched on; sounds are synthesised, no files) ----------
    let soundOn = false;
    try {
      soundOn = localStorage.getItem('duckDashSound') === 'on';
    } catch {}
    let audio: AudioContext | null = null;
    const ensureAudio = () => {
      if (!audio) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AC) audio = new AC();
      }
      if (audio?.state === 'suspended') audio.resume();
      return audio;
    };
    const tone = (freq: number, dur: number, type: OscillatorType, to = freq, vol = 0.15, delay = 0) => {
      const a = soundOn && ensureAudio();
      if (!a) return;
      const t = a.currentTime + delay;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = type;
      o.frequency.setValueAtTime(freq, t);
      o.frequency.exponentialRampToValueAtTime(to, t + dur);
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g).connect(a.destination);
      o.start(t);
      o.stop(t + dur + 0.02);
    };
    const splash = () => {
      const a = soundOn && ensureAudio();
      if (!a) return;
      const len = Math.floor(a.sampleRate * 0.35);
      const buf = a.createBuffer(1, len, a.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len) ** 2;
      const src = a.createBufferSource();
      const filt = a.createBiquadFilter();
      filt.type = 'lowpass';
      filt.frequency.value = 900;
      const g = a.createGain();
      g.gain.value = 0.35;
      src.buffer = buf;
      src.connect(filt).connect(g).connect(a.destination);
      src.start();
    };
    const sfx = {
      quack: () => {
        tone(620, 0.09, 'sawtooth', 380, 0.12);
        tone(560, 0.11, 'sawtooth', 340, 0.12, 0.12);
      },
      bump: () => {
        splash();
        if (soundOn) navigator.vibrate?.(120);
      },
      gold: () => [880, 1109, 1319, 1760].forEach((f, i) => tone(f, 0.18, 'triangle', f, 0.12, i * 0.07)),
      boing: () => tone(220, 0.16, 'sine', 520, 0.12),
      over: () => {
        splash();
        tone(400, 0.5, 'triangle', 120, 0.12, 0.1);
        if (soundOn) navigator.vibrate?.([120, 80, 200]);
      },
    };
    const showSound = () => {
      soundBtn.textContent = `Sound & buzz: ${soundOn ? 'on' : 'off'}`;
      soundBtn.setAttribute('aria-pressed', String(soundOn));
    };
    showSound();
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      try {
        localStorage.setItem('duckDashSound', soundOn ? 'on' : 'off');
      } catch {}
      showSound();
      if (soundOn) sfx.quack();
    });

    let best = 0;
    try {
      best = Number(localStorage.getItem('duckDashBest')) || 0;
    } catch {}
    bestEl.textContent = String(best);

    // ---------- Things in the brook ----------
    type Branch = { kind: 'branch'; y: number; fromLeft: boolean; len: number; thick: number };
    type Rock = { kind: 'rock'; y: number; x: number; r: number };
    type Chick = { kind: 'chick'; y: number; x: number; phase: number };
    type Whirl = { kind: 'whirl'; y: number; x: number; r: number; spun: boolean };
    type Gold = { kind: 'gold'; y: number; x: number; phase: number };
    type Racer = { kind: 'race'; y: number; x: number; num: number; cool: number };
    type Thing = Branch | Rock | Chick | Whirl | Gold | Racer;
    type Leaver = { x: number; y: number; vx: number; vy: number; life: number }; // ducklings leaving the line
    type Bit = { x: number; y: number; vx: number; vy: number; rot: number; size: number; tint: string }; // seasonal snow, leaves, petals

    let duckX = W / 2;
    let targetX = W / 2;
    let duckY = H - 120;
    let targetY = H - 120;
    let steer = 0; // -1, 0 or 1 while a left/right key or button is held
    let steerY = 0; // -1 (up), 0 or 1 (down)
    let speed = 0;
    let distance = 0;
    let points = 0;
    let rescued = 0;
    let kickX = 0; // a knock from a race duck, fading away
    let kickY = 0;
    let goldTime = 0; // seconds of double points left
    let safeTime = 0; // seconds of bump protection left after losing a duckling
    let trail: { x: number; y: number }[] = []; // ducklings following behind (your lives)
    let leavers: Leaver[] = [];
    let things: Thing[] = [];
    let ripples: { x: number; y: number; len: number }[] = [];
    let bits: Bit[] = [];
    let stones: { y: number; side: number; w: number; h: number }[] = [];
    let nextSpawn = 0;
    let raceNum = 1;
    let state: 'ready' | 'playing' | 'paused' | 'over' = 'ready';
    let last = 0;
    let wallOffset = 0;

    const mult = () => (goldTime > 0 ? 2 : 1);
    const score = () => Math.floor(points);

    const makeBit = (anywhere: boolean): Bit => {
      const tints =
        season === 'winter' ? ['#ffffff'] : season === 'autumn' ? ['#d9822b', '#c2452d', '#e0b13a', '#9c5a24'] : season === 'spring' ? ['#f7c6d9', '#ffffff', '#f3a6c2'] : ['#4f8a3a', '#5f9c45'];
      return {
        x: (season === 'winter' ? 0 : LEFT) + Math.random() * (season === 'winter' ? W : RIGHT - LEFT),
        y: anywhere ? Math.random() * H : -10,
        vx: (Math.random() - 0.5) * 12,
        vy: season === 'winter' ? 25 + Math.random() * 25 : 0,
        rot: Math.random() * 6,
        size: season === 'summer' ? 9 + Math.random() * 5 : season === 'winter' ? 1.5 + Math.random() * 2 : 3 + Math.random() * 3,
        tint: tints[Math.floor(Math.random() * tints.length)],
      };
    };

    const reset = () => {
      duckX = targetX = W / 2;
      duckY = targetY = H - 120;
      steer = steerY = 0;
      speed = 150;
      level = 0;
      levelTime = 0;
      season = startSeason;
      SEASON = LOOKS[season];
      banner = { text: SEASON.name, sub: 'Season 1 of 4', t: 2.2 };
      distance = points = rescued = kickX = kickY = 0;
      goldTime = safeTime = 0;
      trail = [];
      leavers = [];
      things = [];
      nextSpawn = 120;
      raceNum = 1 + Math.floor(Math.random() * 400);
      ripples = Array.from({ length: 26 }, () => ({ x: LEFT + Math.random() * (RIGHT - LEFT), y: Math.random() * H, len: 10 + Math.random() * 22 }));
      bits = Array.from({ length: season === 'winter' ? 40 : season === 'summer' ? 5 : 14 }, () => makeBit(true));
      stones = [];
      for (let y = -40; y < H + 40; y += 22) {
        stones.push({ y, side: 0, w: 14 + Math.random() * 10, h: 16 + Math.random() * 6 });
        stones.push({ y: y + 11, side: 1, w: 14 + Math.random() * 10, h: 16 + Math.random() * 6 });
      }
      updateHud();
    };

    const updateHud = () => {
      scoreEl.textContent = String(score());
      chicksEl.textContent = String(trail.length);
      goldEl.hidden = goldTime <= 0;
      if (goldTime > 0) goldEl.textContent = `Golden duck ×2 · ${Math.ceil(goldTime)}s`;
    };

    // ---------- New things, always leaving a way through ----------
    const randX = (margin: number) => LEFT + margin + Math.random() * (RIGHT - LEFT - 2 * margin);
    const spawn = () => {
      const roll = Math.random();
      const gapNeeded = 92; // the duck always has at least this much room to get past
      if (roll < 0.4) {
        const fromLeft = Math.random() < 0.5;
        const len = 90 + Math.random() * (RIGHT - LEFT - gapNeeded - 90);
        things.push({ kind: 'branch', y: -30, fromLeft, len, thick: 16 + Math.random() * 6 });
        if (Math.random() < 0.45) {
          const freeFrom = fromLeft ? LEFT + len + 24 : LEFT + 24;
          const freeTo = fromLeft ? RIGHT - 24 : RIGHT - len - 24;
          if (freeTo > freeFrom) things.push({ kind: 'chick', y: -30, x: freeFrom + Math.random() * (freeTo - freeFrom), phase: Math.random() * 6 });
        }
      } else if (roll < 0.66) {
        const r = 14 + Math.random() * 12;
        things.push({ kind: 'rock', y: -30, x: randX(r + 6), r });
        if (Math.random() < 0.3) things.push({ kind: 'chick', y: -90, x: randX(30), phase: Math.random() * 6 });
      } else if (roll < 0.76 && distance > 600) {
        things.push({ kind: 'whirl', y: -40, x: randX(44), r: 30, spun: false });
      } else if (roll < 0.88) {
        things.push({ kind: 'race', y: -30, x: randX(24), num: raceNum++, cool: 0 });
      } else if (roll < 0.91 && distance > 400) {
        things.push({ kind: 'gold', y: -30, x: randX(30), phase: Math.random() * 6 });
      } else {
        things.push({ kind: 'chick', y: -30, x: randX(30), phase: Math.random() * 6 });
      }
      nextSpawn = Math.max(105, 185 - (speed - 150) * 0.35) + Math.random() * 60; // gaps shrink as the brook speeds up
    };

    // ---------- Collisions ----------
    const hitsBranch = (b: Branch) => {
      const x0 = b.fromLeft ? LEFT - 10 : RIGHT - b.len;
      const x1 = b.fromLeft ? LEFT + b.len : RIGHT + 10;
      const cx = Math.max(x0, Math.min(duckX, x1));
      const cy = Math.max(b.y - b.thick / 2, Math.min(duckY, b.y + b.thick / 2));
      return (duckX - cx) ** 2 + (duckY - cy) ** 2 < (DUCK_R - 2) ** 2;
    };
    const dist2 = (ax: number, ay: number, bx: number, by: number) => (ax - bx) ** 2 + (ay - by) ** 2;
    const near = (x: number, y: number, r: number) => dist2(duckX, duckY, x, y) < (DUCK_R + r) ** 2;

    // Losing the duckling at the back of the line: it swims off to the bank
    const loseDuckling = () => {
      const c = trail.pop();
      if (!c) return false;
      const toLeft = c.x > W / 2;
      leavers.push({ x: c.x, y: c.y, vx: toLeft ? -150 : 150, vy: -40, life: 1.2 });
      return true;
    };
    const bump = () => {
      if (safeTime > 0 || (TEST && trail.length === 0)) return;
      if (loseDuckling()) {
        safeTime = 1.4;
        sfx.bump();
        announce.textContent = `Bump! A duckling swam off. ${trail.length} left in your line.`;
      } else gameOver();
    };

    // ---------- Drawing ----------
    const drawDuck = (x: number, y: number, s: number, t: number, body = C.yellow, alpha = 1) => {
      // seen from above, swimming up the screen: body, wing, head, beak (the site's duck colours)
      const wob = Math.sin(t * 6 + x) * 0.06;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.translate(x, y);
      ctx.rotate(wob);
      ctx.scale(s, s);
      ctx.fillStyle = 'rgba(16,36,26,0.18)';
      ctx.beginPath();
      ctx.ellipse(2, 4, 14, 18, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.ellipse(0, 4, 13, 17, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = C.yellowDark;
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.arc(0, 8, 8, Math.PI * 1.1, Math.PI * 1.9);
      ctx.stroke();
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.arc(0, -12, 8.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.orange;
      ctx.beginPath();
      ctx.moveTo(-4, -18);
      ctx.lineTo(0, -26);
      ctx.lineTo(4, -18);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = C.ink;
      ctx.beginPath();
      ctx.arc(-3.5, -14, 1.6, 0, Math.PI * 2);
      ctx.arc(3.5, -14, 1.6, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
    };

    const drawRacer = (r: Racer, t: number) => {
      drawDuck(r.x, r.y, 0.75, t + r.num);
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(r.x, r.y + 4, 7.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.ink;
      ctx.font = 'bold 8px Inter, system-ui, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(String(r.num), r.x, r.y + 4.5);
    };

    const drawGold = (g: Gold, t: number) => {
      const pulse = 1 + Math.sin(t * 8) * 0.08;
      ctx.save();
      ctx.globalAlpha = 0.5 + Math.sin(t * 6) * 0.2;
      ctx.fillStyle = '#fff4b0';
      ctx.beginPath();
      ctx.arc(g.x, g.y, 20 * pulse, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      drawDuck(g.x, g.y, 0.7, t + g.phase, C.gold);
      // sparkles
      ctx.fillStyle = '#ffffff';
      for (let i = 0; i < 3; i++) {
        const a = t * 3 + i * 2.1;
        ctx.beginPath();
        ctx.arc(g.x + Math.cos(a) * 18, g.y + Math.sin(a) * 18, 1.8, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const drawWhirl = (w: Whirl, t: number) => {
      ctx.save();
      ctx.translate(w.x, w.y);
      ctx.fillStyle = 'rgba(40,80,120,0.25)';
      ctx.beginPath();
      ctx.arc(0, 0, w.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.7)';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      for (let k = 0; k < 3; k++) {
        ctx.beginPath();
        for (let a = 0; a < Math.PI * 2.2; a += 0.15) {
          const rr = (w.r - 4) * (1 - a / (Math.PI * 2.6));
          const ang = a + t * 4 + (k * Math.PI * 2) / 3;
          const px = Math.cos(ang) * rr;
          const py = Math.sin(ang) * rr;
          a === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
      ctx.restore();
    };

    const drawBranch = (b: Branch) => {
      const x0 = b.fromLeft ? 0 : RIGHT - b.len;
      const len = b.fromLeft ? LEFT + b.len : b.len + WALL;
      ctx.save();
      ctx.translate(x0, b.y);
      ctx.fillStyle = 'rgba(16,36,26,0.2)';
      ctx.fillRect(0, b.thick / 2 - 2, len, 6);
      ctx.fillStyle = C.bark;
      ctx.beginPath();
      ctx.roundRect(0, -b.thick / 2, len, b.thick, b.thick / 2);
      ctx.fill();
      if (season === 'winter') {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(4, -b.thick / 2 - 2, len - 8, 5, 3);
        ctx.fill();
      }
      ctx.strokeStyle = C.barkDark;
      ctx.lineWidth = 2;
      for (let i = 14; i < len - 8; i += 26) {
        ctx.beginPath();
        ctx.moveTo(i, -b.thick / 4 + 2);
        ctx.lineTo(i + 10, -b.thick / 4 + 2);
        ctx.stroke();
      }
      const tip = b.fromLeft ? len : 0;
      const leafColour = season === 'autumn' ? '#c9702a' : season === 'winter' ? '#e8eef2' : season === 'spring' ? '#7fb25a' : C.leaf;
      ctx.fillStyle = leafColour;
      for (const [dx, dy, r] of [
        [0, -10, 9],
        [b.fromLeft ? -12 : 12, 9, 8],
        [b.fromLeft ? -26 : 26, -8, 7],
      ]) {
        ctx.beginPath();
        ctx.arc(tip + dx, dy, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    const drawRock = (r: Rock) => {
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.beginPath();
      ctx.ellipse(r.x, r.y - r.r * 0.9, r.r * 0.9, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.rockDark;
      ctx.beginPath();
      ctx.ellipse(r.x + 2, r.y + 3, r.r, r.r * 0.85, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.rock;
      ctx.beginPath();
      ctx.ellipse(r.x, r.y, r.r, r.r * 0.82, 0, 0, Math.PI * 2);
      ctx.fill();
      if (season === 'winter') {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(r.x - 2, r.y - r.r * 0.35, r.r * 0.7, r.r * 0.38, 0, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const drawBit = (b: Bit) => {
      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.rotate(b.rot);
      ctx.fillStyle = b.tint;
      if (season === 'winter') {
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.arc(0, 0, b.size, 0, Math.PI * 2);
        ctx.fill();
      } else if (season === 'summer') {
        // lily pad with a notch
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, b.size, 0.4, Math.PI * 2 - 0.1);
        ctx.closePath();
        ctx.fill();
      } else {
        // a leaf or petal
        ctx.beginPath();
        ctx.ellipse(0, 0, b.size * 1.6, b.size, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    const draw = (t: number) => {
      ctx.fillStyle = SEASON.water;
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = SEASON.deep;
      ctx.fillRect(LEFT + 40, 0, RIGHT - LEFT - 80, H);
      ctx.fillStyle = SEASON.water;
      ctx.globalAlpha = 0.6;
      ctx.fillRect(LEFT + 60, 0, RIGHT - LEFT - 120, H);
      ctx.globalAlpha = 1;
      ctx.strokeStyle = C.ripple;
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      for (const r of ripples) {
        ctx.beginPath();
        ctx.moveTo(r.x, r.y);
        ctx.lineTo(r.x, r.y + r.len);
        ctx.stroke();
      }
      // things floating on the water (leaves, petals, lily pads) go under everything else
      if (season !== 'winter') bits.forEach(drawBit);
      // stone walls with grass (or snow) on top
      for (const side of [0, 1]) {
        const x = side === 0 ? 0 : RIGHT;
        ctx.fillStyle = C.wallDark;
        ctx.fillRect(x, 0, WALL, H);
        ctx.fillStyle = SEASON.grass;
        ctx.fillRect(side === 0 ? 0 : W - 8, 0, 8, H);
      }
      for (const st of stones) {
        const y = ((st.y + wallOffset) % (H + 80)) - 40;
        const x = st.side === 0 ? 9 : RIGHT + 1;
        const w = Math.min(st.w, WALL - 10);
        ctx.fillStyle = C.wall;
        ctx.beginPath();
        ctx.roundRect(x, y, w, st.h, 4);
        ctx.fill();
        if (season === 'winter') {
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.roundRect(x, y, w, 5, 3);
          ctx.fill();
        }
      }
      for (const th of things) {
        if (th.kind === 'whirl') drawWhirl(th, t);
      }
      for (const th of things) {
        if (th.kind === 'branch') drawBranch(th);
        else if (th.kind === 'rock') drawRock(th);
        else if (th.kind === 'chick') drawDuck(th.x + Math.sin(t * 2 + th.phase) * 3, th.y, 0.55, t + th.phase);
        else if (th.kind === 'race') drawRacer(th, t);
        else if (th.kind === 'gold') drawGold(th, t);
      }
      for (const l of leavers) drawDuck(l.x, l.y, 0.55, t, C.yellow, Math.max(0, l.life / 1.2));
      for (let i = trail.length - 1; i >= 0; i--) drawDuck(trail[i].x, trail[i].y, 0.55, t + i);
      // our duck blinks while it's protected after a bump, and glows when golden
      const blink = safeTime > 0 && Math.floor(t * 10) % 2 === 0;
      if (goldTime > 0) {
        ctx.save();
        ctx.globalAlpha = 0.35;
        ctx.fillStyle = '#fff4b0';
        ctx.beginPath();
        ctx.arc(duckX, duckY, 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      drawDuck(duckX, duckY, 1, t, goldTime > 0 ? C.gold : C.yellow, blink ? 0.35 : 1);
      if (season === 'winter') bits.forEach(drawBit); // snow falls over everything
      // progress through the year: four segments, one per season
      const segW = (W - 24) / 4;
      for (let i = 0; i < 4; i++) {
        const x = 12 + i * segW;
        ctx.fillStyle = 'rgba(16,36,26,0.45)';
        ctx.fillRect(x + 1, H - 12, segW - 2, 6);
        const done = i < level ? 1 : i === level ? Math.min(1, levelTime / LEVEL_TIME) : 0;
        ctx.fillStyle = LOOKS[yearOrder[i]].bar;
        ctx.fillRect(x + 1, H - 12, (segW - 2) * done, 6);
      }
      // "Spring · Season 2 of 4" as each season begins
      if (banner && banner.t > 0 && state === 'playing') {
        ctx.save();
        ctx.globalAlpha = Math.min(1, banner.t / 0.5);
        ctx.fillStyle = 'rgba(16,36,26,0.78)';
        ctx.beginPath();
        ctx.roundRect(W / 2 - 110, H / 2 - 50, 220, 90, 18);
        ctx.fill();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#f6c343';
        ctx.font = '800 34px "Bricolage Grotesque", Inter, sans-serif';
        ctx.fillText(banner.text, W / 2, H / 2 - 14);
        ctx.fillStyle = '#dfe9e2';
        ctx.font = '600 14px Inter, system-ui, sans-serif';
        ctx.fillText(banner.sub, W / 2, H / 2 + 20);
        ctx.restore();
      }
    };

    // ---------- Game loop ----------
    const step = (now: number) => {
      const dt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      const t = now / 1000;
      if (state === 'playing') {
        speed = Math.min(150 + level * 55 + 60, speed + dt * 2.5); // faster each season, creeping up within it
        levelTime += dt;
        if (banner) banner.t -= dt;
        if (levelTime >= LEVEL_TIME) nextSeason();
        const dy = speed * dt;
        distance += dy;
        points += (dy / 20) * mult();
        wallOffset = (wallOffset + dy) % (H + 80);
        goldTime = Math.max(0, goldTime - dt);
        safeTime = Math.max(0, safeTime - dt);

        // steering: keys/buttons push, a drag sets a target
        if (steer) targetX = duckX + steer * 40;
        if (steerY) targetY = duckY + steerY * 40;
        targetX = Math.max(LEFT + DUCK_R + 2, Math.min(RIGHT - DUCK_R - 2, targetX));
        targetY = Math.max(TOP_Y, Math.min(BOTTOM_Y, targetY));
        // a knock from a race duck pushes the duck (and where it's heading) and fades quickly
        if (kickX || kickY) {
          duckX += kickX * dt;
          duckY += kickY * dt;
          targetX += kickX * dt;
          targetY += kickY * dt;
          const fade = Math.pow(0.02, dt);
          kickX = Math.abs(kickX * fade) < 2 ? 0 : kickX * fade;
          kickY = Math.abs(kickY * fade) < 2 ? 0 : kickY * fade;
          targetX = Math.max(LEFT + DUCK_R + 2, Math.min(RIGHT - DUCK_R - 2, targetX));
          targetY = Math.max(TOP_Y, Math.min(BOTTOM_Y, targetY));
        }
        duckX += (targetX - duckX) * Math.min(1, dt * 10);
        duckY += (targetY - duckY) * Math.min(1, dt * 10);
        duckX = Math.max(LEFT + DUCK_R + 2, Math.min(RIGHT - DUCK_R - 2, duckX)); // never into the walls
        duckY = Math.max(TOP_Y, Math.min(BOTTOM_Y, duckY));

        for (const r of ripples) {
          r.y += dy * 1.1;
          if (r.y > H) {
            r.y = -r.len;
            r.x = LEFT + Math.random() * (RIGHT - LEFT);
          }
        }
        for (let i = 0; i < bits.length; i++) {
          const b = bits[i];
          b.y += season === 'winter' ? b.vy * dt : dy;
          b.x += b.vx * dt;
          b.rot += dt * (season === 'winter' ? 0 : 0.6);
          if (b.y > H + 12) bits[i] = makeBit(false);
        }

        nextSpawn -= dy;
        if (nextSpawn <= 0) spawn();
        for (const th of things) th.y += th.kind === 'race' ? dy * 0.55 : dy; // race ducks drift a little slower than the current

        for (const th of things) {
          if (th.kind === 'chick' && near(th.x, th.y, 8)) {
            th.y = H + 999;
            rescued++;
            points += 10 * mult();
            if (trail.length < MAX_LINE) trail.push({ x: duckX, y: duckY + 30 });
            sfx.quack();
            announce.textContent = `Duckling rescued. ${trail.length} in your line.`;
          } else if (th.kind === 'gold' && near(th.x, th.y, 12)) {
            th.y = H + 999;
            goldTime = 10;
            sfx.gold();
            announce.textContent = 'Golden duck! Double points for 10 seconds.';
          } else if (th.kind === 'race') {
            // Bump a race duck and you both bounce apart (no harm, but it can push you somewhere awkward)
            th.cool = Math.max(0, th.cool - dt);
            if (th.cool <= 0 && near(th.x, th.y, 11)) {
              const dx = duckX - th.x;
              const dyy = duckY - th.y;
              const len = Math.hypot(dx, dyy) || 1;
              kickX = (dx / len) * 260;
              kickY = (dyy / len) * 180;
              th.x -= (dx / len) * 16;
              th.cool = 0.5;
              sfx.boing();
            }
            th.x = Math.max(LEFT + 14, Math.min(RIGHT - 14, th.x));
          } else if (th.kind === 'whirl') {
            const d = Math.sqrt(dist2(duckX, duckY, th.x, th.y));
            if (d < th.r + 24) {
              // pulled towards the middle
              const pull = (1 - d / (th.r + 24)) * dt * 3;
              duckX += (th.x - duckX) * pull;
              duckY += (th.y - duckY) * pull;
              targetX += (th.x - targetX) * pull;
              targetY += (th.y - targetY) * pull;
            }
            if (d < 12 && !th.spun) {
              th.spun = true;
              if (loseDuckling()) {
                sfx.bump();
                announce.textContent = `The whirlpool spun a duckling away. ${trail.length} left.`;
              }
            }
          } else if ((th.kind === 'branch' && hitsBranch(th)) || (th.kind === 'rock' && near(th.x, th.y, th.r - 3))) {
            bump();
            if (state !== 'playing') break;
          }
        }
        things = things.filter((th) => th.y < H + 60);

        // ducklings leaving the line swim off (or are carried away) and fade
        for (const l of leavers) {
          l.x += l.vx * dt;
          l.y += l.vy * dt + dy;
          l.life -= dt;
        }
        leavers = leavers.filter((l) => l.life > 0);

        // the ducklings follow in a line, each chasing the one in front
        let lx = duckX;
        let ly = duckY;
        for (const c of trail) {
          c.x += (lx - c.x) * Math.min(1, dt * 7);
          c.y += (ly + 24 - c.y) * Math.min(1, dt * 7);
          lx = c.x;
          ly = c.y;
        }
        updateHud();
      }
      draw(t);
      requestAnimationFrame(step);
    };

    const show = (title: string, text: string, button: string) => {
      overlayTitle.textContent = title;
      overlayText.textContent = text;
      startBtn.textContent = button;
      overlay.hidden = false;
      startBtn.focus({ preventScroll: true });
    };
    const start = () => {
      if (state === 'over' || state === 'ready') reset();
      if (soundOn) ensureAudio();
      state = 'playing';
      overlay.hidden = true;
      pauseBtn.textContent = 'Pause';
      canvas.focus({ preventScroll: true });
    };
    const pause = () => {
      if (state !== 'playing') return;
      state = 'paused';
      pauseBtn.textContent = 'Resume';
      show('Paused', 'Take a breather.', 'Keep swimming');
    };
    // Into the next season (or, after the fourth, the end of the year)
    function nextSeason() {
      level++;
      levelTime = 0;
      if (level >= 4) return finishYear();
      season = yearOrder[level];
      SEASON = LOOKS[season];
      speed = Math.max(speed, 150 + level * 55);
      bits = Array.from({ length: season === 'winter' ? 40 : season === 'summer' ? 5 : 14 }, () => makeBit(true));
      banner = { text: SEASON.name, sub: `Season ${level + 1} of 4`, t: 2.2 };
      sfx.gold();
      announce.textContent = `${SEASON.name}. Season ${level + 1} of 4.`;
    }
    function finishYear() {
      state = 'over';
      const bonus = trail.length * 25;
      points += bonus;
      const s = score();
      const isBest = s > best;
      if (isBest) {
        best = s;
        bestEl.textContent = String(best);
        try {
          localStorage.setItem('duckDashBest', String(best));
        } catch {}
      }
      sfx.gold();
      updateHud();
      const msg = `You swam the whole year and scored ${s}${bonus ? `, including ${bonus} for the ${trail.length} duckling${trail.length === 1 ? '' : 's'} still with you` : ''}.${isBest ? ' A new best!' : ''}`;
      announce.textContent = `You made it through the year! ${msg}`;
      show('You made it!', msg, 'Swim another year');
    }
    function gameOver() {
      state = 'over';
      const s = score();
      const isBest = s > best;
      if (isBest) {
        best = s;
        bestEl.textContent = String(best);
        try {
          localStorage.setItem('duckDashBest', String(best));
        } catch {}
      }
      sfx.over();
      const extras = [
        rescued ? `rescued ${rescued} duckling${rescued === 1 ? '' : 's'}` : '',
      ].filter(Boolean);
      const msg = `You scored ${s}${extras.length ? ', ' + extras.join(' and ') : ''}.${isBest ? ' A new best!' : ''}`;
      announce.textContent = `Game over. ${msg}`;
      show(isBest ? 'New best!' : 'Game over', msg, 'Swim again');
    }

    // ---------- Controls ----------
    startBtn.addEventListener('click', start);
    pauseBtn.addEventListener('click', () => (state === 'playing' ? pause() : state === 'paused' ? start() : undefined));
    document.querySelectorAll<HTMLButtonElement>('.ctrl[data-dir], .ctrl[data-diry]').forEach((b) => {
      const vertical = b.dataset.diry !== undefined;
      const dir = Number(vertical ? b.dataset.diry : b.dataset.dir);
      const on = (e: Event) => {
        e.preventDefault();
        if (vertical) steerY = dir;
        else steer = dir;
      };
      const off = () => (vertical ? (steerY = 0) : (steer = 0));
      b.addEventListener('pointerdown', on);
      b.addEventListener('pointerup', off);
      b.addEventListener('pointerleave', off);
      b.addEventListener('pointercancel', off);
      b.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && on(e));
      b.addEventListener('keyup', off);
    });
    document.addEventListener('keydown', (e) => {
      if (['ArrowLeft', 'a', 'A'].includes(e.key)) steer = -1;
      else if (['ArrowRight', 'd', 'D'].includes(e.key)) steer = 1;
      else if (['ArrowUp', 'w', 'W'].includes(e.key)) steerY = -1;
      else if (['ArrowDown', 's', 'S'].includes(e.key)) steerY = 1;
      else if ((e.key === ' ' || e.key === 'p' || e.key === 'P') && (state === 'playing' || state === 'paused')) {
        if (document.activeElement?.closest('.ctrl, [data-start]')) return;
        e.preventDefault();
        state === 'playing' ? pause() : start();
        return;
      } else return;
      if (state === 'playing') e.preventDefault(); // arrows steer instead of scrolling the page
    });
    document.addEventListener('keyup', (e) => {
      if (['ArrowLeft', 'a', 'A', 'ArrowRight', 'd', 'D'].includes(e.key)) steer = 0;
      if (['ArrowUp', 'w', 'W', 'ArrowDown', 's', 'S'].includes(e.key)) steerY = 0;
    });
    // Touch / mouse: the duck follows your finger
    const toBoard = (clientX: number, clientY: number) => {
      const r = canvas.getBoundingClientRect();
      return [((clientX - r.left) / r.width) * W, ((clientY - r.top) / r.height) * H];
    };
    const follow = (e: PointerEvent) => ([targetX, targetY] = toBoard(e.clientX, e.clientY - 40)); // aim just above your finger so you can see the duck
    let dragging = false;
    canvas.addEventListener('pointerdown', (e) => {
      if (state !== 'playing') return;
      dragging = true;
      follow(e);
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => dragging && follow(e));
    canvas.addEventListener('pointerup', () => (dragging = false));
    canvas.addEventListener('pointercancel', () => (dragging = false));
    document.addEventListener('visibilitychange', () => document.hidden && pause());

    // ---------- Size the canvas sharply for the screen ----------
    const fit = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const cssW = canvas.clientWidth;
      canvas.width = Math.round(cssW * ratio);
      canvas.height = Math.round(((cssW * H) / W) * ratio);
      ctx.setTransform(canvas.width / W, 0, 0, canvas.height / H, 0, 0);
    };
    fit();
    window.addEventListener('resize', fit);
    reset();
    requestAnimationFrame((now) => {
      last = now;
      step(now);
    });
  }
</script>

<style>
  .game-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
  }
  .game {
    position: relative;
    width: min(100%, 420px, calc((100svh - 220px) * 360 / 560));
    min-width: 260px;
    border-radius: var(--radius-card);
    overflow: hidden;
    box-shadow: 0 16px 40px rgba(16, 36, 26, 0.25);
    background: #8fb7d6;
    touch-action: none; /* dragging steers the duck instead of scrolling the page */
    user-select: none;
  }
  .game__canvas {
    display: block;
    width: 100%;
    aspect-ratio: 360 / 560;
  }
  .game__canvas:focus-visible {
    outline-offset: -4px;
  }
  .game__hud {
    position: absolute;
    top: 10px;
    left: 10px;
    right: 10px;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 6px;
    pointer-events: none;
  }
  .hud__pill {
    background: rgba(16, 36, 26, 0.82);
    color: var(--white);
    font-size: 13px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .hud__pill strong {
    color: var(--yellow);
  }
  .game__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
    background: rgba(16, 36, 26, 0.72);
    color: var(--white);
  }
  .overlay__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 36px;
    line-height: 1;
    color: var(--yellow);
  }
  .overlay__text {
    font-size: 17px;
    max-width: 26ch;
    color: var(--on-dark-soft);
  }
  .overlay__btn {
    margin-top: 6px;
  }
  .controls {
    display: flex;
