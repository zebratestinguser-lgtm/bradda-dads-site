---
import { getWording } from '../lib/wording';
const w = await getWording('game'); // Page wording form
// Duck Dash: a little game. Steer a duck down Bradwell Brook between its stone walls. Dodge branches, rocks,
// and whirlpools; rescue ducklings (they follow in a line and act as lives); numbered race ducks knock
// you about if you bump them; catch the golden duck for double points. The brook changes with the seasons. Optional quacks
// and vibration. Everything is drawn on a canvas; no libraries, no sound files (sounds are synthesised).
import BaseLayout from '../layouts/BaseLayout.astro';
import Band from '../components/Band.astro';
import PageHeader from '../components/PageHeader.astro';
import { getEntry } from 'astro:content';
import { url } from '../lib/url';
import { formatEventDates, isOpen } from '../lib/events';

// The end screens invite players to the real Boxing Day Duck Race (date and entry link from the event)
const race = await getEntry('events', 'duck-race');
const raceWhen = race ? (formatEventDates(race) ?? race.data.when) : undefined;
// Offer the entry link unless entries are known to have closed for this year
const entriesOpen = race ? race.data.status !== 'done' && (race.data.status !== 'open' || isOpen(race)) : false;
const entryUrl = race && entriesOpen && race.data.ctaUrl !== `/events/${race.id}/` ? url(race.data.ctaUrl) : undefined;
---

<BaseLayout title={w.text('title')} description={w.text('description')}>
  <PageHeader eyebrow={w.text('eyebrow')} title={w.text('title')} intro={w.text('intro')} />

  <Band first>
    <section class="container page-section game-wrap" aria-labelledby="game-title">
      <h2 class="visually-hidden" id="game-title">The game</h2>
      <p class="rotate-hint">Turn your phone upright for the best view of the brook.</p>
      <div class="game" data-game>
        <canvas class="game__canvas" data-canvas tabindex="0" role="img" aria-label="Duck Dash game. Use the arrow keys or the buttons below to steer."></canvas>
        <div class="game__hud" aria-hidden="true">
          <span class="hud__pill">Score <strong data-score>0</strong></span>
          <span class="hud__pill">Ducklings <strong data-chicks>0</strong></span>
          <span class="hud__pill">Best <strong data-best>0</strong></span>
        </div>
        <span class="hud__pill hud__gold" data-gold hidden aria-hidden="true">Golden duck ×2</span>
        <div class="game__overlay" data-overlay>
          <p class="overlay__season" data-season></p>
          <p class="overlay__title" data-overlay-title>Ready?</p>
          <p class="overlay__text" data-overlay-text>Drag, tap or use the arrow keys to steer. Space pauses.</p>
          <div class="overlay__buttons">
            <button type="button" class="btn btn--yellow overlay__btn" data-start>Start swimming</button>
            <button type="button" class="btn btn--ghost-light overlay__btn" data-finish hidden>Finish</button>
            <button type="button" class="btn btn--ghost-light overlay__btn" data-share hidden>Share score</button>
            <button type="button" class="btn btn--ghost-light overlay__btn" data-full aria-pressed="false">Full screen</button>
          </div>
          <p class="overlay__shared" data-shared aria-live="polite"></p>
          {
            race && (
              <div class="overlay__promo" data-promo hidden>
                <p class="promo__text" set:html={w.inline('promo', { when: raceWhen ? `, ${raceWhen}` : '' })} />
                <div class="promo__links">
                  {entryUrl && (
                    <a class="btn btn--yellow promo__btn" href={entryUrl}>
                      Buy an entry
                    </a>
                  )}
                  <a class="promo__more" href={url(`/events/${race.id}/`)}>
                    Duck race details →
                  </a>
                </div>
              </div>
            )
          }
        </div>
        <p class="visually-hidden" aria-live="polite" data-announce></p>
      </div>
      <div class="controls">
        <button type="button" class="ctrl" data-dir="-1" aria-label="Steer left">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
        </button>
        <div class="ctrl-stack">
          <button type="button" class="ctrl ctrl--small" data-diry="-1" aria-label="Swim up">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 15l-6-6-6 6" /></svg>
          </button>
          <button type="button" class="ctrl ctrl--small" data-diry="1" aria-label="Swim down">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
          </button>
        </div>
        <button type="button" class="ctrl" data-dir="1" aria-label="Steer right">
          <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
        </button>
      </div>
      <div class="controls-row">
        <button type="button" class="ctrl ctrl--pause" data-pause>Pause</button>
        <button type="button" class="ctrl ctrl--pause" data-sound aria-pressed="false">Sound &amp; buzz: off</button>
        <button type="button" class="ctrl ctrl--pause" data-full-exit hidden>Exit full screen</button>
      </div>
    </section>
  </Band>

</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-game]');
  const canvas = document.querySelector<HTMLCanvasElement>('[data-canvas]');
  if (root && canvas) {
    const ctx = canvas.getContext('2d')!;
    const gameWrap = root.closest<HTMLElement>('.game-wrap')!; // gets .is-playing while a game runs (stops the page scrolling under your finger)
    const $ = <T extends HTMLElement>(sel: string) => document.querySelector<T>(sel)!;
    const scoreEl = $('[data-score]');
    const chicksEl = $('[data-chicks]');
    const bestEl = $('[data-best]');
    const goldEl = $('[data-gold]');
    const overlay = $('[data-overlay]');
    const overlayTitle = $('[data-overlay-title]');
    const overlayText = $('[data-overlay-text]');
    const seasonEl = $('[data-season]');
    const startBtn = $<HTMLButtonElement>('[data-start]');
    const finishBtn = $<HTMLButtonElement>('[data-finish]');
    const shareBtn = $<HTMLButtonElement>('[data-share]');
    const sharedEl = $('[data-shared]');
    let shareText = ''; // what the Share button posts, set on the end screens
    const pauseBtn = $<HTMLButtonElement>('[data-pause]');
    const soundBtn = $<HTMLButtonElement>('[data-sound]');
    const announce = $('[data-announce]');

    // The game is worked out on a fixed 360 × 560 "board", then scaled to fit the screen
    const W = 360;
    const H = 560;
    const WALL = 30; // stone walls each side of the brook
    const LEFT = WALL;
    const RIGHT = W - WALL;
    const TOP_Y = 170; // how far up the brook the duck can swim…
    const BOTTOM_Y = H - 40; // …and how far back
    const DUCK_R = 14;
    const MAX_LINE = 8; // longest line of ducklings that fits on screen
    const LEVEL_TIME = 30; // seconds per season
    const CHICK_GAP = 700; // at least this far between ducklings (about four seconds at the start)
    const CLEAN_BONUS = 20; // for getting through a season without a bump
    // ?test in the address: no game over with an empty line, so automated checks can play long enough
    const params = new URLSearchParams(location.search);
    const TEST = params.has('test');

    // ---------- Seasons: four levels, starting in today's season ----------
    type Season = 'winter' | 'spring' | 'summer' | 'autumn';
    const ORDER: Season[] = ['winter', 'spring', 'summer', 'autumn'];
    const month = new Date().getMonth();
    const fromDate: Season = month === 11 || month <= 1 ? 'winter' : month <= 4 ? 'spring' : month <= 7 ? 'summer' : 'autumn';
    const asked = params.get('season') as Season | null; // ?season=winter previews a season
    const startSeason: Season = asked && ORDER.includes(asked) ? asked : fromDate;
    const yearOrder = Array.from({ length: 4 }, (_, i) => ORDER[(ORDER.indexOf(startSeason) + i) % 4]);
    const LOOKS = {
      winter: { name: 'Winter', grass: '#dfe9ee', water: '#93b9d3', deep: '#7aa6c6', bar: '#ffffff', leaf: '#e8eef2', hazard: 'ice patches make steering slippery' },
      spring: { name: 'Spring', grass: '#6f9a45', water: '#8fb7d6', deep: '#6f9fc4', bar: '#f3a6c2', leaf: '#7fb25a', hazard: 'blossom clumps slow you down' },
      summer: { name: 'Summer', grass: '#5b8a34', water: '#88b8d8', deep: '#679ec7', bar: '#5f9c45', leaf: '#3f6b2f', hazard: 'sandy shallows drag you back' },
      autumn: { name: 'Autumn', grass: '#8a7a3a', water: '#8db2cf', deep: '#6d9bbd', bar: '#d9822b', leaf: '#c9702a', hazard: 'leaf piles can hide rocks' },
    };
    seasonEl.textContent = `Starting in ${LOOKS[startSeason].name.toLowerCase()}` + (month === 11 ? ' · Merry Christmas!' : '');
    let firstGame = true;
    try {
      firstGame = !localStorage.getItem('duckDashSeen');
    } catch {}
    if (firstGame) overlayText.textContent = "First time? The game will slow down and explain each new thing as you meet it. Drag, tap or use the arrow keys to steer. Space pauses.";

    const C = {
      ripple: 'rgba(255,255,255,0.45)',
      wall: '#9b9384',
      wallDark: '#7d7566',
      bridge: '#a39a8a',
      bridgeDark: '#857c6c',
      yellow: '#f6c343',
      yellowDark: '#d9a21e',
      gold: '#ffd84d',
      orange: '#e8702a',
      ink: '#1a1f1c',
      bark: '#6b4a2b',
      barkDark: '#4f361f',
      rock: '#8a8f8c',
      rockDark: '#6c716e',
    };

    // ---------- Sound & buzz (off until switched on; synthesised, no files) ----------
    let soundOn = false;
    try {
      soundOn = localStorage.getItem('duckDashSound') === 'on';
    } catch {}
    let audio: AudioContext | null = null;
    const ensureAudio = () => {
      if (!audio) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (AC) audio = new AC();
      }
      if (audio?.state === 'suspended') audio.resume();
      return audio;
    };
    const tone = (freq: number, dur: number, type: OscillatorType, to = freq, vol = 0.15, delay = 0) => {
      const a = soundOn && ensureAudio();
      if (!a) return;
      const t = a.currentTime + delay;
      const o = a.createOscillator();
      const g = a.createGain();
      o.type = type;
      o.frequency.setValueAtTime(freq, t);
      o.frequency.exponentialRampToValueAtTime(to, t + dur);
      g.gain.setValueAtTime(vol, t);
      g.gain.exponentialRampToValueAtTime(0.001, t + dur);
      o.connect(g).connect(a.destination);
      o.start(t);
      o.stop(t + dur + 0.02);
    };
    const splash = () => {
      const a = soundOn && ensureAudio();
      if (!a) return;
      const len = Math.floor(a.sampleRate * 0.35);
      const buf = a.createBuffer(1, len, a.sampleRate);
      const data = buf.getChannelData(0);
      for (let i = 0; i < len; i++) data[i] = (Math.random() * 2 - 1) * (1 - i / len) ** 2;
      const src = a.createBufferSource();
      const filt = a.createBiquadFilter();
      filt.type = 'lowpass';
      filt.frequency.value = 900;
      const g = a.createGain();
      g.gain.value = 0.35;
      src.buffer = buf;
      src.connect(filt).connect(g).connect(a.destination);
      src.start();
    };
    const sfx = {
      quack: () => {
        tone(620, 0.09, 'sawtooth', 380, 0.12);
        tone(560, 0.11, 'sawtooth', 340, 0.12, 0.12);
      },
      bump: () => {
        splash();
        if (soundOn) navigator.vibrate?.(120);
      },
      chime: () => [880, 1109, 1319, 1760].forEach((f, i) => tone(f, 0.18, 'triangle', f, 0.12, i * 0.07)),
      season: () => [523, 659, 784].forEach((f, i) => tone(f, 0.22, 'sine', f, 0.1, i * 0.1)),
      boing: (big: number) => tone(260 / big, 0.16, 'sine', 600 / big, 0.12),
      over: () => {
        splash();
        tone(400, 0.5, 'triangle', 120, 0.12, 0.1);
        if (soundOn) navigator.vibrate?.([120, 80, 200]);
      },
    };
    const showSound = () => {
      soundBtn.textContent = `Sound & buzz: ${soundOn ? 'on' : 'off'}`;
      soundBtn.setAttribute('aria-pressed', String(soundOn));
    };
    showSound();
    soundBtn.addEventListener('click', () => {
      soundOn = !soundOn;
      try {
        localStorage.setItem('duckDashSound', soundOn ? 'on' : 'off');
      } catch {}
      showSound();
      if (soundOn) sfx.quack();
    });

    let best = 0;
    try {
      best = Number(localStorage.getItem('duckDashBest')) || 0;
    } catch {}
    bestEl.textContent = String(best);

    // ---------- Things in the brook (each remembers the season it appeared in, for its look) ----------
    type Base = { y: number; s: Season };
    type Branch = Base & { kind: 'branch'; fromLeft: boolean; len: number; thick: number };
    type Rock = Base & { kind: 'rock'; x: number; r: number };
    type Chick = Base & { kind: 'chick'; x: number; phase: number };
    type Whirl = Base & { kind: 'whirl'; x: number; r: number; spun: boolean };
    type Gold = Base & { kind: 'gold'; x: number; phase: number };
    type Racer = Base & { kind: 'race'; x: number; vx: number; num: number; cool: number; size: number }; // size: 0.55 small … 1.5 giant
    type Ice = Base & { kind: 'ice'; x: number; w: number; h: number; edge: number[]; chunks: { dx: number; dy: number; r: number }[] }; // edge: a jagged outline, different every time
    type Blossom = Base & { kind: 'blossom'; x: number; r: number };
    type Shallow = Base & { kind: 'shallow'; fromLeft: boolean; w: number; h: number };
    type Pile = Base & { kind: 'pile'; x: number; r: number; rock: boolean; done: boolean };
    type Shield = Base & { kind: 'shield'; x: number; phase: number }; // rare red duck: 8 seconds of shield
    // The black duck: hunts your line for a while, takes the last duckling if it reaches you, then swims off
    type Black = Base & { kind: 'black'; x: number; vx: number; vy: number; life: number; leaving: boolean; carrying: boolean };
    type Thing = Branch | Rock | Chick | Whirl | Gold | Racer | Ice | Blossom | Shallow | Pile | Shield | Black;
    type Leaver = { x: number; y: number; vx: number; vy: number; life: number }; // ducklings leaving the line
    type Bit = { x: number; y: number; vx: number; vy: number; rot: number; size: number; tint: string; s: Season }; // snow, petals, lily pads, leaves

    let duckX = W / 2;
    let targetX = W / 2;
    let duckY = H - 120;
    let targetY = H - 120;
    let steer = 0;
    let steerY = 0;
    let speed = 0;
    let distance = 0;
    let points = 0;
    let rescued = 0;
    let kickX = 0; // a knock from a race duck, fading away
    let kickY = 0;
    let knock = 0; // seconds after a knock when finger-steering is ignored, so the shove can play out
    let goldTime = 0;
    let shieldTime = 0; // seconds of the red duck's shield left
    const SHIELD_TIME = 8;
    let nextBlack = 0; // distance at which the black duck next turns up
    let safeTime = 0;
    let trail: { x: number; y: number }[] = [];
    let leavers: Leaver[] = [];
    let things: Thing[] = [];
    let ripples: { x: number; y: number; len: number }[] = [];
    let bits: Bit[] = [];
    let stones: { y: number; side: number; w: number; h: number }[] = [];
    let nextSpawn = 0;
    let raceNum = 1;
    let lastChick = -9999;
    let state: 'ready' | 'playing' | 'paused' | 'over' = 'ready';
    let last = 0;
    let wallOffset = 0;

    // Seasons and years
    let season: Season = startSeason; // the season the duck is in (rules and hazards)
    let level = 0; // 0–3 within the year
    let year = 1;
    let seasonsDone = 0; // completed seasons this game: each makes the brook faster and bumps costlier
    let levelTime = 0;
    let bumpedThisSeason = false;
    // A season change flows down the brook: a footbridge appears at the top and travels down with the water;
    // above it the brook already looks like the new season. The rules change as the duck swims under it.
    let change: { y: number; from: Season; to: Season; newYear: boolean; crossed: boolean } | null = null;
    let label: { text: string; sub: string; t: number; total: number } | null = null; // the little label that slides in at the top
    let atYearEnd = false;
    // The first time a player ever meets each kind of thing, the game slows right down for a moment and a
    // label points at it. Remembered on the device, so it only happens once per kind.
    const INTRO: Partial<Record<Thing['kind'], [string, string]>> = {
      chick: ['Duckling', 'Swim into it to rescue it. Ducklings are your lives.'],
      race: ['Race duck', 'Bump one and you get knocked back. Big ones shove harder.'],
      whirl: ['Whirlpool', 'It pulls you in, and the middle spins a duckling away.'],
      gold: ['Golden duck', 'Catch it for double points for 10 seconds!'],
      shield: ['Red shield duck', 'Catch it and nothing can hurt you for 8 seconds.'],
      black: ['Black duck', 'It hunts your ducklings. Keep swimming out of its way!'],
      ice: ['Ice', 'Slippery! Steering is hard while you are on it.'],
      blossom: ['Blossom', 'It slows you down and drags you back.'],
      shallow: ['Sandbank', 'Shallow sand drags you back down the brook.'],
      pile: ['Leaf pile', 'Sometimes there is a rock hiding underneath.'],
    };
    let seen = new Set<string>();
    try {
      seen = new Set(JSON.parse(localStorage.getItem('duckDashSeen') || '[]'));
    } catch {}
    let slowmo = 0; // real seconds of slow motion left
    let callout: { th: Thing; title: string; body: string; t: number } | null = null;
    let hintGap = 0; // a short breather between one hint ending and the next starting
    let hintBox = { x: 0, y: 0, w: 0, h: 0 }; // where the hint is drawn (board units), so tapping it can dismiss it
    const HINT_TIME = 4.5;
    const anchorOf = (th: Thing) => {
      if (th.kind === 'shallow') return { x: th.fromLeft ? LEFT + th.w * 0.45 : RIGHT - th.w * 0.45, y: th.y };
      if (th.kind === 'ice') return { x: th.x + th.w / 2, y: th.y };
      if (th.kind === 'branch') return { x: th.fromLeft ? LEFT + th.len / 2 : RIGHT - th.len / 2, y: th.y };
      return { x: th.x, y: th.y };
    };

    const mult = () => (goldTime > 0 ? 2 : 1);
    const score = () => Math.floor(points);
    // The year: each season about 25% faster than the last (summer ≈ twice the start). Bonus years
    // creep up only 4% a season, up to a speed limit; their extra challenge is more hazards, a busier
    // black duck and fewer ducklings, not raw speed.
    const SPEED_LIMIT = 320;
    const baseSpeed = () => (seasonsDone < 4 ? 150 * 1.25 ** seasonsDone : Math.min(SPEED_LIMIT, 150 * 1.25 ** 3 * 1.04 ** (seasonsDone - 3)));
    const bonusYears = () => Math.max(0, year - 1); // 0 in the main year
    const busier = () => 1 + bonusYears() * 0.18; // how much busier each bonus year is
    const bumpCost = () => Math.min(4, seasonsDone + 1);
    const spawnSeason = () => (change ? change.to : season); // new things appear at the top, in the coming season

    const BIT_COUNT = { winter: 40, spring: 14, summer: 5, autumn: 14 };
    const makeBit = (anywhere: boolean, s: Season = spawnSeason()): Bit => {
      const tints = s === 'winter' ? ['#ffffff'] : s === 'autumn' ? ['#d9822b', '#c2452d', '#e0b13a', '#9c5a24'] : s === 'spring' ? ['#f7c6d9', '#ffffff', '#f3a6c2'] : ['#4f8a3a', '#5f9c45'];
      return {
        x: (s === 'winter' ? 0 : LEFT) + Math.random() * (s === 'winter' ? W : RIGHT - LEFT),
        y: anywhere ? Math.random() * H : -10,
        vx: (Math.random() - 0.5) * 12,
        vy: s === 'winter' ? 25 + Math.random() * 25 : 0,
        rot: Math.random() * 6,
        size: s === 'summer' ? 9 + Math.random() * 5 : s === 'winter' ? 1.5 + Math.random() * 2 : 3 + Math.random() * 3,
        tint: tints[Math.floor(Math.random() * tints.length)],
        s,
      };
    };

    const updateHud = () => {
      scoreEl.textContent = String(score());
      chicksEl.textContent = String(trail.length);
      const powers = [goldTime > 0 ? `Golden ×2 · ${Math.ceil(goldTime)}s` : '', shieldTime > 0 ? `Shield · ${Math.ceil(shieldTime)}s` : ''].filter(Boolean);
      goldEl.hidden = powers.length === 0;
      goldEl.textContent = powers.join('  ·  ');
      goldEl.classList.toggle('is-shield', shieldTime > 0 && goldTime <= 0);
    };

    const reset = () => {
      duckX = targetX = W / 2;
      duckY = targetY = H - 120;
      steer = steerY = 0;
      speed = 150;
      distance = points = rescued = kickX = kickY = knock = 0;
      goldTime = safeTime = shieldTime = 0;
      nextBlack = 2200 + Math.random() * 1500;
      trail = [];
      leavers = [];
      things = [];
      nextSpawn = 120;
      raceNum = 1 + Math.floor(Math.random() * 400);
      lastChick = -9999;
      season = startSeason;
      level = 0;
      year = 1;
      seasonsDone = 0;
      levelTime = 0;
      bumpedThisSeason = false;
      change = null;
      atYearEnd = false;
      callout = null;
      slowmo = 0;
      label = { text: LOOKS[season].name, sub: `Season 1 of 4 · ${LOOKS[season].hazard}`, t: 3.2, total: 3.2 };
      ripples = Array.from({ length: 26 }, () => ({ x: LEFT + Math.random() * (RIGHT - LEFT), y: Math.random() * H, len: 10 + Math.random() * 22 }));
      bits = Array.from({ length: BIT_COUNT[season] }, () => makeBit(true, season));
      stones = [];
      for (let y = -40; y < H + 40; y += 22) {
        stones.push({ y, side: 0, w: 14 + Math.random() * 10, h: 16 + Math.random() * 6 });
        stones.push({ y: y + 11, side: 1, w: 14 + Math.random() * 10, h: 16 + Math.random() * 6 });
      }
      if (TEST) {
        // test aids: ?test&lives=3 starts with ducklings, and the black duck comes sooner
        nextBlack = 500;
        const n = Math.min(MAX_LINE, Number(params.get('lives')) || 0);
        for (let i = 0; i < n; i++) trail.push({ x: W / 2, y: H - 90 + i * 24 });
      }
      updateHud();
    };

    // ---------- New things, always leaving a way through ----------
    const randX = (margin: number) => LEFT + margin + Math.random() * (RIGHT - LEFT - 2 * margin);
    const chickOk = () => distance - lastChick > CHICK_GAP * (speed / 150) * busier(); // the same time apart at any speed; rarer in bonus years
    const addChick = (x: number, y: number) => {
      things.push({ kind: 'chick', y, x, phase: Math.random() * 6, s: spawnSeason() });
      lastChick = distance;
    };
    const spawnHazard = (s: Season) => {
      if (s === 'winter') {
        const w = 70 + Math.random() * 60;
        const edge = Array.from({ length: 11 }, () => 0.72 + Math.random() * 0.3);
        const chunks = Array.from({ length: 2 + Math.floor(Math.random() * 3) }, () => ({ dx: (Math.random() - 0.5) * 1.6, dy: (Math.random() - 0.5) * 1.8, r: 4 + Math.random() * 5 }));
        things.push({ kind: 'ice', y: -40, x: LEFT + 10 + Math.random() * (RIGHT - LEFT - w - 20), w, h: 50 + Math.random() * 30, edge, chunks, s });
      } else if (s === 'spring') {
        things.push({ kind: 'blossom', y: -40, x: randX(34), r: 24 + Math.random() * 8, s });
      } else if (s === 'summer') {
        things.push({ kind: 'shallow', y: -60, fromLeft: Math.random() < 0.5, w: 55 + Math.random() * 35, h: 90 + Math.random() * 60, s });
      } else {
        things.push({ kind: 'pile', y: -40, x: randX(30), r: 22 + Math.random() * 6, rock: Math.random() < 0.4, done: false, s });
      }
    };
    // The space a thing takes up, as a box, for keeping new things apart
    const box = (th: Thing) => {
      switch (th.kind) {
        case 'branch':
          return th.fromLeft ? { x0: LEFT, x1: LEFT + th.len, y0: th.y - 18, y1: th.y + 18 } : { x0: RIGHT - th.len, x1: RIGHT, y0: th.y - 18, y1: th.y + 18 };
        case 'shallow':
          return th.fromLeft ? { x0: LEFT, x1: LEFT + th.w, y0: th.y - th.h / 2, y1: th.y + th.h / 2 } : { x0: RIGHT - th.w, x1: RIGHT, y0: th.y - th.h / 2, y1: th.y + th.h / 2 };
        case 'ice':
          return { x0: th.x, x1: th.x + th.w, y0: th.y - th.h / 2, y1: th.y + th.h / 2 };
        default: {
          const r = th.kind === 'chick' ? 12 : th.kind === 'gold' || th.kind === 'shield' || th.kind === 'black' ? 16 : th.kind === 'race' ? 13 * th.size : th.r;
          return { x0: th.x - r, x1: th.x + r, y0: th.y - r, y1: th.y + r };
        }
      }
    };
    const clashes = (a: Thing, others: Thing[]) => {
      const A = box(a);
      return others.some((o) => {
        if (o === a) return false;
        const B = box(o);
        return A.x0 < B.x1 + 12 && B.x0 < A.x1 + 12 && A.y0 < B.y1 + 12 && B.y0 < A.y1 + 12;
      });
    };
    // After spawning: nudge anything that landed on something else; drop ducklings and golden ducks that won't fit
    const settle = (fresh: Thing[]) => {
      for (const th of fresh) {
        if (!clashes(th, things)) continue;
        if ('x' in th && th.kind !== 'ice') {
          const r = th.kind === 'chick' ? 12 : th.kind === 'gold' || th.kind === 'shield' || th.kind === 'black' ? 16 : th.kind === 'race' ? 13 * th.size : th.r;
          for (let tries = 0; tries < 8 && clashes(th, things); tries++) th.x = randX(r + 6);
        }
        if (clashes(th, things) && (th.kind === 'chick' || th.kind === 'gold' || th.kind === 'shield' || th.kind === 'race' || th.kind === 'rock')) {
          things = things.filter((x) => x !== th);
          if (th.kind === 'chick') lastChick = -9999; // let the next one come sooner instead
        }
      }
    };
    const spawn = () => {
      const before = things.length;
      const s = spawnSeason();
      const roll = Math.random();
      const gapNeeded = 92; // the duck always has at least this much room to get past
      if (roll < 0.34) {
        const fromLeft = Math.random() < 0.5;
        const len = 90 + Math.random() * (RIGHT - LEFT - gapNeeded - 90);
        things.push({ kind: 'branch', y: -30, fromLeft, len, thick: 16 + Math.random() * 6, s });
        if (Math.random() < 0.3 && chickOk()) {
          const freeFrom = fromLeft ? LEFT + len + 24 : LEFT + 24;
          const freeTo = fromLeft ? RIGHT - 24 : RIGHT - len - 24;
          if (freeTo > freeFrom) addChick(freeFrom + Math.random() * (freeTo - freeFrom), -30);
        }
      } else if (roll < 0.54) {
        const r = 14 + Math.random() * 12;
        things.push({ kind: 'rock', y: -30, x: randX(r + 6), r, s });
        if (Math.random() < 0.2 && chickOk()) addChick(randX(30), -90);
      } else if (roll < 0.66 && distance > 300) {
        spawnHazard(s);
      } else if (roll < 0.74 && distance > 600) {
        things.push({ kind: 'whirl', y: -40, x: randX(44), r: 30, spun: false, s });
      } else if (roll < 0.86) {
        // race ducks come in sizes; now and then a giant one
        const pick = Math.random();
        const size = pick < 0.04 ? 1.5 : pick < 0.38 ? 0.55 : pick < 0.72 ? 0.75 : 0.95;
        things.push({ kind: 'race', y: -40, x: randX(22 * size + 8), vx: 0, num: raceNum++, cool: 0, size, s });
      } else if (roll < 0.905 && roll >= 0.89 && distance > 800 && shieldTime <= 0) {
        things.push({ kind: 'shield', y: -30, x: randX(30), phase: Math.random() * 6, s });
      } else if (roll < 0.89 && distance > 400) {
        things.push({ kind: 'gold', y: -30, x: randX(30), phase: Math.random() * 6, s });
      } else if (chickOk()) {
        addChick(randX(30), -30);
      } else {
        const r = 14 + Math.random() * 10;
        things.push({ kind: 'rock', y: -30, x: randX(r + 6), r, s });
      }
      settle(things.slice(before));
      nextSpawn = (Math.max(105, 185 - (speed - 150) * 0.35) + Math.random() * 60) / busier(); // gaps shrink as the brook speeds up, and in bonus years
    };

    // ---------- Collisions and rules ----------
    const hitsBranch = (b: Branch) => {
      const x0 = b.fromLeft ? LEFT - 10 : RIGHT - b.len;
      const x1 = b.fromLeft ? LEFT + b.len : RIGHT + 10;
      const cx = Math.max(x0, Math.min(duckX, x1));
      const cy = Math.max(b.y - b.thick / 2, Math.min(duckY, b.y + b.thick / 2));
      return (duckX - cx) ** 2 + (duckY - cy) ** 2 < (DUCK_R - 2) ** 2;
    };
    const dist2 = (ax: number, ay: number, bx: number, by: number) => (ax - bx) ** 2 + (ay - by) ** 2;
    const near = (x: number, y: number, r: number) => dist2(duckX, duckY, x, y) < (DUCK_R + r) ** 2;

    const loseDuckling = () => {
      const c = trail.pop();
      if (!c) return false;
      leavers.push({ x: c.x, y: c.y, vx: c.x > W / 2 ? -150 : 150, vy: -40, life: 1.2 });
      return true;
    };
    const bump = () => {
      if (shieldTime > 0) return sfx.boing(0.6); // the shield takes it
      if (safeTime > 0 || (TEST && trail.length === 0)) return;
      if (!trail.length) return gameOver();
      let lost = 0;
      while (lost < bumpCost() && loseDuckling()) lost++;
      safeTime = 1.4;
      bumpedThisSeason = true;
      sfx.bump();
      announce.textContent = `Bump! ${lost} duckling${lost === 1 ? '' : 's'} swam off. ${trail.length} left in your line.`;
    };

    // ---------- Drawing ----------
    // Seasonal hats, matched to the Bradda Dads year: Christmas hats in winter (card, lunch, Boxing Day),
    // fell runners' headbands in spring (Wolf's Pit), carnival party hats in summer, and witch and wizard
    // hats in autumn (bonfire night). v picks a colour so each duck looks a bit different.
    type Hat = { s: Season; v: number };
    const pickOf = <T,>(list: T[], v: number) => list[Math.abs(Math.floor(v)) % list.length];
    const drawHat = (hat: Hat) => {
      if (hat.s === 'winter') {
        ctx.fillStyle = '#d63a2f';
        ctx.beginPath();
        ctx.moveTo(-7.5, -9);
        ctx.lineTo(7.5, -9);
        ctx.quadraticCurveTo(6, 2, 4, 11); // flops back over the duck's back
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(-9, -11, 18, 5, 2.5); // furry trim
        ctx.fill();
        ctx.beginPath();
        ctx.arc(4, 12, 3.2, 0, Math.PI * 2); // pom-pom
        ctx.fill();
      } else if (hat.s === 'autumn') {
        const colour = pickOf(['#6b3fa0', '#22252a', '#2f7d4a', '#23407a'], hat.v);
        ctx.fillStyle = colour;
        ctx.beginPath();
        ctx.ellipse(0, -8, 12, 6.5, 0, 0, Math.PI * 2); // brim
        ctx.fill();
        ctx.beginPath();
        ctx.moveTo(-6.5, -9);
        ctx.lineTo(6.5, -9);
        ctx.lineTo(3, 15); // tall pointy crown, tipping back
        ctx.closePath();
        ctx.fill();
        ctx.fillStyle = '#e0b13a';
        ctx.fillRect(-6.2, -8.5, 12.4, 2.6); // band
        if (Math.floor(hat.v) % 2 === 0) {
          ctx.beginPath(); // a little star
          ctx.arc(2, 4, 1.8, 0, Math.PI * 2);
          ctx.fill();
        }
      } else if (hat.s === 'spring') {
        const colour = pickOf(['#e8473a', '#2f9ad6', '#3fb36b', '#f39c12', '#8e44ad'], hat.v);
        ctx.strokeStyle = colour;
        ctx.lineWidth = 3.2;
        ctx.lineCap = 'round';
        ctx.beginPath(); // headband across the head…
        ctx.moveTo(-8.2, -15.5);
        ctx.quadraticCurveTo(0, -19, 8.2, -15.5);
        ctx.stroke();
        ctx.lineWidth = 2.4;
        ctx.beginPath(); // …with its tails flying out behind, like a fell runner's
        ctx.moveTo(7.5, -14);
        ctx.quadraticCurveTo(12, -9, 11, -2);
        ctx.moveTo(7, -13);
        ctx.quadraticCurveTo(9, -6, 13, -5);
        ctx.stroke();
      } else {
        const [a, b] = pickOf(
          [
            ['#e8473a', '#f6c343'],
            ['#2f9ad6', '#ffffff'],
            ['#3fb36b', '#f39c12'],
            ['#8e44ad', '#f7c6d9'],
          ],
          hat.v,
        );
        ctx.save();
        ctx.beginPath(); // a carnival party hat, tipped back, with stripes
        ctx.moveTo(-6, -11);
        ctx.lineTo(6, -11);
        ctx.lineTo(1, 5);
        ctx.closePath();
        ctx.fillStyle = a;
        ctx.fill();
        ctx.clip();
        ctx.strokeStyle = b;
        ctx.lineWidth = 2.4;
        for (let k = -8; k < 6; k += 5) {
          ctx.beginPath();
          ctx.moveTo(-8, k);
          ctx.lineTo(8, k - 4);
          ctx.stroke();
        }
        ctx.restore();
        ctx.fillStyle = b;
        ctx.beginPath();
        ctx.arc(1, 6, 2.8, 0, Math.PI * 2); // pom-pom
        ctx.fill();
      }
    };
    const drawDuck = (x: number, y: number, sc: number, t: number, body = C.yellow, alpha = 1, hat?: Hat) => {
      const wob = Math.sin(t * 6 + x) * 0.06;
      ctx.save();
      ctx.globalAlpha = alpha;
      ctx.translate(x, y);
      ctx.rotate(wob);
      ctx.scale(sc, sc);
      ctx.fillStyle = 'rgba(16,36,26,0.18)';
      ctx.beginPath();
      ctx.ellipse(2, 4, 14, 18, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.ellipse(0, 4, 13, 17, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = C.yellowDark;
      ctx.lineWidth = 2.5;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.arc(0, 8, 8, Math.PI * 1.1, Math.PI * 1.9);
      ctx.stroke();
      ctx.fillStyle = body;
      ctx.beginPath();
      ctx.arc(0, -12, 8.5, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.orange;
      ctx.beginPath();
      ctx.moveTo(-4, -18);
      ctx.lineTo(0, -26);
      ctx.lineTo(4, -18);
      ctx.closePath();
      ctx.fill();
      ctx.fillStyle = C.ink;
      ctx.beginPath();
      ctx.arc(-3.5, -14, 1.6, 0, Math.PI * 2);
      ctx.arc(3.5, -14, 1.6, 0, Math.PI * 2);
      ctx.fill();
      if (hat) {
        drawHat(hat);
        ctx.fillStyle = body === '#2b2f2c' ? '#ff5a4f' : C.ink; // eyes back on top (the black duck's are red)
        ctx.beginPath();
        ctx.arc(-3.5, -14, 1.6, 0, Math.PI * 2);
        ctx.arc(3.5, -14, 1.6, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    const drawRacer = (r: Racer, t: number) => {
      drawDuck(r.x, r.y, r.size, t + r.num, C.yellow, 1, { s: r.s, v: r.num });
      const rr = 10 * r.size;
      ctx.fillStyle = '#ffffff';
      ctx.beginPath();
      ctx.arc(r.x, r.y + 4 * r.size, rr, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.ink;
      ctx.font = `bold ${Math.round(11 * r.size)}px Inter, system-ui, sans-serif`;
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(String(r.num), r.x, r.y + 4.5 * r.size);
    };

    const drawGold = (g: Gold, t: number) => {
      const pulse = 1 + Math.sin(t * 8) * 0.08;
      ctx.save();
      ctx.globalAlpha = 0.5 + Math.sin(t * 6) * 0.2;
      ctx.fillStyle = '#fff4b0';
      ctx.beginPath();
      ctx.arc(g.x, g.y, 20 * pulse, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      drawDuck(g.x, g.y, 0.7, t + g.phase, C.gold, 1, { s: g.s, v: 2 });
      ctx.fillStyle = '#ffffff';
      for (let i = 0; i < 3; i++) {
        const a = t * 3 + i * 2.1;
        ctx.beginPath();
        ctx.arc(g.x + Math.cos(a) * 18, g.y + Math.sin(a) * 18, 1.8, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const drawShieldDuck = (sh: Shield, t: number) => {
      ctx.save();
      ctx.globalAlpha = 0.45 + Math.sin(t * 6) * 0.15;
      ctx.strokeStyle = '#e8473a';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.arc(sh.x, sh.y, 21, 0, Math.PI * 2);
      ctx.stroke();
      ctx.restore();
      drawDuck(sh.x, sh.y, 0.7, t + sh.phase, '#e8473a', 1, { s: sh.s, v: 3 });
    };
    const drawBlack = (b: Black, t: number) => {
      ctx.save();
      ctx.fillStyle = 'rgba(16,36,26,0.25)'; // a dark wake behind it
      ctx.beginPath();
      ctx.ellipse(b.x, b.y + 14, 10, 18, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.restore();
      drawDuck(b.x, b.y, 0.85, t * 1.6, '#2b2f2c', 1, { s: season, v: 1 });
      ctx.fillStyle = '#ff5a4f'; // glinting red eyes
      ctx.beginPath();
      ctx.arc(b.x - 3, b.y - 12, 1.6, 0, Math.PI * 2);
      ctx.arc(b.x + 3, b.y - 12, 1.6, 0, Math.PI * 2);
      ctx.fill();
      if (b.carrying) drawDuck(b.x, b.y - 26, 0.45, t, C.yellow, 1, { s: season, v: 4 }); // the duckling it's taking
    };
    const drawWhirl = (w: Whirl, t: number) => {
      ctx.save();
      ctx.translate(w.x, w.y);
      ctx.fillStyle = 'rgba(40,80,120,0.25)';
      ctx.beginPath();
      ctx.arc(0, 0, w.r, 0, Math.PI * 2);
      ctx.fill();
      ctx.strokeStyle = 'rgba(255,255,255,0.7)';
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      for (let k = 0; k < 3; k++) {
        ctx.beginPath();
        for (let a = 0; a < Math.PI * 2.2; a += 0.15) {
          const rr = (w.r - 4) * (1 - a / (Math.PI * 2.6));
          const ang = a + t * 4 + (k * Math.PI * 2) / 3;
          const px = Math.cos(ang) * rr;
          const py = Math.sin(ang) * rr;
          a === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
        }
        ctx.stroke();
      }
      ctx.restore();
    };

    const drawBranch = (b: Branch) => {
      const x0 = b.fromLeft ? 0 : RIGHT - b.len;
      const len = b.fromLeft ? LEFT + b.len : b.len + WALL;
      ctx.save();
      ctx.translate(x0, b.y);
      ctx.fillStyle = 'rgba(16,36,26,0.2)';
      ctx.fillRect(0, b.thick / 2 - 2, len, 6);
      ctx.fillStyle = C.bark;
      ctx.beginPath();
      ctx.roundRect(0, -b.thick / 2, len, b.thick, b.thick / 2);
      ctx.fill();
      if (b.s === 'winter') {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.roundRect(4, -b.thick / 2 - 2, len - 8, 5, 3);
        ctx.fill();
      }
      ctx.strokeStyle = C.barkDark;
      ctx.lineWidth = 2;
      for (let i = 14; i < len - 8; i += 26) {
        ctx.beginPath();
        ctx.moveTo(i, -b.thick / 4 + 2);
        ctx.lineTo(i + 10, -b.thick / 4 + 2);
        ctx.stroke();
      }
      const tip = b.fromLeft ? len : 0;
      ctx.fillStyle = LOOKS[b.s].leaf;
      for (const [dx, dy, r] of [
        [0, -10, 9],
        [b.fromLeft ? -12 : 12, 9, 8],
        [b.fromLeft ? -26 : 26, -8, 7],
      ]) {
        ctx.beginPath();
        ctx.arc(tip + dx, dy, r, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    const drawRock = (r: { x: number; y: number; r: number; s: Season }) => {
      ctx.fillStyle = 'rgba(255,255,255,0.35)';
      ctx.beginPath();
      ctx.ellipse(r.x, r.y - r.r * 0.9, r.r * 0.9, 4, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.rockDark;
      ctx.beginPath();
      ctx.ellipse(r.x + 2, r.y + 3, r.r, r.r * 0.85, 0, 0, Math.PI * 2);
      ctx.fill();
      ctx.fillStyle = C.rock;
      ctx.beginPath();
      ctx.ellipse(r.x, r.y, r.r, r.r * 0.82, 0, 0, Math.PI * 2);
      ctx.fill();
      if (r.s === 'winter') {
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.ellipse(r.x - 2, r.y - r.r * 0.35, r.r * 0.7, r.r * 0.38, 0, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    // Season challenges
    // An ice floe: a jagged, irregular sheet of ice with a sheen, cracks, a darker edge under the water
    // and a few loose chunks bobbing beside it
    const floePath = (i: Ice, grow: number) => {
      const cx = i.x + i.w / 2;
      const rx = i.w / 2 + grow;
      const ry = i.h / 2 + grow;
      ctx.beginPath();
      i.edge.forEach((k, n) => {
        const a = (n / i.edge.length) * Math.PI * 2;
        const px = cx + Math.cos(a) * rx * k;
        const py = i.y + Math.sin(a) * ry * k;
        n === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      });
      ctx.closePath();
    };
    const drawIce = (i: Ice, t: number) => {
      const cx = i.x + i.w / 2;
      ctx.save();
      // loose chunks
      for (const c of i.chunks) {
        const px = cx + c.dx * i.w * 0.62 + Math.sin(t * 1.5 + c.r) * 1.5;
        const py = i.y + c.dy * i.h * 0.6;
        ctx.fillStyle = 'rgba(120,160,190,0.45)';
        ctx.beginPath();
        ctx.ellipse(px + 1, py + 2, c.r, c.r * 0.7, c.r, 0, Math.PI * 2);
        ctx.fill();
        ctx.fillStyle = 'rgba(236,246,252,0.92)';
        ctx.beginPath();
        ctx.ellipse(px, py, c.r, c.r * 0.7, c.r, 0, Math.PI * 2);
        ctx.fill();
      }
      // the darker edge under the water, then the floe itself
      ctx.fillStyle = 'rgba(110,155,190,0.5)';
      floePath(i, 3);
      ctx.fill();
      const g = ctx.createLinearGradient(i.x, i.y - i.h / 2, i.x + i.w, i.y + i.h / 2);
      g.addColorStop(0, 'rgba(250,253,255,0.96)');
      g.addColorStop(0.55, 'rgba(222,238,248,0.94)');
      g.addColorStop(1, 'rgba(196,222,238,0.94)');
      ctx.fillStyle = g;
      floePath(i, 0);
      ctx.fill();
      // a soft sheen
      ctx.save();
      floePath(i, 0);
      ctx.clip();
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      ctx.beginPath();
      ctx.ellipse(cx - i.w * 0.15, i.y - i.h * 0.2, i.w * 0.28, i.h * 0.12, -0.35, 0, Math.PI * 2);
      ctx.fill();
      // cracks
      ctx.strokeStyle = 'rgba(140,180,210,0.85)';
      ctx.lineWidth = 1.3;
      ctx.lineCap = 'round';
      ctx.beginPath();
      ctx.moveTo(cx - i.w * 0.3, i.y - i.h * 0.25);
      ctx.lineTo(cx - i.w * 0.05, i.y + i.h * 0.02);
      ctx.lineTo(cx - i.w * 0.12, i.y + i.h * 0.32);
      ctx.moveTo(cx - i.w * 0.05, i.y + i.h * 0.02);
      ctx.lineTo(cx + i.w * 0.25, i.y - i.h * 0.08);
      ctx.lineTo(cx + i.w * 0.36, i.y + i.h * 0.18);
      ctx.stroke();
      ctx.restore();
      ctx.restore();
    };
    const drawBlossom = (b: Blossom, t: number) => {
      for (let k = 0; k < 14; k++) {
        const a = k * 2.4 + t * 0.3;
        const d = (k % 5) * (b.r / 5);
        ctx.fillStyle = k % 3 ? '#f7c6d9' : '#ffffff';
        ctx.beginPath();
        ctx.ellipse(b.x + Math.cos(a) * d, b.y + Math.sin(a) * d, 6, 4, a, 0, Math.PI * 2);
        ctx.fill();
      }
    };
    // A sandbank: a natural, lumpy curve of sand bulging out from the wall, widest in the middle,
    // with darker wet sand at the edge, a line of foam where it meets the water, pebbles and a tuft of reeds
    const bankWidth = (sh: Shallow, y: number) => {
      const p = (y - (sh.y - sh.h / 2)) / sh.h; // 0 at the top of the bank, 1 at the bottom
      if (p <= 0 || p >= 1) return 0;
      return sh.w * Math.sin(Math.PI * p) ** 0.8 * (1 + 0.08 * Math.sin(p * 9 + sh.w)); // lumpy, not a perfect arc
    };
    const bankPath = (sh: Shallow, grow: number) => {
      const top = sh.y - sh.h / 2;
      const wall = sh.fromLeft ? LEFT : RIGHT;
      const dir = sh.fromLeft ? 1 : -1;
      ctx.beginPath();
      ctx.moveTo(wall - dir * 4, top - grow);
      for (let i = 0; i <= 24; i++) {
        const y = top + (sh.h * i) / 24;
        const w = bankWidth(sh, Math.min(sh.y + sh.h / 2 - 0.01, Math.max(top + 0.01, y)));
        ctx.lineTo(wall + dir * (w + grow), y);
      }
      ctx.lineTo(wall - dir * 4, top + sh.h + grow);
      ctx.closePath();
    };
    const drawShallow = (sh: Shallow) => {
      ctx.save();
      // foam where the sand meets the water
      ctx.fillStyle = 'rgba(255,255,255,0.55)';
      bankPath(sh, 4);
      ctx.fill();
      // wet sand edge, then dry sand
      ctx.fillStyle = '#b89c66';
      bankPath(sh, 0);
      ctx.fill();
      const wall = sh.fromLeft ? LEFT : RIGHT;
      const dir = sh.fromLeft ? 1 : -1;
      const g = ctx.createLinearGradient(wall, 0, wall + dir * sh.w, 0);
      g.addColorStop(0, '#e6d29c');
      g.addColorStop(1, '#cdb47c');
      ctx.fillStyle = g;
      ctx.save();
      ctx.translate(0, 0);
      ctx.scale(1, 1);
      ctx.beginPath();
      const top = sh.y - sh.h / 2;
      ctx.moveTo(wall - dir * 4, top + 6);
      for (let i = 0; i <= 24; i++) {
        const y = top + 6 + ((sh.h - 12) * i) / 24;
        ctx.lineTo(wall + dir * Math.max(0, bankWidth(sh, y) - 7), y);
      }
      ctx.lineTo(wall - dir * 4, top + sh.h - 6);
      ctx.closePath();
      ctx.fill();
      ctx.restore();
      // ripple marks in the sand
      ctx.strokeStyle = 'rgba(150,120,70,0.35)';
      ctx.lineWidth = 1.5;
      ctx.lineCap = 'round';
      for (let k = 1; k <= 4; k++) {
        const y = top + (sh.h * k) / 5;
        const w = bankWidth(sh, y) - 12;
        if (w < 12) continue;
        ctx.beginPath();
        ctx.moveTo(wall + dir * 6, y);
        ctx.quadraticCurveTo(wall + dir * (w / 2), y - 5, wall + dir * w, y);
        ctx.stroke();
      }
      // pebbles
      ctx.fillStyle = '#9b927f';
      for (let k = 0; k < 5; k++) {
        const y = top + sh.h * (0.2 + 0.15 * k);
        const w = bankWidth(sh, y);
        ctx.beginPath();
        ctx.ellipse(wall + dir * (w * (0.3 + ((k * 37) % 50) / 100)), y + ((k * 13) % 9) - 4, 3, 2.2, k, 0, Math.PI * 2);
        ctx.fill();
      }
      // a tuft of reeds against the wall
      ctx.strokeStyle = '#6f8f3a';
      ctx.lineWidth = 2;
      for (let k = 0; k < 4; k++) {
        const y = sh.y + 8 - k * 4;
        ctx.beginPath();
        ctx.moveTo(wall + dir * 4, y);
        ctx.quadraticCurveTo(wall + dir * (8 + k * 3), y - 10, wall + dir * (12 + k * 4), y - 16 - k * 2);
        ctx.stroke();
      }
      ctx.restore();
    };
    const drawPile = (p: Pile) => {
      if (p.done && p.rock) return drawRock({ x: p.x, y: p.y, r: p.r * 0.8, s: p.s });
      if (p.done) return;
      if (p.rock) {
        // a grey edge peeking out: a sharp-eyed swimmer can tell this pile hides a rock
        ctx.fillStyle = C.rockDark;
        ctx.beginPath();
        ctx.ellipse(p.x + p.r * 0.55, p.y + p.r * 0.35, p.r * 0.45, p.r * 0.3, 0.3, 0, Math.PI * 2);
        ctx.fill();
      }
      const cols = ['#d9822b', '#c2452d', '#e0b13a', '#9c5a24'];
      for (let k = 0; k < 16; k++) {
        const a = k * 2.3;
        const d = (k % 4) * (p.r / 4);
        ctx.fillStyle = cols[k % 4];
        ctx.beginPath();
        ctx.ellipse(p.x + Math.cos(a) * d, p.y + Math.sin(a) * d, 7, 4.5, a, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const drawBit = (b: Bit) => {
      ctx.save();
      ctx.translate(b.x, b.y);
      ctx.rotate(b.rot);
      ctx.fillStyle = b.tint;
      if (b.s === 'winter') {
        ctx.globalAlpha = 0.9;
        ctx.beginPath();
        ctx.arc(0, 0, b.size, 0, Math.PI * 2);
        ctx.fill();
      } else if (b.s === 'summer') {
        ctx.beginPath();
        ctx.moveTo(0, 0);
        ctx.arc(0, 0, b.size, 0.4, Math.PI * 2 - 0.1);
        ctx.closePath();
        ctx.fill();
      } else {
        ctx.beginPath();
        ctx.ellipse(0, 0, b.size * 1.6, b.size, 0, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.restore();
    };

    // The brook itself (water, walls, grass, snow on the walls) for one season, between two heights
    const drawBrook = (s: Season, y0: number, y1: number) => {
      if (y1 <= y0) return;
      const look = LOOKS[s];
      ctx.save();
      ctx.beginPath();
      ctx.rect(0, y0, W, y1 - y0);
      ctx.clip();
      ctx.fillStyle = look.water;
      ctx.fillRect(0, 0, W, H);
      ctx.fillStyle = look.deep;
      ctx.fillRect(LEFT + 40, 0, RIGHT - LEFT - 80, H);
      ctx.fillStyle = look.water;
      ctx.globalAlpha = 0.6;
      ctx.fillRect(LEFT + 60, 0, RIGHT - LEFT - 120, H);
      ctx.globalAlpha = 1;
      for (const side of [0, 1]) {
        ctx.fillStyle = C.wallDark;
        ctx.fillRect(side === 0 ? 0 : RIGHT, 0, WALL, H);
        ctx.fillStyle = look.grass;
        ctx.fillRect(side === 0 ? 0 : W - 8, 0, 8, H);
      }
      for (const st of stones) {
        const y = ((st.y + wallOffset) % (H + 80)) - 40;
        const x = st.side === 0 ? 9 : RIGHT + 1;
        const w = Math.min(st.w, WALL - 10);
        ctx.fillStyle = C.wall;
        ctx.beginPath();
        ctx.roundRect(x, y, w, st.h, 4);
        ctx.fill();
        if (s === 'winter') {
          ctx.fillStyle = '#ffffff';
          ctx.beginPath();
          ctx.roundRect(x, y, w, 5, 3);
          ctx.fill();
        }
      }
      ctx.restore();
    };

    // The footbridge that marks a change of season, with the new season's name on it
    const drawBridge = (y: number, to: Season) => {
      ctx.save();
      ctx.fillStyle = 'rgba(16,36,26,0.25)'; // its shadow on the water
      ctx.fillRect(LEFT, y + 14, RIGHT - LEFT, 10);
      ctx.fillStyle = C.bridgeDark;
      ctx.fillRect(0, y - 16, W, 32);
      ctx.fillStyle = C.bridge;
      ctx.fillRect(0, y - 13, W, 26);
      ctx.fillStyle = C.bridgeDark; // parapets
      ctx.fillRect(0, y - 16, W, 4);
      ctx.fillRect(0, y + 12, W, 4);
      ctx.strokeStyle = 'rgba(0,0,0,0.12)'; // stone joints
      ctx.lineWidth = 1;
      for (let x = 12; x < W; x += 24) {
        ctx.beginPath();
        ctx.moveTo(x, y - 12);
        ctx.lineTo(x, y + 12);
        ctx.stroke();
      }
      if (to === 'winter') {
        ctx.fillStyle = '#ffffff';
        ctx.fillRect(0, y - 17, W, 4);
      }
      ctx.fillStyle = '#ffffff';
      ctx.font = '800 15px "Bricolage Grotesque", Inter, sans-serif';
      ctx.textAlign = 'center';
      ctx.textBaseline = 'middle';
      ctx.fillText(LOOKS[to].name.toUpperCase(), W / 2, y + 1);
      ctx.restore();
    };

    const draw = (t: number) => {
      // the brook: the coming season above the bridge, the current one below it
      if (change) {
        drawBrook(change.to, 0, change.y);
        drawBrook(change.from, change.y, H);
      } else drawBrook(season, 0, H);
      ctx.strokeStyle = C.ripple;
      ctx.lineWidth = 2;
      ctx.lineCap = 'round';
      for (const r of ripples) {
        ctx.beginPath();
        ctx.moveTo(r.x, r.y);
        ctx.lineTo(r.x, r.y + r.len);
        ctx.stroke();
      }
      bits.forEach((b) => b.s !== 'winter' && drawBit(b)); // leaves, petals and lily pads float under everything
      // flat things on the water first, then things that stick up
      for (const th of things) {
        if (th.kind === 'whirl') drawWhirl(th, t);
        else if (th.kind === 'ice') drawIce(th, t);
        else if (th.kind === 'shallow') drawShallow(th);
        else if (th.kind === 'blossom') drawBlossom(th, t);
      }
      for (const th of things) {
        if (th.kind === 'branch') drawBranch(th);
        else if (th.kind === 'rock') drawRock(th);
        else if (th.kind === 'pile') drawPile(th);
        else if (th.kind === 'chick') drawDuck(th.x + Math.sin(t * 2 + th.phase) * 3, th.y, 0.55, t + th.phase, C.yellow, 1, { s: th.s, v: th.phase * 10 });
        else if (th.kind === 'race') drawRacer(th, t);
        else if (th.kind === 'gold') drawGold(th, t);
        else if (th.kind === 'shield') drawShieldDuck(th, t);
        else if (th.kind === 'black') drawBlack(th, t);
      }
      for (const l of leavers) drawDuck(l.x, l.y, 0.55, t, C.yellow, Math.max(0, l.life / 1.2), { s: season, v: 5 });
      for (let i = trail.length - 1; i >= 0; i--) drawDuck(trail[i].x, trail[i].y, 0.55, t + i, C.yellow, 1, { s: season, v: i + 1 });
      const blink = safeTime > 0 && Math.floor(t * 10) % 2 === 0;
      if (goldTime > 0) {
        ctx.save();
        ctx.globalAlpha = 0.35;
        ctx.fillStyle = '#fff4b0';
        ctx.beginPath();
        ctx.arc(duckX, duckY, 26, 0, Math.PI * 2);
        ctx.fill();
        ctx.restore();
      }
      drawDuck(duckX, duckY, 1, t, goldTime > 0 ? C.gold : C.yellow, blink ? 0.35 : 1, { s: season, v: 0 });
      if (shieldTime > 0) {
        // the shield: a glowing red bubble that flickers in its last two seconds
        const ending = shieldTime < 2 && Math.floor(t * 8) % 2 === 0;
        ctx.save();
        ctx.globalAlpha = ending ? 0.3 : 0.75;
        ctx.strokeStyle = '#e8473a';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(duckX, duckY, 28 + Math.sin(t * 6) * 2, 0, Math.PI * 2);
        ctx.stroke();
        ctx.fillStyle = 'rgba(232,71,58,0.14)';
        ctx.fill();
        ctx.restore();
      }
      if (change) drawBridge(change.y, change.to); // the duck swims under the bridge
      bits.forEach((b) => b.s === 'winter' && drawBit(b)); // snow falls over everything

      // progress through the year: four segments, one per season
      const segW = (W - 24) / 4;
      for (let i = 0; i < 4; i++) {
        const x = 12 + i * segW;
        ctx.fillStyle = 'rgba(16,36,26,0.45)';
        ctx.fillRect(x + 1, H - 12, segW - 2, 6);
        const done = i < level ? 1 : i === level ? Math.min(1, levelTime / LEVEL_TIME) : 0;
        ctx.fillStyle = LOOKS[yearOrder[i]].bar;
        ctx.fillRect(x + 1, H - 12, (segW - 2) * done, 6);
      }

      // a first-time introduction: a ring around the thing and a label pointing at it, kept clear of the scores
      if (callout && state === 'playing') {
        const a = anchorOf(callout.th);
        const fade = Math.min(1, callout.t / 0.3);
        ctx.save();
        ctx.globalAlpha = fade;
        ctx.strokeStyle = '#f6c343';
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.arc(a.x, a.y, 28 + Math.sin(t * 8) * 3, 0, Math.PI * 2);
        ctx.stroke();
        ctx.font = '600 12px Inter, system-ui, sans-serif';
        // wrap the explanation onto up to two lines
        const words = callout.body.split(' ');
        const lines: string[] = [''];
        for (const w of words) {
          const tryLine = (lines[lines.length - 1] + ' ' + w).trim();
          if (ctx.measureText(tryLine).width > 210 && lines[lines.length - 1]) lines.push(w);
          else lines[lines.length - 1] = tryLine;
        }
        const bw = 236;
        const bh = 46 + lines.length * 16;
        const above = a.y - 44 - bh > 130; // room above the thing (below the scores)?
        const by = above ? a.y - 44 - bh : Math.min(H - bh - 24, a.y + 44);
        const bx = Math.max(12, Math.min(W - bw - 12, a.x - bw / 2));
        ctx.fillStyle = 'rgba(16,36,26,0.92)';
        ctx.beginPath();
        hintBox = { x: bx, y: by, w: bw, h: bh };
        ctx.roundRect(bx, by, bw, bh, 12);
        ctx.fill();
        ctx.strokeStyle = 'rgba(16,36,26,0.92)'; // pointer to the thing
        ctx.lineWidth = 3;
        ctx.beginPath();
        ctx.moveTo(Math.max(bx + 16, Math.min(bx + bw - 16, a.x)), above ? by + bh : by);
        ctx.lineTo(a.x, above ? a.y - 30 : a.y + 30);
        ctx.stroke();
        ctx.textAlign = 'left';
        ctx.textBaseline = 'top';
        ctx.fillStyle = '#f6c343';
        ctx.font = '800 15px "Bricolage Grotesque", Inter, sans-serif';
        ctx.fillText(callout.title, bx + 12, by + 9);
        ctx.fillStyle = '#ffffff';
        ctx.font = '600 12px Inter, system-ui, sans-serif';
        lines.forEach((l, n) => ctx.fillText(l, bx + 12, by + 28 + n * 16));
        ctx.fillStyle = 'rgba(223,233,226,0.75)';
        ctx.font = '600 10.5px Inter, system-ui, sans-serif';
        ctx.fillText('Tap here or press Enter to carry on', bx + 12, by + 30 + lines.length * 16);
        ctx.restore();
      }

      // the season label slides down from the top, stays a moment, then slides away
      if (label && label.t > 0 && state === 'playing') {
        const age = label.total - label.t;
        const slide = Math.min(1, age / 0.4, label.t / 0.4);
        const y = -30 + slide * 132; // ends up below the scores and the golden-duck badge
        ctx.save();
        ctx.font = '800 17px "Bricolage Grotesque", Inter, sans-serif';
        const w1 = ctx.measureText(label.text).width;
        ctx.font = '600 11.5px Inter, system-ui, sans-serif';
        const w2 = ctx.measureText(label.sub).width;
        const w = Math.min(W - 24, Math.max(w1, w2) + 32);
        ctx.fillStyle = 'rgba(16,36,26,0.85)';
        ctx.beginPath();
        ctx.roundRect(W / 2 - w / 2, y - 20, w, 44, 14);
        ctx.fill();
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillStyle = '#f6c343';
        ctx.font = '800 17px "Bricolage Grotesque", Inter, sans-serif';
        ctx.fillText(label.text, W / 2, y - 6);
        ctx.fillStyle = '#dfe9e2';
        ctx.font = '600 11.5px Inter, system-ui, sans-serif';
        ctx.fillText(label.sub, W / 2, y + 12, W - 40);
        ctx.restore();
      }
    };

    // ---------- Seasons: starting a change, and the duck swimming into the next season ----------
    const startChange = (to: Season, newYear: boolean) => {
      change = { y: -20, from: season, to, newYear, crossed: false };
    };
    const completeSeason = () => {
      seasonsDone++;
      if (!bumpedThisSeason) {
        points += CLEAN_BONUS * mult();
        return ` Clean season, +${CLEAN_BONUS * mult()}!`;
      }
      return '';
    };
    const enterSeason = (to: Season, newYear: boolean) => {
      let clean = '';
      if (newYear) {
        year++;
        level = 0;
      } else {
        clean = completeSeason();
        level++;
      }
      season = to;
      levelTime = 0;
      bumpedThisSeason = false;
      speed = Math.max(speed, baseSpeed());
      const cost = `bumps cost ${bumpCost()} duckling${bumpCost() === 1 ? '' : 's'}`;
      label = { text: newYear ? `Bonus year ${bonusYears()} · ${LOOKS[to].name}` : LOOKS[to].name, sub: `${LOOKS[to].hazard} · ${cost}`, t: 3.2, total: 3.2 };
      sfx.season();
      announce.textContent = `${newYear ? `Bonus year ${bonusYears()}. ` : ''}${LOOKS[to].name}, season ${level + 1} of 4. Faster, ${LOOKS[to].hazard}, and ${cost}.${clean}`;
    };

    // ---------- Game loop ----------
    const step = (now: number) => {
      const realDt = Math.min(0.05, (now - last) / 1000 || 0);
      last = now;
      const dt = slowmo > 0 && state === 'playing' ? realDt * 0.12 : realDt; // game time (nearly still while introducing something)
      if (state === 'playing') {
        slowmo = Math.max(0, slowmo - realDt);
        if (callout) {
          callout.t -= realDt;
          if (callout.t <= 0) {
            callout = null;
            hintGap = 0.8;
          }
        } else {
          hintGap = Math.max(0, hintGap - realDt);
        }
      }
      const t = now / 1000;
      if (state === 'playing') {
        speed = Math.min(baseSpeed() * 1.08, speed + dt * 1.2); // a step faster each season, creeping up a little within it
        const dy = speed * dt;
        distance += dy;
        points += (dy / 20) * mult();
        wallOffset = (wallOffset + dy) % (H + 80);
        goldTime = Math.max(0, goldTime - dt);
        shieldTime = Math.max(0, shieldTime - dt);
        // the black duck turns up now and then, but only when you have ducklings to lose
        if (distance > nextBlack && trail.length > 0 && !things.some((th) => th.kind === 'black')) {
          things.push({ kind: 'black', y: -30, x: randX(40), vx: 0, vy: 0, life: 7, leaving: false, carrying: false, s: season });
          nextBlack = distance + (3500 + Math.random() * 2500) / busier(); // more often in bonus years
          tone(200, 0.25, 'square', 140, 0.06);
          announce.textContent = 'A black duck is after your ducklings! Keep moving.';
        } else if (distance > nextBlack && trail.length === 0) nextBlack = distance + 600; // try again later
        safeTime = Math.max(0, safeTime - dt);
        knock = Math.max(0, knock - dt);
        if (label) label.t -= realDt;

        // seasons: after 30 seconds the next season's bridge appears and flows down; the year ends after four
        if (!change) {
          if (!callout) levelTime += dt; // reading a hint never eats into the season
          if (levelTime >= LEVEL_TIME) {
            if (level >= 3) finishYear();
            else startChange(yearOrder[level + 1], false);
          }
        } else {
          change.y += dy;
          if (!change.crossed && change.y >= duckY) {
            change.crossed = true;
            enterSeason(change.to, change.newYear);
          }
          if (change.y > H + 30) change = null;
        }
        if (state !== 'playing') {
          draw(t);
          requestAnimationFrame(step);
          return;
        }

        // the season's challenges change how the duck handles
        let grip = 10; // how quickly the duck answers the steering
        let drag = 0; // being pushed back down the brook
        for (const th of things) {
          if (th.kind === 'ice' && ((duckX - (th.x + th.w / 2)) / (th.w * 0.45)) ** 2 + ((duckY - th.y) / (th.h * 0.45)) ** 2 < 1) grip = 1.6;
          else if (th.kind === 'blossom' && near(th.x, th.y, th.r - 6)) {
            drag = Math.max(drag, 190);
            grip = Math.min(grip, 5);
          } else if (th.kind === 'shallow' && Math.abs(duckX - (th.fromLeft ? LEFT : RIGHT)) < bankWidth(th, duckY) + 6) {
            drag = Math.max(drag, 260); // stronger than you can swim against, so it really pulls you back
            grip = Math.min(grip, 4);
          }
        }

        if (steer) targetX = duckX + steer * 40;
        if (steerY) targetY = duckY + steerY * 40;
        if (kickX || kickY) {
          duckX += kickX * dt;
          duckY += kickY * dt;
          targetX += kickX * dt;
          targetY += kickY * dt;
          const fade = Math.pow(0.12, dt); // the knock fades over about a second
          kickX = Math.abs(kickX * fade) < 2 ? 0 : kickX * fade;
          kickY = Math.abs(kickY * fade) < 2 ? 0 : kickY * fade;
        }
        targetX = Math.max(LEFT + DUCK_R + 2, Math.min(RIGHT - DUCK_R - 2, targetX));
        targetY = Math.max(TOP_Y, Math.min(BOTTOM_Y, targetY));
        duckX += (targetX - duckX) * Math.min(1, dt * grip);
        duckY += (targetY - duckY) * Math.min(1, dt * grip) + drag * dt;
        if (drag) targetY = Math.max(targetY, duckY - 30); // the pull wins over steering up
        duckX = Math.max(LEFT + DUCK_R + 2, Math.min(RIGHT - DUCK_R - 2, duckX));
        duckY = Math.max(TOP_Y, Math.min(BOTTOM_Y, duckY));

        for (const r of ripples) {
          r.y += dy * 1.1;
          if (r.y > H) {
            r.y = -r.len;
            r.x = LEFT + Math.random() * (RIGHT - LEFT);
          }
        }
        // floating bits drift with the water (snow falls); new ones arrive in the coming season, gradually
        // changing the mix as the new season flows in
        const want = BIT_COUNT[spawnSeason()];
        for (let i = bits.length - 1; i >= 0; i--) {
          const b = bits[i];
          b.y += b.s === 'winter' ? b.vy * dt : dy;
          b.x += b.vx * dt;
          b.rot += dt * (b.s === 'winter' ? 0 : 0.6);
          if (b.y > H + 12) {
            if (bits.length > want) bits.splice(i, 1);
            else bits[i] = makeBit(false);
          }
        }
        if (bits.length < want && Math.random() < dt * 8) bits.push(makeBit(false));

        nextSpawn -= dy;
        if (nextSpawn <= 0) spawn();
        for (const th of things) {
          if (th.kind === 'black') continue; // the black duck swims under its own steam (below)
          th.y += th.kind === 'race' ? dy * (th.size > 1.2 ? 0.4 : 0.55) : dy; // race ducks drift slower; giants slowest
        }
        // The black duck: heads for the back of your line, slower than you and slow to turn, so steady
        // swimming dodges it. After a while it gives up; if it reaches you it takes the last duckling and leaves.
        for (const b of things) {
          if (b.kind !== 'black') continue;
          b.life -= dt;
          if (!b.leaving) {
            const tail = trail[trail.length - 1] ?? { x: duckX, y: duckY };
            const dx = tail.x - b.x;
            const dyy = tail.y - b.y;
            const len = Math.hypot(dx, dyy) || 1;
            const SPEED = 95; // you can swim faster than this
            b.vx += ((dx / len) * SPEED - b.vx) * Math.min(1, dt * 1.6); // slow to change direction
            b.vy += ((dyy / len) * SPEED - b.vy) * Math.min(1, dt * 1.6);
            if (b.life <= 0 || trail.length === 0) b.leaving = true;
            // reaching your duck or any duckling
            const touches = dist2(b.x, b.y, duckX, duckY) < 26 * 26 || trail.some((c) => dist2(b.x, b.y, c.x, c.y) < 18 * 18);
            if (touches) {
              b.leaving = true;
              if (shieldTime > 0) {
                b.vx = (b.x - duckX) * 6; // bounced off the shield
                b.vy = -160;
                sfx.boing(1.2);
                announce.textContent = 'Your shield sent the black duck packing!';
              } else if (loseDuckling()) {
                leavers.pop(); // it carries this one off instead of it swimming away
                b.carrying = true;
                bumpedThisSeason = true;
                sfx.bump();
                announce.textContent = `The black duck took a duckling! ${trail.length} left.`;
              }
            }
          } else {
            b.vy += (-180 - b.vy) * Math.min(1, dt * 2); // swims off upstream
          }
          b.x = Math.max(LEFT + 14, Math.min(RIGHT - 14, b.x + b.vx * dt));
          b.y += b.vy * dt;
          if (b.leaving && b.y < -60) b.y = H + 999; // gone
        }
        if (!callout && hintGap <= 0 && !(label && label.t > 0)) {
          // wait until the season label has gone, and until the thing is clear of the top of the brook
          const fresh = things.find((th) => INTRO[th.kind] && !seen.has(th.kind) && th.y > 150 && th.y < H * 0.6);
          if (fresh) {
            const [title, body] = INTRO[fresh.kind]!;
            callout = { th: fresh, title, body, t: HINT_TIME };
            slowmo = 4.5;
            seen.add(fresh.kind);
            try {
              localStorage.setItem('duckDashSeen', JSON.stringify([...seen]));
            } catch {}
            announce.textContent = `${title}: ${body}`;
          }
        }

        for (const th of things) {
          if (th.kind === 'chick' && near(th.x, th.y, 8)) {
            th.y = H + 999;
            rescued++;
            sfx.quack();
            if (trail.length < MAX_LINE) {
              trail.push({ x: duckX, y: duckY + 30 });
              points += 10 * mult();
              announce.textContent = `Duckling rescued. ${trail.length} in your line.`;
            } else {
              points += 25 * mult(); // your line's full: this one's worth more points instead
              label = { text: 'Line full!', sub: `+${25 * mult()} points for that duckling`, t: 1.6, total: 1.6 };
              announce.textContent = `Your line is full. +${25 * mult()} points.`;
            }
          } else if (th.kind === 'shield' && near(th.x, th.y, 12)) {
            th.y = H + 999;
            shieldTime = SHIELD_TIME;
            sfx.chime();
            announce.textContent = 'Shield! Nothing can hurt you for 8 seconds.';
          } else if (th.kind === 'gold' && near(th.x, th.y, 12)) {
            th.y = H + 999;
            goldTime = 10;
            sfx.chime();
            announce.textContent = 'Golden duck! Double points for 10 seconds.';
          } else if (th.kind === 'race') {
            // bump a race duck and you both bounce apart: big ones shove you hard and barely move,
            // small ones give a nudge and pinball away
            th.cool = Math.max(0, th.cool - dt);
            const reach = 13 * th.size;
            if (th.cool <= 0 && near(th.x, th.y, reach)) {
              const dx = duckX - th.x;
              const dyy = duckY - th.y;
              const len = Math.hypot(dx, dyy) || 1;
              // you get knocked back (bigger ducks, bigger shove) and the race duck glides away (small ones further)
              const shove = 160 + 260 * (th.size - 0.55); // knocked roughly: small 75px, medium 95px, large 125px, giant 190px
              const nx = dx / len;
              const ny = dyy / len;
              kickX = nx * shove;
              kickY = ny * shove * 0.8;
              duckX += nx * 6 * th.size; // a visible jolt straight away
              duckY += ny * 4 * th.size;
              targetX = duckX;
              targetY = duckY;
              knock = 0.35;
              th.vx = -nx * (110 / th.size);
              th.cool = 0.5;
              sfx.boing(th.size);
            }
            th.x += th.vx * dt;
            th.vx *= Math.pow(0.05, dt);
            th.x = Math.max(LEFT + 12 * th.size, Math.min(RIGHT - 12 * th.size, th.x));
          } else if (th.kind === 'whirl') {
            const d = Math.sqrt(dist2(duckX, duckY, th.x, th.y));
            if (d < th.r + 24) {
              const pull = (1 - d / (th.r + 24)) * dt * 3;
              duckX += (th.x - duckX) * pull;
              duckY += (th.y - duckY) * pull;
              targetX += (th.x - targetX) * pull;
              targetY += (th.y - targetY) * pull;
            }
            if (d < 12 && !th.spun) {
              th.spun = true;
              if (shieldTime <= 0 && loseDuckling()) {
                sfx.bump();
                announce.textContent = `The whirlpool spun a duckling away. ${trail.length} left.`;
              }
            }
          } else if (th.kind === 'pile' && !th.done && near(th.x, th.y, th.r - 8)) {
            th.done = true; // the leaves scatter: sometimes there was a rock underneath
            if (th.rock) bump();
          } else if ((th.kind === 'branch' && hitsBranch(th)) || (th.kind === 'rock' && near(th.x, th.y, th.r - 3))) {
            bump();
          }
          if (state !== 'playing') break;
        }
        things = things.filter((th) => th.y < H + 80 || (th.kind === 'black' && th.y < H + 500));

        for (const l of leavers) {
          l.x += l.vx * dt;
          l.y += l.vy * dt + dy;
          l.life -= dt;
        }
        leavers = leavers.filter((l) => l.life > 0);

        let lx = duckX;
        let ly = duckY;
        for (const c of trail) {
          c.x += (lx - c.x) * Math.min(1, dt * 7);
          c.y += (ly + 24 - c.y) * Math.min(1, dt * 7);
          lx = c.x;
          ly = c.y;
        }
        updateHud();
      }
      draw(t);
      requestAnimationFrame(step);
    };

    // ---------- Screens ----------
    const show = (title: string, text: string, button: string, finish?: string) => {
      overlayTitle.textContent = title;
      overlayText.textContent = text;
      startBtn.textContent = button;
      finishBtn.hidden = !finish;
      if (finish) finishBtn.textContent = finish;
      shareBtn.hidden = state !== 'over'; // only on the end screens
      document.querySelector<HTMLElement>('[data-promo]')?.toggleAttribute('hidden', state !== 'over'); // invite to the real duck race
      overlay.classList.toggle('is-end', state === 'over'); // a more compact layout for the end screens
      seasonEl.hidden = state === 'over';
      sharedEl.textContent = '';
      overlay.hidden = false;
      startBtn.focus({ preventScroll: true });
    };
    const start = () => {
      if (state === 'over' || state === 'ready') reset();
      gameWrap.classList.add('is-playing');
      if (soundOn) ensureAudio();
      finishBtn.hidden = true;
      state = 'playing';
      overlay.hidden = true;
      pauseBtn.textContent = 'Pause';
      canvas.focus({ preventScroll: true });
    };
    const pause = () => {
      if (state !== 'playing') return;
      state = 'paused';
      gameWrap.classList.remove('is-playing');
      pauseBtn.textContent = 'Resume';
      show('Paused', 'Take a breather.', 'Keep swimming');
    };
    const where = () => (bonusYears() ? `You completed the year and reached ${LOOKS[season].name.toLowerCase()} of bonus year ${bonusYears()}` : `You reached ${LOOKS[season].name.toLowerCase()}`);
    const saveBest = () => {
      const s = score();
      const isBest = s > best;
      if (isBest) {
        best = s;
        bestEl.textContent = String(best);
        try {
          localStorage.setItem('duckDashBest', String(best));
        } catch {}
      }
      return isBest;
    };
    // End of a year: carry on (it keeps getting faster) or finish and bank the duckling bonus
    function finishYear() {
      gameWrap.classList.remove('is-playing');
      const clean = completeSeason();
      state = 'paused';
      atYearEnd = true;
      sfx.chime();
      updateHud();
      const kept = trail.length;
      const bonus = kept * 25;
      const msg = `${clean ? clean.trim() + ' ' : ''}Score so far: ${score()}. Finish now to bank it${bonus ? ` with ${bonus} bonus points for your ${kept} duckling${kept === 1 ? '' : 's'}` : ''}, or keep swimming into a bonus year for a bigger score: busier water, a hungrier black duck and fewer ducklings. Get knocked out and you lose the duckling bonus.`;
      announce.textContent = `You made it through year ${year}! ${msg}`;
      show(year === 1 ? "You've completed Duck Dash!" : `Bonus year ${bonusYears()} done!`, msg, 'Keep swimming (bonus)', 'Finish');
    }
    function keepSwimming() {
      atYearEnd = false;
      startChange(yearOrder[0], true);
      start();
    }
    function finishNow() {
      gameWrap.classList.remove('is-playing');
      atYearEnd = false;
      state = 'over';
      const bonus = trail.length * 25;
      points += bonus;
      const isBest = saveBest();
      updateHud();
      const msg = `You swam ${year === 1 ? 'the whole year' : `the whole year and ${bonusYears()} bonus year${bonusYears() === 1 ? '' : 's'}`} and scored ${score()}${bonus ? `, including ${bonus} for the ${trail.length} duckling${trail.length === 1 ? '' : 's'} still with you` : ''}.${isBest ? ' A new best!' : ''}`;
      announce.textContent = `You made it! ${msg}`;
      shareText = `I swam ${year === 1 ? 'a whole year' : `${year} years`} down Bradwell Brook in Duck Dash and scored ${score()}! 🦆 Can you beat it?`;
      show('You made it!', msg, 'Play again');
    }
    function gameOver() {
      gameWrap.classList.remove('is-playing');
      state = 'over';
      const isBest = saveBest();
      sfx.over();
      const msg = `${where()} and scored ${score()}${rescued ? `, rescuing ${rescued} duckling${rescued === 1 ? '' : 's'}` : ''}.${isBest ? ' A new best!' : ''}`;
      announce.textContent = `Game over. ${msg}`;
      shareText = `I reached ${LOOKS[season].name.toLowerCase()}${year > 1 ? ` of year ${year}` : ''} on Bradwell Brook in Duck Dash and scored ${score()}${rescued ? `, rescuing ${rescued} duckling${rescued === 1 ? '' : 's'}` : ''}! 🦆 Can you beat it?`;
      show(isBest ? 'New best!' : 'Game over', msg, 'Swim again');
    }

    // Share: the phone's share menu where there is one (Facebook, WhatsApp, Messages…), otherwise copy
    // the message and link so it can be pasted into a post
    shareBtn.addEventListener('click', async () => {
      const link = location.origin + location.pathname; // the game page, without any test settings
      if (navigator.share) {
        try {
          await navigator.share({ title: 'Duck Dash', text: shareText, url: link });
          return;
        } catch (e) {
          if ((e as Error).name === 'AbortError') return; // they closed the share menu
        }
      }
      try {
        await navigator.clipboard.writeText(`${shareText} ${link}`);
        sharedEl.textContent = 'Copied! Paste it into a post or message.';
      } catch {
        sharedEl.textContent = `Copy this: ${shareText} ${link}`;
      }
    });

    // ---------- Controls ----------
    startBtn.addEventListener('click', () => (atYearEnd ? keepSwimming() : start()));
    finishBtn.addEventListener('click', finishNow);
    pauseBtn.addEventListener('click', () => (state === 'playing' ? pause() : state === 'paused' && !atYearEnd ? start() : undefined));
    document.querySelectorAll<HTMLButtonElement>('.ctrl[data-dir], .ctrl[data-diry]').forEach((b) => {
      const vertical = b.dataset.diry !== undefined;
      const dir = Number(vertical ? b.dataset.diry : b.dataset.dir);
      const on = (e: Event) => {
        e.preventDefault();
        if (vertical) steerY = dir;
        else steer = dir;
      };
      const off = () => (vertical ? (steerY = 0) : (steer = 0));
      b.addEventListener('pointerdown', on);
      b.addEventListener('pointerup', off);
      b.addEventListener('pointerleave', off);
      b.addEventListener('pointercancel', off);
      b.addEventListener('keydown', (e) => (e.key === 'Enter' || e.key === ' ') && on(e));
      b.addEventListener('keyup', off);
    });
    document.addEventListener('keydown', (e) => {
      if (['ArrowLeft', 'a', 'A'].includes(e.key)) steer = -1;
      else if (['ArrowRight', 'd', 'D'].includes(e.key)) steer = 1;
      else if (['ArrowUp', 'w', 'W'].includes(e.key)) steerY = -1;
      else if (['ArrowDown', 's', 'S'].includes(e.key)) steerY = 1;
      else if ((e.key === ' ' || e.key === 'p' || e.key === 'P') && (state === 'playing' || state === 'paused') && !atYearEnd) {
        if (document.activeElement?.closest('.ctrl, [data-start], [data-finish]')) return;
        e.preventDefault();
        state === 'playing' ? pause() : start();
        return;
      } else return;
      if (state === 'playing') e.preventDefault();
    });
    document.addEventListener('keyup', (e) => {
      if (['ArrowLeft', 'a', 'A', 'ArrowRight', 'd', 'D'].includes(e.key)) steer = 0;
      if (['ArrowUp', 'w', 'W', 'ArrowDown', 's', 'S'].includes(e.key)) steerY = 0;
    });
    const toBoard = (clientX: number, clientY: number) => {
      const r = canvas.getBoundingClientRect();
      return [((clientX - r.left) / r.width) * W, ((clientY - r.top) / r.height) * H];
    };
    const follow = (e: PointerEvent) => {
      if (knock > 0) return; // let a knock from a race duck play out before following your finger again
      [targetX, targetY] = toBoard(e.clientX, e.clientY - 40); // aim just above your finger
    };
    let dragging = false;
    // dismiss a first-time hint early
    const skipHint = () => {
      if (!callout || HINT_TIME - callout.t < 1) return false; // can't be dismissed in its first second
      callout = null;
      slowmo = 0;
      hintGap = 0.8;
      return true;
    };
    // Only a deliberate action dismisses a hint: Enter, or tapping the hint itself. Steering never does.
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' && state === 'playing' && skipHint()) e.preventDefault();
    });
    canvas.addEventListener('pointerdown', (e) => {
      if (state === 'playing' && callout) {
        const [bx, by] = toBoard(e.clientX, e.clientY);
        const hb = hintBox;
        if (bx >= hb.x && bx <= hb.x + hb.w && by >= hb.y && by <= hb.y + hb.h && skipHint()) return;
      }
      if (state !== 'playing') return;
      dragging = true;
      follow(e);
      canvas.setPointerCapture(e.pointerId);
    });
    canvas.addEventListener('pointermove', (e) => dragging && follow(e));
    canvas.addEventListener('pointerup', () => (dragging = false));
    canvas.addEventListener('pointercancel', () => (dragging = false));
    document.addEventListener('visibilitychange', () => document.hidden && pause());

    // Full screen: the browser's real full-screen mode where it's allowed; otherwise (iPhone) the game
    // simply fills the window
    const wrap = root.closest<HTMLElement>('.game-wrap')!;
    const fullBtn = $<HTMLButtonElement>('[data-full]');
    const exitBtn = $<HTMLButtonElement>('[data-full-exit]');
    const isFull = () => wrap.classList.contains('is-full');
    const setFull = (on: boolean) => {
      wrap.classList.toggle('is-full', on);
      document.documentElement.classList.toggle('game-full', on);
      fullBtn.textContent = on ? 'Exit full screen' : 'Full screen';
      exitBtn.hidden = !on;
      fullBtn.setAttribute('aria-pressed', String(on));
      requestAnimationFrame(fit);
    };
    exitBtn.addEventListener('click', async () => {
      if (document.fullscreenElement) await document.exitFullscreen().catch(() => {});
      setFull(false);
    });
    fullBtn.addEventListener('click', async () => {
      if (isFull()) {
        if (document.fullscreenElement) await document.exitFullscreen().catch(() => {});
        setFull(false);
      } else {
        setFull(true);
        await wrap.requestFullscreen?.().catch(() => {}); // not available on iPhone: the CSS fills the window instead
      }
    });
    document.addEventListener('fullscreenchange', () => {
      if (!document.fullscreenElement && isFull()) setFull(false); // left with Esc or the back gesture
    });
    document.addEventListener('keydown', (e) => e.key === 'Escape' && isFull() && !document.fullscreenElement && setFull(false));

    const fit = () => {
      const ratio = Math.min(window.devicePixelRatio || 1, 2);
      const cssW = canvas.clientWidth;
      canvas.width = Math.round(cssW * ratio);
      canvas.height = Math.round(((cssW * H) / W) * ratio);
      ctx.setTransform(canvas.width / W, 0, 0, canvas.height / H, 0, 0);
    };
    fit();
    window.addEventListener('resize', fit);
    reset();
    requestAnimationFrame((now) => {
      last = now;
      step(now);
    });
  }
</script>

