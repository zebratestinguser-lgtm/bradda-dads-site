---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import EventsYear from '../components/home/EventsYear.astro';
import NewsSection from '../components/home/NewsSection.astro';
import CardBanner from '../components/home/CardBanner.astro';
import WolfspitBand from '../components/home/WolfspitBand.astro';
import PhotosSection from '../components/home/PhotosSection.astro';
import StorySection from '../components/home/StorySection.astro';
import MoneyMap from '../components/home/MoneyMap.astro';
import DonateSection from '../components/home/DonateSection.astro';
import JoinSection from '../components/home/JoinSection.astro';
import { getEvents, pickNextEvent } from '../lib/events';

const events = await getEvents();
const next = pickNextEvent(events);
---

<BaseLayout>
  {next ? <Hero event={next} /> : <h1 class="visually-hidden">Bradda Dads</h1>}
  <EventsYear events={events} nextId={next?.id} />
  <NewsSection />
  <CardBanner />
  <WolfspitBand />
  <PhotosSection />
  <StorySection />
  <MoneyMap />
  <DonateSection />
  <JoinSection />
</BaseLayout>
