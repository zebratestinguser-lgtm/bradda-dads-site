---
// Privacy notice. The wording lives in src/content/pages/privacy.md so the team can edit it in
// Pages CMS ("Privacy notice"). The contact form section is added automatically once the form is live.
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import { getSite } from '../lib/site';
import { formatDate } from '../lib/format';

const site = await getSite();
const hasForm = site.contactFormUrl.startsWith('https://');
const page = await getEntry('pages', 'privacy');
if (!page) throw new Error('src/content/pages/privacy.md is missing');
const { Content } = await render(page);
---

<BaseLayout title="Privacy" description="How the Bradda Dads website handles your information.">
  <PageHeader eyebrow="Privacy" title={page.data.title} intro={page.data.intro} />
  <section class="container page-section">
    <div class="prose">
      <Content />
      {
        hasForm && (
          <>
            <h2>Messages you send us</h2>
            <p>
              The contact form is run by Formspree, which passes your name, email address and message to us by email. Formspree keeps submissions for 30 days. We only use your details to reply, and
              don't add you to any mailing list. See <a href="https://formspree.io/legal/privacy-policy/">Formspree's privacy policy</a>.
            </p>
          </>
        )
      }
      {page.data.updated && <p class="updated">Last updated {formatDate(page.data.updated)}.</p>}
    </div>
  </section>
</BaseLayout>

<style>
  .updated {
    color: var(--muted);
    font-size: 15px;
  }
</style>
