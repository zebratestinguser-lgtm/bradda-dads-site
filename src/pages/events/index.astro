---
import { getWording } from '../../lib/wording';
const w = await getWording('events'); // Page wording form
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import PageHeader from '../../components/PageHeader.astro';
import EventCard from '../../components/EventCard.astro';
import DiaryDates from '../../components/DiaryDates.astro';
import { getEvents, pickNextEvent } from '../../lib/events';
import { url } from '../../lib/url';

const events = await getEvents();
const next = pickNextEvent(events);
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description')}>
  <PageHeader eyebrow={w.text('eyebrow')} title={w.text('title')} intro={w.text('intro')}>
    <a class="cal" href={url('/events.ics')}>{w.text('calendarLink')}</a>
  </PageHeader>
  <Band first><section class="container page-section">
    <ul class="grid" role="list">
      {events.map((e) => <li><EventCard event={e} isNext={e.id === next?.id} headingLevel="h2" /></li>)}
    </ul>
  </section></Band>
  <Band tone="mist"><section class="container page-section">
    <div class="diary-wrap"><DiaryDates /></div>
  </section></Band>
</BaseLayout>

<style>
  .cal {
    color: var(--white);
    font-weight: 600;
    align-self: flex-start;
    padding-block: 10px;
  }
  .diary-wrap {
    max-width: 760px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 20px;
  }
</style>
