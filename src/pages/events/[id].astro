---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Band from '../../components/Band.astro';
import PageHeader from '../../components/PageHeader.astro';
import AlbumCard from '../../components/AlbumCard.astro';
import { getEvents, pickNextEvent, statusFor, formatEventDates, isOpen, isPlaceholder } from '../../lib/events';
import { getWolfspitYears } from '../../lib/results';
import { getAlbums, EVENT_TAG, categorySlug } from '../../lib/albums';
import { formatDate, formatTime } from '../../lib/format';
import { url } from '../../lib/url';
import { eventPhoto } from '../../lib/photos';
import { getSite } from '../../lib/site';
import { canAddToCalendar, googleCalendarUrl, eventJsonLd } from '../../lib/calendar';

export async function getStaticPaths() {
  const events = await getEvents();
  return events.map((event) => ({ params: { id: event.id }, props: { event } }));
}

const { event } = Astro.props;
const d = event.data;
const { Content } = await render(event);
const next = pickNextEvent(await getEvents());
const status = statusFor(event, event.id === next?.id).label;

const tag = EVENT_TAG[event.id];
const eventAlbums = (await getAlbums()).filter((a) => a.data.photos.length > 0 && (a.data.event?.id === event.id || (tag && a.data.category === tag)));
const albums = eventAlbums.slice(0, 4);
const news = tag
  ? (await getCollection('news')).filter((n) => n.data.tag === tag).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 5)
  : [];
const ctaHref = url(d.ctaUrl);
// "How to get involved" cards; some only apply while entries are open
const open = isOpen(event);
const ways = d.involvement.filter((w) => !w.onlyWhenOpen || open);
// Race results for the fell race
const isRace = event.id === 'wolfspit';
const raceAll = isRace ? await getWolfspitYears() : [];
const raceYears = raceAll.map((y) => y.year).sort((a, b) => a - b);
const latestRace = raceAll[0];
// Header photo: the event's own heroImage if set, else the latest real photo from its albums
const photo = d.heroImage ? { src: d.heroImage, label: d.heroImageCaption } : await eventPhoto(event.id);
// The main action shows in the header, and again in a slim bar at the bottom of phone screens
const showCta = () => !ctaIsSelf && (d.status !== 'open' || open);
const ctaIsSelf = d.ctaUrl === `/events/${event.id}/`;
// Add to calendar (only while this year's date is still to come) and the Event details Google reads
const site = await getSite();
const siteUrl = new URL(import.meta.env.BASE_URL, Astro.site).href;
const pageUrl = new URL(`events/${event.id}/`, siteUrl).href;
const addToCalendar = canAddToCalendar(event);
const jsonLd = addToCalendar
  ? eventJsonLd(event, { pageUrl, siteUrl, siteName: site.name, imageUrl: photo ? new URL(url(photo.src), Astro.site).href : undefined, ctaUrl: d.ctaUrl })
  : undefined;
---

<BaseLayout title={d.name} description={d.summary} ogImage={photo?.src} ogImageAlt={d.heroImage ? d.heroImageAlt : photo && 'alt' in photo ? photo.alt : undefined}>
  {jsonLd && <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  <PageHeader eyebrow={status} title={d.name} intro={d.summary} image={photo?.src} imageLabel={photo?.label}>
    <a class="back" href={url('/events/')}>← All events</a>
    <ul class="facts" role="list">
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
        {formatEventDates(event, true) ?? d.when}
      </li>
      {d.start && (
        <li>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
          {d.startTimeConfirmed ? formatTime(d.start) : 'Time to be confirmed'}
        </li>
      )}
      <li>
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z"></path><circle cx="12" cy="10" r="2.5"></circle></svg>
        {isPlaceholder(d.location) ? 'Place to be confirmed' : d.location}
      </li>
    </ul>
    {showCta() && (
      <a class="btn btn--yellow btn--md" href={ctaHref} data-header-cta>
        {d.ctaLabel}
        {d.price && ` · ${d.price}`}
      </a>
    )}
  </PageHeader>

  <!-- 1. What's happening -->
  <Band first><section class="container page-section ev-section" aria-labelledby="what-title">
    <h2 class="subhead" id="what-title">What's happening</h2>
    <div class="prose"><Content /></div>
  </section></Band>

  <!-- 2. When and where -->
  <Band tone="mist"><section class="container page-section ev-section" aria-labelledby="when-title">
    <h2 class="subhead" id="when-title">When and where</h2>
    <dl class="ww">
      <div class="ww__item">
        <dt>When</dt>
        <dd>{formatEventDates(event, true) ?? d.when}</dd>
      </div>
      <div class="ww__item">
        <dt>Time</dt>
        <dd>{d.start && d.startTimeConfirmed ? formatTime(d.start) : 'To be confirmed'}</dd>
      </div>
      <div class="ww__item">
        <dt>Where</dt>
        <dd>{isPlaceholder(d.location) ? 'To be confirmed' : d.location}</dd>
      </div>
    </dl>
    {d.whenWhereNote && <p class="ww__note">{d.whenWhereNote}</p>}
    {
      addToCalendar ? (
        <div class="cal">
          <p class="cal__label" id="cal-label">Add {d.name} to your calendar{!d.startTimeConfirmed && ' (as an all-day event until the time is confirmed)'}:</p>
          <ul class="cal__links" role="list" aria-labelledby="cal-label">
            <li><a class="btn btn--green btn--md" href={googleCalendarUrl(event, pageUrl)} rel="noopener" target="_blank">Google Calendar<span class="visually-hidden"> (opens in a new tab)</span></a></li>
            <li><a class="btn btn--outline btn--md" href={url(`/events/${event.id}.ics`)} download={`${event.id}.ics`}>Apple, Outlook and others</a></li>
          </ul>
          <a class="link-arrow" href={url('/events.ics')}>Or add every Bradda Dads event →</a>
        </div>
      ) : (
        d.start && <a class="link-arrow" href={url('/events.ics')}>Add our events to your calendar →</a>
      )
    }
  </section></Band>

  <!-- 3. How to get involved -->
  <Band tone="white"><section class="container page-section ev-section" aria-labelledby="involved-title">
    <h2 class="subhead" id="involved-title">How to get involved</h2>
    {
      ways.length > 0 ? (
        <ul class="ways" role="list">
          {ways.map((w) => (
            <li class="way">
              <h3 class="way__title">{w.title}</h3>
              <p class="way__text">{w.text}</p>
              {w.url && (
                <a class="btn btn--green btn--md way__btn" href={url(w.url)}>
                  {w.label ?? 'Find out more'}
                </a>
              )}
            </li>
          ))}
        </ul>
      ) : (
        <p class="note">
          Details coming soon. In the meantime, <a href={url('/get-involved/')}>find out how to help</a>.
        </p>
      )
    }
  </section></Band>

  <!-- 4. From past years -->
  {
    (albums.length > 0 || news.length > 0 || isRace) && (
      <Band tone="mist"><section class="container page-section ev-section past" aria-labelledby="past-title">
        <h2 class="subhead" id="past-title">From past years</h2>
        {isRace && latestRace && (
          <a class="race-link" href={url('/wolfspit/')}>
            <span class="race-link__label">Race results</span>
            <span class="race-link__title">Wolf's Pit results from {raceYears[0]} to {latestRace.year}</span>
            <span class="race-link__meta">{latestRace.year}: {latestRace.finishers} finishers · search any runner →</span>
          </a>
        )}
        {albums.length > 0 && (
          <div class="stack">
            <h3 class="past__sub" id="photos-title">Photos</h3>
            <ul class="card-grid" role="list">
              {albums.map((a, i) => (
                <li>
                  <AlbumCard album={a} index={i} />
                </li>
              ))}
            </ul>
            <a class="link-arrow" href={tag ? url(`/photos/category/${categorySlug(tag)}/`) : url('/photos/')}>
              {tag ? `Every ${d.name} photo, from all ${eventAlbums.length} album${eventAlbums.length === 1 ? '' : 's'} →` : 'All photo albums →'}
            </a>
          </div>
        )}
        {news.length > 0 && (
          <div class="stack">
            <h3 class="past__sub" id="news-title">News</h3>
            <ul class="related" role="list">
              {news.map((n) => (
                <li>
                  <time datetime={n.data.date.toISOString().slice(0, 10)}>{formatDate(n.data.date)}</time>
                  <a href={url(`/news/${n.id}/`)}>{n.data.title}</a>
                </li>
              ))}
            </ul>
          </div>
        )}
      </section></Band>
    )
  }
  {
    showCta() && (
      <div class="sticky-cta" data-sticky-cta hidden>
        <span class="sticky-cta__name">{d.name}</span>
        <a class="btn btn--yellow sticky-cta__btn" href={ctaHref} tabindex="-1">
          {d.ctaLabel}
          {d.price && ` · ${d.price}`}
        </a>
      </div>
    )
  }
</BaseLayout>

<script>
  // Phones: once the header's main button has scrolled away, keep it handy in a bar at the bottom of the
  // screen; hide it again near the footer. (Tab skips the copy; the header button is the one in the order.)
  const bar = document.querySelector<HTMLElement>('[data-sticky-cta]');
  const headerCta = document.querySelector<HTMLElement>('[data-header-cta]');
  const footer = document.querySelector('footer');
  if (bar && headerCta && footer && 'IntersectionObserver' in window) {
    let ctaVisible = true;
    let footerVisible = false;
    const update = () => bar.classList.toggle('is-shown', !ctaVisible && !footerVisible);
    bar.hidden = false;
    new IntersectionObserver(([e]) => ((ctaVisible = e.isIntersecting), update())).observe(headerCta);
    new IntersectionObserver(([e]) => ((footerVisible = e.isIntersecting), update())).observe(footer);
  }
</script>

<style>
  .sticky-cta {
    display: none;
  }
  @media (max-width: 600px) {
    .sticky-cta {
      position: fixed;
      left: 10px;
      right: 10px;
      bottom: calc(10px + env(safe-area-inset-bottom));
      z-index: 40;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 10px 10px 18px;
      border-radius: var(--radius-pill);
      background: var(--green-deep);
      color: var(--white);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
      transform: translateY(160%);
      transition: transform 0.25s ease;
    }
    .sticky-cta.is-shown {
      transform: none;
    }
    .sticky-cta__name {
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: 15px;
      line-height: 1.15;
      min-width: 0;
    }
    .sticky-cta__btn {
      flex-shrink: 0;
      min-height: 44px;
      padding: 0 18px;
      font-size: 15px;
    }
  }
  @media (max-width: 600px) and (prefers-reduced-motion: reduce) {
    .sticky-cta {
      transition: none;
    }
  }
  .ev-section {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .ev-section + .ev-section {
    padding-top: 0;
  }
  .ww {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr));
    gap: 12px;
  }
  .ww__item {
    background: var(--panel, var(--surface));
    border-radius: var(--radius-card);
    padding: 16px 20px;
  }
  .ww dt {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--muted);
  }
  .ww dd {
    margin: 4px 0 0;
    font-weight: 600;
    font-size: 18px;
    color: var(--text);
  }
  .cal {
    margin-top: 22px;
  }
  .cal__label {
    font-weight: 600;
    margin: 0 0 10px;
  }
  .cal__links {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .ww__note {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-strong);
    max-width: 68ch;
  }
  .ways {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
  .way {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 22px 22px 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: var(--white);
  }
  .way__title {
    font-size: 21px;
    line-height: 1.2;
  }
  .way__text {
    font-size: 16px;
    line-height: 1.55;
    color: var(--muted-strong);
    flex-grow: 1;
  }
  .way__btn {
    align-self: flex-start;
    margin-top: 4px;
  }
  .past {
    gap: 28px;
  }
  .past__sub {
    font-size: 22px;
  }
  .race-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    background: var(--green-deep);
    color: var(--white);
    border-radius: var(--radius-card);
    padding: 22px 26px;
    text-decoration: none;
  }
  .race-link:hover {
    color: var(--white);
  }
  .race-link__label {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    color: var(--yellow);
  }
  .race-link__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 24px;
    line-height: 1.15;
  }
  .race-link__meta {
    color: var(--on-dark-soft);
  }
  .back {
    color: var(--on-dark-soft);
    font-weight: 600;
    align-self: flex-start;
    padding-block: 10px;
    order: -1;
  }
  .back:hover {
    color: var(--white);
  }
  .facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    list-style: none;
    margin: 4px 0 0;
    padding: 0;
    font-size: 17px;
  }
  .facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .btn--md {
    min-height: 50px;
    padding: 0 24px;
    font-size: 17px;
    align-self: flex-start;
    margin-top: 6px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .related {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .related li {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 16px;
    padding-block: 12px;
    border-bottom: 1px solid var(--border);
  }
  .related time {
    color: var(--muted);
    font-size: 15px;
    min-width: 150px;
  }
  .related a {
    font-weight: 600;
  }
</style>
