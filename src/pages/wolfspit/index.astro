---
import { getWording } from '../../lib/wording';
const w = await getWording('wolfspit'); // Page wording form
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import WolfspitBand from '../../components/home/WolfspitBand.astro';
import { getWolfspitYears } from '../../lib/results';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
const years = await getWolfspitYears();
const latest = years[0];
// Every runner across all years, for the cross-year search: [year, pos, name, club, time]
// Years with no results on the site yet (2020 and 2021 were cancelled for Covid)
const NO_RACE = [2020, 2021];
const have = new Set(years.map((y) => y.year));
const first = years.at(-1)?.year ?? 2009;
const missing = latest ? Array.from({ length: latest.year - first + 1 }, (_, i) => first + i).filter((y) => !have.has(y) && !NO_RACE.includes(y)) : [];
const listYears = (ys: number[]) => (ys.length > 1 ? `${ys.slice(0, -1).join(', ')} and ${ys.at(-1)}` : String(ys[0]));
const everyone = years.flatMap((y) => y.rows.map((r) => [y.year, r.position, r.name, r.club, r.time]));
---

<BaseLayout title="Wolf's Pit Fell Race results" description={`The Wolf's Pit Fell Race: a 9 km fell race from Shatton, near Bamford. Results from ${years.length} years since ${first}, and a search across all years.`}>
  <PageHeader eyebrow="Fell race" title={w.text('title')} intro={site.wolfspitIntro}>
    <div class="actions">
      {site.wolfspitEntryUrl !== '#' && <a class="btn btn--yellow btn--md" href={url(site.wolfspitEntryUrl)}>Enter {latest ? latest.year + 1 : ''}</a>}
      <a class="btn btn--ghost-light btn--md" href="#wolfspit">Results</a>
    </div>
  </PageHeader>

  <!-- Results by year: tabs, podium and search (the band that used to be on the homepage) -->
  <WolfspitBand title="Results by year" intro="" maxYears={years.length} />
  <div class="container">
    {
      missing.length > 0 && (
        <div class="note older" set:html={w.html('missingNote', { years: listYears(missing) })} />
      )
    }
  </div>

  <section class="container page-section about">
    <p><a href={url('/events/wolfspit/')}>{w.text('aboutLink')}</a></p>
  </section>

  <section class="container page-section stack" id="all-years" aria-labelledby="search-title">
    <h2 class="subhead" id="search-title">{w.text('searchTitle')}</h2>
    <div class="form-field search">
      <label for="any-year">Runner name</label>
      <input id="any-year" type="search" placeholder="Start typing a name" autocomplete="off" data-any-year data-base={url('/wolfspit/')} />
    </div>
    <p class="hint" aria-live="polite" data-any-status>Search {everyone.length.toLocaleString('en-GB')} results from {years.length} years.</p>
    <ul class="any-results" role="list" data-any-results></ul>
  </section>

</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('[data-any-year]');
  const list = document.querySelector<HTMLElement>('[data-any-results]');
  const status = document.querySelector<HTMLElement>('[data-any-status]');
  if (input && list && status) {
    type Row = [number, number, string, string, string];
    // Same data as the results band above (every year), flattened: [year, pos, name, club, time]
    type Compact = [number, string, string, string, string];
    const w = window as unknown as { wolfspitResults?: Promise<Record<string, Compact[]>> };
    w.wolfspitResults ??= fetch(document.querySelector<HTMLElement>('[data-results-url]')!.dataset.resultsUrl!).then((r) => r.json());
    let data: Row[] = [];
    w.wolfspitResults.then((byYear) => {
      data = Object.entries(byYear).flatMap(([y, rows]) => rows.map((r): Row => [Number(y), r[0], r[1], r[2], r[4]]));
      if (input.value.trim().length >= 2) input.dispatchEvent(new Event('input')); // someone typed before it arrived
    });
    const base = input.dataset.base!;
    const initial = status.textContent;
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    input.addEventListener('input', () => {
      const q = input.value.trim().toLowerCase();
      if (q.length < 2) {
        list.innerHTML = '';
        status.textContent = initial;
        return;
      }
      const hits = data.filter((r) => r[2].toLowerCase().includes(q)).sort((a, b) => b[0] - a[0] || a[1] - b[1]);
      status.textContent = hits.length ? `${hits.length} result${hits.length === 1 ? '' : 's'}${hits.length > 50 ? ' (showing the first 50)' : ''}` : 'No runners found with that name.';
      list.innerHTML = hits
        .slice(0, 50)
        .map(
          (r) =>
            `<li><a href="${base}${r[0]}/"><strong>${r[0]}</strong></a> · ${esc(r[2])}${r[3] ? ` <span class="club">(${esc(r[3])})</span>` : ''} · position ${r[1]} · ${esc(r[4])}</li>`,
        )
        .join('');
    });
  }
</script>

<style>
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 6px;
  }
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
  }
  .older {
    margin-top: 24px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .search {
    max-width: 420px;
  }
  .hint {
    font-size: 14px;
    color: var(--muted);
  }
  .any-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 15px;
  }
  .any-results :global(li) {
    padding: 8px 12px;
    background: var(--panel, var(--surface));
    border-radius: 10px;
  }
  .any-results :global(.club) {
    color: var(--muted);
  }
</style>
