---
import { categoryClasses } from '../../lib/categories';
const cat = await categoryClasses(); // category colours for labels
import { getWording } from '../../lib/wording';
const w = await getWording('news'); // Page wording form
import { url, small } from '../../lib/url';
import Img from '../../components/Img.astro';
// News: search, the latest stories as cards, then the archive folded by year.
// Picking a topic switches to "results" mode: one list of every matching story, newest first, with year
// dividers, a summary line and links to that topic's photos and event; the Facebook row and the folded
// archive hide. The topic goes in the address (/news/?topic=bonfire) so it can be shared and Back works.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Band from '../../components/Band.astro';
import NewsTile from '../../components/NewsTile.astro';
import FacebookPosts from '../../components/FacebookPosts.astro';
import { categoryNames } from '../../lib/categories';
import { formatDate } from '../../lib/format';
import { storyPhotos } from '../../lib/photos';
import { categorySlug, getAlbums } from '../../lib/albums';
import { getEvents } from '../../lib/events';

// The newest three stay open; everything else sits in its year below
const LATEST = 3;
const news = (await getCollection('news', (n) => !n.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const latest = news.slice(0, LATEST);
const archive = news.slice(LATEST);
// Latest stories without their own photo borrow a dated archive photo from the same kind of event
const latestPhotos = await storyPhotos(latest);
// Topic buttons in the Categories order; any story category missing from that list goes last
const listed = await categoryNames();
const tags = [...listed, ...new Set(news.map((n) => n.data.tag).filter((t) => !listed.includes(t)))].filter((t) => news.some((n) => n.data.tag === t));
const byYear = new Map<number, typeof news>();
for (const n of archive) {
  const y = n.data.date.getFullYear();
  if (!byYear.has(y)) byYear.set(y, []);
  byYear.get(y)!.push(n);
}
const href = (id: string) => url(`/news/${id}/`);
// For results mode: each topic's address slug, and links to its photos and event (if any)
const albums = await getAlbums();
const events = await getEvents();
const topics = Object.fromEntries(
  tags.map((t) => {
    const event = events.find((e) => e.data.category === t && e.data.runByUs) ?? events.find((e) => e.data.category === t);
    const hasPhotos = albums.some((a) => a.data.category === t && a.data.photos.length > 0);
    return [
      t,
      {
        slug: categorySlug(t),
        photos: hasPhotos ? { label: `${t} photos`, url: url(`/photos/category/${categorySlug(t)}/`) } : null,
        event: event ? { label: event.data.name, url: url(`/events/${event.id}/`) } : null,
      },
    ];
  }),
);
---

<BaseLayout title={w.text('eyebrow')} description={w.text('description', { count: news.length })}>
  <PageHeader eyebrow={w.text('eyebrow')} title={w.text('title')} intro={w.text('intro', { count: news.length })}>
    <form class="news-search" action={url('/search/')} method="get" role="search">
      <label for="news-q" class="news-search__label">Search the news and photos</label>
      <div class="news-search__row">
        <input id="news-q" name="q" type="search" placeholder="e.g. duck race 2008" autocomplete="off" />
        <button type="submit" class="btn btn--yellow btn--md">Search</button>
      </div>
    </form>
  </PageHeader>

  <Band first><section class="container page-section news-page">
    <div class="filters">
      <p class="filters__label" id="tag-filter-label">Show:</p>
      <ul class="chips chips--scroll" role="list" aria-labelledby="tag-filter-label" data-filters data-topics={JSON.stringify(topics)}>
        <li><button type="button" class="chip" aria-pressed="true" data-tag="">All</button></li>
        {tags.map((t) => <li><button type="button" class:list={['chip', cat(t)]} aria-pressed="false" data-tag={t}>{t}</button></li>)}
      </ul>
      <p class="visually-hidden" aria-live="polite" data-filter-status></p>
    </div>

    <!-- Results mode (filled in by the script below when a topic is picked) -->
    <section class="results" aria-labelledby="results-title" data-results hidden>
      <div class="results__head">
        <h2 class="subhead" id="results-title" data-results-title></h2>
        <p class="results__count" data-results-count></p>
      </div>
      <p class="results__links" data-results-links></p>
      <div data-results-list></div>
    </section>
    <template data-pagefind-ignore data-results-tpl><h3 class="results__year"></h3><ul class="year__list" role="list"></ul><a class="link-arrow results__link"></a></template>
    <template data-pagefind-ignore data-latest-rows>
      {latest.map((n) => (
        <li class="row" data-row data-tag={n.data.tag} data-year={n.data.date.getFullYear()}>
          {n.data.image ? (
            <img class="row__thumb" src={small(n.data.image)} alt="" loading="lazy" decoding="async" width="72" height="72" />
          ) : (
            <div class="row__thumb">
              <NewsTile tag={n.data.tag} facebook={Boolean(n.data.facebookId)} />
            </div>
          )}
          <div class="row__body">
            <p class="meta">
              <span class:list={['tag', cat(n.data.tag)]}>{n.data.tag}</span>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{formatDate(n.data.date)}</time>
            </p>
            <h3 class="row__title">
              <a href={href(n.id)}>{n.data.title}</a>
            </h3>
          </div>
        </li>
      ))}
    </template>

    <section aria-labelledby="latest-title" data-group data-normal>
      <h2 class="subhead" id="latest-title">{w.text('latestTitle')}</h2>
      <ul class="latest" role="list">
        {
          latest.map((n, i) => (
            <li class="card" data-row data-tag={n.data.tag}>
              {latestPhotos[i] ? (
                <a class="card__media" href={href(n.id)} tabindex="-1" aria-hidden="true">
                  <Img kind="grid" src={latestPhotos[i]!.src} sizes="(max-width: 600px) 100vw, 400px" alt="" loading="lazy" decoding="async" width="480" height="300" />
                  {latestPhotos[i]!.label && <span class="card__chip">{latestPhotos[i]!.own ? latestPhotos[i]!.label : `Archive photo · ${latestPhotos[i]!.label}`}</span>}
                </a>
              ) : (
                <div class="card__strip">
                  <NewsTile tag={n.data.tag} facebook={Boolean(n.data.facebookId)} />
                </div>
              )}
              <div class="card__body">
                <p class="meta">
                  <span class:list={['tag', cat(n.data.tag)]}>{n.data.tag}</span>
                  <time datetime={n.data.date.toISOString().slice(0, 10)}>Posted {formatDate(n.data.date)}</time>
                </p>
                <h3 class="card__title">
                  <a href={href(n.id)}>{n.data.title}</a>
                </h3>
                <p class="card__summary">{n.data.summary}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>
    <div data-normal><FacebookPosts /></div>
  </section></Band>

  <Band tone="mist" class="archive-band"><section class="container page-section news-page">

    <section class="archive" aria-labelledby="archive-title" data-group>
      <h2 class="subhead" id="archive-title">{w.text('archiveTitle')}</h2>
      <p class="archive__intro">{w.text('archiveIntro')}</p>
      {
        [...byYear.entries()].map(([year, items]) => (
          <details class="year" data-year>
            <summary class="year__summary">
              <span class="year__name">{year}</span>
              <span class="year__count">
                {items.length} {items.length === 1 ? 'story' : 'stories'}
              </span>
            </summary>
            <ul class="year__list" role="list">
              {items.map((n) => (
                <li class="row" data-row data-tag={n.data.tag} data-year={year}>
                  {n.data.image ? (
                    <img class="row__thumb" src={small(n.data.image)} alt="" loading="lazy" decoding="async" width="72" height="72" />
                  ) : (
                    <div class="row__thumb">
                      <NewsTile tag={n.data.tag} facebook={Boolean(n.data.facebookId)} />
                    </div>
                  )}
                  <div class="row__body">
                    <p class="meta">
                      <span class:list={['tag', cat(n.data.tag)]}>{n.data.tag}</span>
                      <time datetime={n.data.date.toISOString().slice(0, 10)}>{formatDate(n.data.date)}</time>
                    </p>
                    <h3 class="row__title">
                      <a href={href(n.id)}>{n.data.title}</a>
                    </h3>
                  </div>
                </li>
              ))}
            </ul>
          </details>
        ))
      }
    </section>
  </section></Band>
</BaseLayout>

<script>
  // Topic buttons. "All" = the normal page. A topic = results mode: every matching story (latest and
  // archive) in one list, newest first, with year dividers, a summary and links to its photos/event.
  type Link = { label: string; url: string };
  type Topic = { slug: string; photos: Link | null; event: Link | null };
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const status = document.querySelector('[data-filter-status]');
  const results = document.querySelector<HTMLElement>('[data-results]');
  if (filters && results) {
    const topics: Record<string, Topic> = JSON.parse(filters.dataset.topics ?? '{}');
    const buttons = [...filters.querySelectorAll<HTMLButtonElement>('button[data-tag]')];
    const tpl = document.querySelector<HTMLTemplateElement>('[data-results-tpl]')!.content;
    const latestRows = [...document.querySelector<HTMLTemplateElement>('[data-latest-rows]')!.content.querySelectorAll<HTMLElement>('[data-row]')];
    const archiveRows = [...document.querySelectorAll<HTMLElement>('.archive [data-row]')];
    const allRows = [...latestRows, ...archiveRows]; // already newest first
    const title = results.querySelector('[data-results-title]')!;
    const count = results.querySelector('[data-results-count]')!;
    const links = results.querySelector<HTMLElement>('[data-results-links]')!;
    const list = results.querySelector('[data-results-list]')!;
    const tagForSlug = (slug: string | null) => Object.keys(topics).find((t) => topics[t].slug === slug) ?? '';
    const stories = (n: number) => `${n} ${n === 1 ? 'story' : 'stories'}`;

    const apply = (tag: string) => {
      buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.tag ?? '') === tag)));
      const on = Boolean(tag);
      document.documentElement.toggleAttribute('data-news-topic', on);
      results.hidden = !on;
      document.querySelectorAll<HTMLElement>('[data-normal]').forEach((el) => (el.hidden = on));
      list.replaceChildren();
      links.replaceChildren();
      if (!on) {
        if (status) status.textContent = 'All stories shown';
        return;
      }
      const matches = allRows.filter((r) => r.dataset.tag === tag);
      let ul: HTMLElement | null = null;
      let year = '';
      for (const r of matches) {
        if (r.dataset.year !== year) {
          year = r.dataset.year ?? '';
          const h = tpl.querySelector('.results__year')!.cloneNode(false) as HTMLElement;
          h.textContent = year;
          ul = tpl.querySelector('.year__list')!.cloneNode(false) as HTMLElement;
          list.append(h, ul);
        }
        ul!.append(r.cloneNode(true));
      }
      title.textContent = tag;
      count.textContent = `${stories(matches.length)}, newest first`;
      const t = topics[tag];
      for (const l of [t?.photos, t?.event]) {
        if (!l) continue;
        const a = tpl.querySelector('.results__link')!.cloneNode(false) as HTMLAnchorElement;
        a.href = l.url;
        a.textContent = `${l.label} →`;
        links.append(a);
      }
      links.hidden = !links.childElementCount;
      if (status) status.textContent = `${stories(matches.length)} about ${tag}, newest first`;
    };

    const setUrl = (tag: string, push: boolean) => {
      const u = new URL(location.href);
      if (tag) u.searchParams.set('topic', topics[tag]?.slug ?? tag);
      else u.searchParams.delete('topic');
      if (u.href !== location.href) history[push ? 'pushState' : 'replaceState'](null, '', u);
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const tag = b.dataset.tag ?? '';
        apply(tag);
        setUrl(tag, true);
      }),
    );
    window.addEventListener('popstate', () => apply(tagForSlug(new URLSearchParams(location.search).get('topic'))));
    // Arriving with ?topic=… (a shared link, an event page link, or Back)
    const start = tagForSlug(new URLSearchParams(location.search).get('topic'));
    if (start) apply(start);
  }
</script>

<style>
  .news-search {
    margin-top: 8px;
    max-width: 560px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .news-search__label {
    font-weight: 600;
    color: var(--on-dark-soft);
  }
  .news-search__row {
    display: flex;
    gap: 8px;
  }
  .news-search input {
    flex: 1;
    min-width: 0;
    min-height: 48px;
    border: 0;
    border-radius: var(--radius-pill);
    padding: 0 18px;
    font: inherit;
    font-size: 16px;
  }
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
  }
  .news-page {
    display: flex;
    flex-direction: column;
    gap: 36px;
  }
  .news-page > section {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 14px;
  }
  .filters__label {
    font-weight: 600;
    color: var(--muted);
  }
  .filters .chips {
    min-width: 0;
    max-width: 100%;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 10px;
    font-size: 14px;
    color: var(--muted);
  }
  .latest {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr));
    gap: 18px;
  }
  .card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    background: var(--white);
  }
  .card__media {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface-green);
  }
  .card__media {
    position: relative;
  }
  .card__chip {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(16, 36, 26, 0.85);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Stories without a photo get a short coloured strip rather than a big empty tile */
  .card__strip {
    height: 64px;
  }
  .card__strip :global(.news-tile > svg) {
    width: 40px !important;
    height: 40px !important;
  }
  .card__body {
    padding: 18px 20px 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card__title {
    font-size: 21px;
    line-height: 1.2;
  }
  .card__title a,
  .row__title a {
    color: var(--text);
    text-decoration: none;
  }
  .card__title a:hover,
  .row__title a:hover {
    text-decoration: underline;
  }
  .card__summary {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted-strong);
  }
  .archive__intro {
    color: var(--muted);
  }
  /* Results mode (a topic is picked): one panel with every matching story; the folded archive hides */
  :global(html[data-news-topic] .archive-band) {
    display: none;
  }
  .results {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .results__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 4px 14px;
  }
  .results__count {
    color: var(--muted);
    font-size: 16px;
  }
  .results__links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 22px;
  }
  .results [data-results-list] {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--white);
    padding: 6px 0 4px;
  }
  .results__year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
    color: var(--green);
    padding: 14px 20px 2px;
  }
  .year {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--white);
  }
  .year__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    min-height: 56px;
    padding: 8px 20px;
    cursor: pointer;
    list-style: none;
  }
  .year__summary::-webkit-details-marker {
    display: none;
  }
  .year__summary::after {
    content: '+';
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 24px;
    color: var(--green);
  }
  .year[open] > .year__summary::after {
    content: '–';
  }
  .year__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    color: var(--green);
  }
  .year__count {
    margin-left: auto;
    color: var(--muted);
    font-size: 15px;
  }
  .year__list {
    list-style: none;
    margin: 0;
    padding: 0 20px 8px;
  }
  .row {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding-block: 14px;
    border-top: 1px solid var(--border-soft);
  }
  .row__thumb {
    width: 72px;
    height: 72px;
    border-radius: var(--radius-sm);
    object-fit: cover;
    flex-shrink: 0;
    overflow: hidden;
    background: var(--surface-green);
  }
  .row__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .row__title {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 17px;
    line-height: 1.3;
  }
  .row__title a {
    display: inline-block;
    padding-block: 2px;
  }
  @media (max-width: 600px) {
    .filters {
      flex-direction: column;
      align-items: stretch;
    }
    .news-search__row {
      flex-direction: column;
    }
  }
  /* Phones: the newest story stays a big card; the rest become compact rows with a small photo */
  @media (max-width: 600px) {
    .latest {
      gap: 12px;
    }
    .latest > .card:not(:first-child) {
      flex-direction: row;
      align-items: stretch;
    }
    .latest > .card:not(:first-child) .card__media {
      flex: 0 0 104px;
      aspect-ratio: auto;
      min-height: 104px;
    }
    .latest > .card:not(:first-child) .card__chip {
      display: none; /* too small to label here; the photo's date shows on the story page */
    }
    .latest > .card:not(:first-child) .card__strip {
      flex: 0 0 72px;
      height: auto;
    }
    .latest > .card:not(:first-child) .card__body {
      padding: 12px 14px;
      gap: 4px;
      min-width: 0;
    }
    .latest > .card:not(:first-child) .card__title {
      font-size: 17px;
    }
    .latest > .card:not(:first-child) .card__summary {
      font-size: 14px;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .latest > .card:not(:first-child) .meta {
      font-size: 12.5px;
      gap: 6px;
    }
  }
</style>
