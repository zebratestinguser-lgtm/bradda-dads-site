---
import { url } from '../../lib/url';
import Img from '../../components/Img.astro';
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BrookEdge from '../../components/BrookEdge.astro';
import Band from '../../components/Band.astro';
import ComingUp from '../../components/ComingUp.astro';
import PhotoGrid from '../../components/PhotoGrid.astro';
import Lightbox from '../../components/Lightbox.astro';
import { storyPhoto, storyPhotos } from '../../lib/photos';
import { photoDate } from '../../lib/albums';
import { formatDate, formatShortDate } from '../../lib/format';

export async function getStaticPaths() {
  const news = (await getCollection('news', (n) => !n.data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
  return news.map((story, i) => ({ params: { id: story.id }, props: { story, newer: news[i - 1], older: news[i + 1], all: news } }));
}

const { story, newer, older, all } = Astro.props;
const { Content } = await render(story);
const album = story.data.album ? await getEntry(story.data.album) : undefined;
const preview = album ? album.data.photos.slice(0, 8) : [];
// Facebook stories: their photos are dated by the post
const when = album ? photoDate(album) : story.data.facebookId ? `posted on Facebook ${formatDate(story.data.date)}` : undefined;
const gallery = story.data.photos;
// Header photo: the story's own, or a dated archive photo from the same kind of event
const header = await storyPhoto(story);
// "More about …": the three stories on the same topic closest in date
const related = all
  .filter((n) => n.id !== story.id && n.data.tag === story.data.tag)
  .sort((a, b) => Math.abs(a.data.date.getTime() - story.data.date.getTime()) - Math.abs(b.data.date.getTime() - story.data.date.getTime()))
  .slice(0, 3)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const relatedPhotos = await storyPhotos(related);
const TOPIC: Record<string, string> = {
  Bonfire: 'More about the bonfire',
  'Christmas card': 'More about the Christmas card',
  "Pensioners' lunch": "More about the pensioners' lunch",
  'Duck race': 'More about the duck race',
  "Wolf's Pit": "More about Wolf's Pit",
  Village: 'More village news',
  Carnival: 'More about the carnival',
  'Tour of Bradwell': 'More about the Tour of Bradwell',
  Social: 'More get-togethers',
};
const relatedHeading = TOPIC[story.data.tag] ?? 'More stories';
---

<BaseLayout title={story.data.title} description={story.data.summary} ogImage={header?.own ? header.src : undefined} ogImageAlt={header?.own ? header.alt : undefined} ogType="article" publishedTime={story.data.date}>
  <article class="story">
    <header class:list={['story__header', { 'story__header--photo': header }]}>
      {
        header && (
          <div class="story__header-photo" aria-hidden="true">
            <Img kind="large" src={header.src} sizes="100vw" alt="" decoding="async" fetchpriority="high" />
          </div>
        )
      }
      {header?.label && <p class="story__header-chip">{header.own ? 'Photo' : 'Archive photo'}: {header.label}</p>}
      <div class="container story__header-inner">
        <a class="story__back" href={url('/news/')}>← All news</a>
        <p class="story__meta">
          <span class="tag">{story.data.tag}</span>
          <time datetime={story.data.date.toISOString().slice(0, 10)}>Posted {formatDate(story.data.date)}</time>
        </p>
        <h1 class="story__title">{story.data.title}</h1>
      </div>
      <BrookEdge seed="story" />
    </header>

    <div class="container story__body">
      {
        story.data.image && (
          <figure class="story__figure">
            <Img kind="large" src={story.data.image} sizes="(max-width: 800px) 100vw, 760px" alt={story.data.imageAlt ?? ''} decoding="async" />
            {when && <figcaption>{album ? `Photo taken ${when}` : `Photo ${when}`}</figcaption>}
          </figure>
        )
      }
      <div class="prose"><Content /></div>

      {
        gallery.length > 0 && (
          <section class="story__gallery" aria-label="More photos">
            <PhotoGrid photos={gallery} title={story.data.title} when={when ? `Photo ${when}` : ''} />
          </section>
        )
      }

      {
        album && preview.length > 0 && (
          <section class="story__album" aria-labelledby="album-title">
            <div class="story__album-head">
              <h2 class="subhead" id="album-title">Photos</h2>
              <p>
                {album.data.photos.length} photo{album.data.photos.length === 1 ? '' : 's'} taken <strong>{when}</strong>
              </p>
            </div>
            <ul class="story__thumbs" role="list">
              {preview.map((p, i) => (
                <li>
                  <a href={url(`/photos/${album.id}/`)} aria-label={i === 0 ? `See all photos from ${album.data.title}` : undefined} tabindex={i === 0 ? undefined : -1}>
                    <Img kind="grid" src={p.src} sizes="(max-width: 600px) 50vw, 320px" alt={p.alt} loading="lazy" decoding="async" />
                  </a>
                </li>
              ))}
            </ul>
            <a class="btn btn--green btn--md" href={url(`/photos/${album.id}/`)}>
              See all {album.data.photos.length} photos
            </a>
          </section>
        )
      }

      <ComingUp topic={story.data.tag} />

      <nav class="story__nav" aria-label="More stories">
        {newer ? <a href={url(`/news/${newer.id}/`)}>← Newer: {newer.data.title}</a> : <span />}
        {older && <a href={url(`/news/${older.id}/`)}>Older: {older.data.title} →</a>}
      </nav>
    </div>
  </article>

  {
    related.length > 0 && (
      <Band tone="mist">
        <section class="container page-section related" aria-labelledby="related-title">
          <div class="related__head">
            <h2 class="subhead" id="related-title">{relatedHeading}</h2>
            <a class="link-arrow" href={url('/news/')}>All news →</a>
          </div>
          <ul class="related__list" role="list">
            {related.map((n, i) => (
              <li class="rcard">
                {relatedPhotos[i] && (
                  <div class="rcard__media" aria-hidden="true">
                    <Img kind="grid" src={relatedPhotos[i]!.src} sizes="(max-width: 600px) 100vw, 400px" alt="" loading="lazy" decoding="async" />
                    {relatedPhotos[i]!.label && <span class="rcard__chip">{relatedPhotos[i]!.own ? relatedPhotos[i]!.label : `Archive photo · ${relatedPhotos[i]!.label}`}</span>}
                  </div>
                )}
                <div class="rcard__body">
                  <time datetime={n.data.date.toISOString().slice(0, 10)}>{formatShortDate(n.data.date)} {n.data.date.getFullYear()}</time>
                  <h3 class="rcard__title">
                    <a href={url(`/news/${n.id}/`)}>{n.data.title}</a>
                  </h3>
                </div>
              </li>
            ))}
          </ul>
        </section>
      </Band>
    )
  }
  {gallery.length > 0 && <Lightbox />}
</BaseLayout>

<style>
  .story__header {
    position: relative;
    background: var(--green);
    color: var(--white);
    padding-block: 28px 64px;
  }
  .story__header--photo {
    overflow: hidden;
    padding-bottom: 88px;
  }
  .story__header-photo {
    position: absolute;
    inset: 0 0 0 auto;
    width: 58%;
  }
  .story__header-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .story__header-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--green) 0%, rgba(29, 59, 44, 0.78) 40%, rgba(29, 59, 44, 0.2) 100%);
  }
  .story__header-chip {
    position: absolute;
    right: var(--gutter);
    bottom: 50px;
    z-index: 2;
    background: rgba(16, 36, 26, 0.85);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  @media (max-width: 800px) {
    .story__header-photo {
      width: 100%;
    }
    .story__header-photo::after {
      background: rgba(29, 59, 44, 0.86);
    }
    .story__header-chip {
      bottom: 36px;
    }
  }
  .story__header-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    gap: 14px;
    max-width: calc(68ch + 2 * var(--gutter) + 120px);
  }
  .story__back {
    color: var(--on-dark-soft);
    font-weight: 600;
    align-self: flex-start;
    padding-block: 10px;
  }
  .story__back:hover {
    color: var(--white);
  }
  .story__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    color: var(--on-dark-soft);
  }
  .story__title {
    font-weight: 800;
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.05;
    letter-spacing: -1px;
  }
  .story__body {
    padding-block: 40px var(--section-pad);
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-width: calc(68ch + 2 * var(--gutter) + 120px);
  }
  .story__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .story__figure img {
    width: 100%;
    max-height: 520px;
    object-fit: cover;
    border-radius: var(--radius-card);
    background: var(--surface-green);
  }
  .story__figure figcaption {
    font-size: 14px;
    color: var(--muted);
  }
  .story__gallery {
    margin-top: 28px;
  }
  .story__album {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding-top: 8px;
  }
  .story__album-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .story__album-head p {
    color: var(--muted);
  }
  .story__thumbs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(140px, 30%), 1fr));
    gap: 8px;
  }
  .story__thumbs a {
    display: block;
    aspect-ratio: 4 / 3;
    border-radius: 12px;
    overflow: hidden;
    background: var(--surface-green);
  }
  .story__thumbs img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .btn--md {
    min-height: 48px;
    padding: 0 22px;
    font-size: 16px;
    align-self: flex-start;
  }
  .story__nav {
    padding-top: 24px;
    border-top: 1px solid var(--border);
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 24px;
    font-weight: 600;
  }
  .story__nav a {
    padding-block: 10px;
    max-width: 48ch;
  }
  .related {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .related__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
  }
  .related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 100%), 1fr));
    gap: 18px;
  }
  .rcard {
    position: relative;
    background: var(--white);
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .rcard__media {
    position: relative;
    aspect-ratio: 16 / 10;
    background: var(--surface-green);
  }
  .rcard__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .rcard__chip {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(16, 36, 26, 0.85);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
  }
  .rcard__body {
    padding: 16px 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .rcard__body time {
    font-size: 14px;
    color: var(--muted);
  }
  .rcard__title {
    font-size: 19px;
    line-height: 1.25;
  }
  /* The whole card is clickable via the title link */
  .rcard__title a {
    color: var(--text);
    text-decoration: none;
  }
  .rcard__title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .rcard:hover .rcard__title a {
    text-decoration: underline;
  }
</style>
