---
// Footer: name and tagline, then one line of links that aren't in the header menu.
import DuckLogo from './DuckLogo.astro';
import BrookEdge from './BrookEdge.astro';
import { getSite } from '../lib/site';
import { isPlaceholder } from '../lib/events';
import { url } from '../lib/url';

const site = await getSite();
const hasAccounts = Boolean(site.accountsUrl) && site.accountsUrl !== '#' && !isPlaceholder(site.accountsUrl);
const links = [
  { label: 'Contact us', href: url('/contact/') },
  { label: 'Facebook', href: site.facebookUrl },
  { label: 'Privacy', href: url('/privacy/') },
  { label: 'Accessibility', href: url('/accessibility/') },
  { label: 'Play Duck Dash', href: url('/game/') },
  ...(hasAccounts ? [{ label: 'Annual accounts', href: url(site.accountsUrl) }] : []),
];
---

<footer class="site-footer">
  <BrookEdge position="rise" fill="var(--green-deep)" seed="footer" />
  <div class="container site-footer__inner">
    <div class="site-footer__about">
      <a class="site-footer__brand" href={url('/')}>
        <DuckLogo size={36} />
        <span>{site.name}</span>
      </a>
      <p>{site.tagline}</p>
      {
        !isPlaceholder(site.cicName) && (
          <p class="site-footer__cic">
            {site.cicName}
            {!isPlaceholder(site.cicNumber) && (
              <>
                {' · '}
                <a href={`https://find-and-update.company-information.service.gov.uk/company/${site.cicNumber}`} rel="noopener">
                  Company no. {site.cicNumber}
                </a>
              </>
            )}
          </p>
        )
      }
    </div>
    <nav aria-label="Contact and information">
      <ul class="site-footer__links" role="list">
        {
          links.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    position: relative;
    background: var(--green-deep);
    color: var(--on-dark-muted);
    padding-block: 40px 36px;
    font-size: 15px;
    line-height: 1.6;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .site-footer__about {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    color: var(--white);
    text-decoration: none;
    align-self: flex-start;
  }
  .site-footer__brand:hover {
    color: var(--white);
  }
  .site-footer__cic {
    font-size: 14px;
  }
  .site-footer__cic a {
    color: inherit;
  }
  .site-footer__links {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 28px;
  }
  .site-footer__links a {
    color: var(--white);
    text-decoration: none;
    font-weight: 600;
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  .site-footer__links a:hover {
    color: var(--yellow);
    text-decoration: underline;
  }
</style>
