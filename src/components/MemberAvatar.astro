---
// Member photo, or a duck in a circle until a photo is added.
import DuckLogo from './DuckLogo.astro';
import type { Member } from '../lib/members';
import { thumb, url } from '../lib/url';

interface Props {
  member: Member;
  size?: number;
  full?: boolean;
}
const { member, size = 120, full = false } = Astro.props;
const { photo, photoAlt } = member.data;
---

<div class="avatar" style={`--size:${size}px`}>
  {
    photo ? (
      <img src={full ? url(photo) : thumb(photo)} alt={photoAlt ?? ''} width={size} height={size} loading="lazy" decoding="async" />
    ) : (
      <span class="avatar__duck" aria-hidden="true">
        <DuckLogo size={Math.round(size * 0.6)} />
      </span>
    )
  }
</div>

<style>
  .avatar {
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    background: var(--yellow-panel);
    box-shadow: 0 0 0 4px var(--white), 0 0 0 6px var(--yellow);
  }
  .avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar__duck {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }
</style>
