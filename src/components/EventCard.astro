---
// One event card (homepage "year" strip and the Events page).
import { getCollection } from 'astro:content';
import { statusFor, deadlineFor, shortDay, formatEventDates, type EventEntry } from '../lib/events';
import { categorySlug } from '../lib/albums';
import { url } from '../lib/url';

interface Props {
  event: EventEntry;
  isNext?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { event: e, isNext = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const tag = statusFor(e, isNext);
const detailsHref = url(`/events/${e.id}/`);
const ctaHref = url(e.data.ctaUrl);
// Closed for this year (entries closed, or the event's done): the card looks "closed", and a sign-up
// button for something that's closed (e.g. "Add your message") is hidden; "See the photos" etc. stay
const closed = tag.kind === 'done';
const now = new Date();
const dl = deadlineFor(e, now);
// The event's own date, always shown big: "Friday 4 December" when this year's date is known and still
// to come, otherwise the usual label ("November", "26 December")
const upcomingDate = e.data.start && (e.data.end ?? e.data.start) >= new Date(now.getTime() - 864e5) ? formatEventDates(e) : undefined;
const dateText = upcomingDate ?? e.data.when;
// A sign-up button (status "open") hides once its deadline has gone
let showCta = !(dl?.passed || (e.data.status === 'open' && closed));
let cta = { label: e.data.ctaLabel, href: ctaHref };
// Finished for this year: point at the newest story about it (written in the last 3 months), or its photos
if (closed && e.data.status !== 'open') {
  const topic = e.data.category;
  const recent = topic
    ? (await getCollection('news', (n) => !n.data.draft))
        .filter((n) => n.data.tag === topic && now.getTime() - n.data.date.getTime() < 92 * 864e5)
        .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0]
    : undefined;
  if (recent) cta = { label: 'Read the round-up', href: url(`/news/${recent.id}/`) };
  else if (topic) cta = { label: 'See the photos', href: url(`/photos/category/${categorySlug(topic)}/`) };
  showCta = true;
}
---

<article class:list={['event-card', { 'event-card--next': isNext, 'event-card--closed': closed }]}>
  <div class="event-card__top">
    {isNext && tag.label !== 'Next up' && <span class="event-card__tag event-card__tag--nextup">Next up</span>}
    <span class={`event-card__tag event-card__tag--${tag.kind}`}>
      {(tag.kind === 'open' || tag.kind === 'now') && <span class="event-card__dot" aria-hidden="true" />}
      {(tag.kind === 'closed' || (tag.kind === 'done' && e.data.status === 'open')) && <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" /></svg>}
      {tag.kind === 'done' && e.data.status !== 'open' && <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" /></svg>}
      {tag.label}
    </span>
  </div>
  <p class="event-card__date">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"></rect><path d="M16 3v4M8 3v4M3 10h18"></path></svg>
    <span>{dateText}</span>
  </p>
  {
    dl && !closed && !(dl.passed && tag.label === dl.closedText) && (
      <p class:list={['event-card__deadline', { 'is-passed': dl.passed }]}>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>
        {dl.passed ? dl.closedText : <>{dl.label} <strong>{shortDay(dl.date)}</strong></>}
      </p>
    )
  }
  <Heading class="event-card__name">
    <a href={detailsHref}>{e.data.name}</a>
  </Heading>
  <p class="event-card__summary">{e.data.summary}</p>
  <div class="event-card__links">
    {
      showCta && (
        <a class="event-card__cta" href={cta.href}>
          {cta.label} <span aria-hidden="true">→</span>
          <span class="visually-hidden">: {e.data.name}</span>
        </a>
      )
    }
    {
      (cta.href !== detailsHref || !showCta) && (
        <a class="event-card__more" href={detailsHref}>
          More details<span class="visually-hidden"> about the {e.data.name}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .event-card {
    /* anchors the screen-reader-only text inside, so it can't escape a scrolling strip */
    position: relative;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--white);
    color: var(--text);
    height: 100%;
  }
  .event-card--next {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }
  /* Status pills at the top ("Next up" first on the green card), date underneath: same place on every card */
  /* Finished for this year: a quiet outline card (works on either band colour) */
  .event-card--closed {
    background: transparent;
    border: 1.5px dashed var(--brook);
  }
  .event-card--closed .event-card__name {
    color: var(--muted-strong);
  }
  .event-card__tag svg {
    flex-shrink: 0;
  }
  .event-card__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  /* The event's own date: always the most prominent fact on the card */
  .event-card__date {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: 19px;
    line-height: 1.2;
  }
  .event-card__date svg {
    flex-shrink: 0;
  }
  /* Deadline: "Book by Fri 27 Nov", a plain line with a clock (not a badge, so it isn't mistaken for the status) */
  .event-card__deadline {
    margin: -6px 0 0;
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 15px;
    color: var(--muted-strong);
  }
  .event-card__deadline svg {
    flex-shrink: 0;
  }
  .event-card__deadline.is-passed {
    color: var(--muted);
  }
  .event-card--next .event-card__deadline {
    color: var(--on-dark-soft);
  }
  /* Status pills: one look per state, from the site palette (separate from the category colours) */
  .event-card__tag {
    font-size: 13px;
    font-weight: 600;
    padding: 5px 11px;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    white-space: nowrap;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .event-card__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: currentColor;
  }
  /* Open now / Booking open: duck yellow, like every "go ahead" button */
  .event-card__tag--open {
    background: var(--yellow);
    color: var(--text);
  }
  /* On now: orange */
  .event-card__tag--now {
    background: var(--focus);
    color: var(--white);
  }
  /* Coming up: plain outline */
  .event-card__tag--upcoming {
    background: var(--white);
    border-color: var(--green);
    color: var(--green);
  }
  /* Closed (sign-up over) and done for the year: stone grey, with a padlock or a tick */
  .event-card__tag--closed,
  .event-card__tag--done {
    background: var(--stone);
    border-color: var(--input-border);
    color: var(--stone-ink);
  }
  /* "Next up" on the green card */
  .event-card__tag--nextup {
    background: var(--white);
    color: var(--green);
  }
  .event-card--next .event-card__tag--upcoming {
    border-color: var(--white);
  }
  .event-card--next .event-card__tag--closed {
    background: rgba(255, 255, 255, 0.14);
    border-color: rgba(255, 255, 255, 0.5);
    color: var(--white);
  }
  .event-card__name {
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
  }
  .event-card__name a {
    color: inherit;
    text-decoration: none;
  }
  .event-card__name a:hover {
    text-decoration: underline;
  }
  .event-card__summary {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    flex-grow: 1;
  }
  .event-card--next .event-card__summary {
    color: var(--on-dark-soft);
  }
  .event-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
  }
  .event-card__cta,
  .event-card__more {
    font-size: 15px;
    color: inherit;
    padding: 10px 0;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .event-card__cta {
    font-weight: 600;
    gap: 0.3em; /* space before the arrow (flex collapses plain spaces) */
  }
  .event-card__more {
    font-weight: 600;
    opacity: 0.85;
  }
  .event-card__cta:hover,
  .event-card__more:hover {
    color: inherit;
    opacity: 1;
  }
</style>
