---
// One event card (homepage "year" strip and the Events page).
import { statusFor, type EventEntry } from '../lib/events';
import { url } from '../lib/url';

interface Props {
  event: EventEntry;
  isNext?: boolean;
  headingLevel?: 'h2' | 'h3';
}
const { event: e, isNext = false, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const tag = statusFor(e, isNext);
const detailsHref = url(`/events/${e.id}/`);
const ctaHref = url(e.data.ctaUrl);
---

<article class:list={['event-card', { 'event-card--next': isNext }]}>
  <div class="event-card__top">
    <span class={`event-card__tag event-card__tag--${tag.kind}`}>{tag.label}</span>
    <span class="event-card__when">{e.data.when}</span>
  </div>
  <Heading class="event-card__name">
    <a href={detailsHref}>{e.data.name}</a>
  </Heading>
  <p class="event-card__summary">{e.data.summary}</p>
  <div class="event-card__links">
    <a class="event-card__cta" href={ctaHref}>
      {e.data.ctaLabel} <span aria-hidden="true">→</span>
      <span class="visually-hidden">: {e.data.name}</span>
    </a>
    {
      ctaHref !== detailsHref && (
        <a class="event-card__more" href={detailsHref}>
          More details<span class="visually-hidden"> about the {e.data.name}</span>
        </a>
      )
    }
  </div>
</article>

<style>
  .event-card {
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    background: var(--white);
    color: var(--text);
    height: 100%;
  }
  .event-card--next {
    background: var(--green);
    border-color: var(--green);
    color: var(--white);
  }
  /* Status pill always on its own line at the top, date underneath: same place on every card, at every width */
  .event-card__top {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  .event-card__when {
    font-size: 13px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    white-space: nowrap;
  }
  .event-card__tag {
    font-size: 12px;
    font-weight: 600;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--border-soft);
    color: var(--muted-strong);
    white-space: nowrap;
  }
  .event-card__tag--open {
    background: var(--yellow-panel);
    color: var(--yellow-ink);
  }
  .event-card__tag--done {
    color: var(--muted);
  }
  .event-card__tag--next {
    background: var(--yellow);
    color: var(--text);
  }
  .event-card__name {
    font-weight: 700;
    font-size: 24px;
    line-height: 1.15;
  }
  .event-card__name a {
    color: inherit;
    text-decoration: none;
  }
  .event-card__name a:hover {
    text-decoration: underline;
  }
  .event-card__summary {
    font-size: 15px;
    line-height: 1.5;
    color: var(--muted);
    flex-grow: 1;
  }
  .event-card--next .event-card__summary {
    color: var(--on-dark-soft);
  }
  .event-card__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 18px;
  }
  .event-card__cta,
  .event-card__more {
    font-size: 15px;
    color: inherit;
    padding: 10px 0;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .event-card__cta {
    font-weight: 600;
    gap: 0.3em; /* space before the arrow (flex collapses plain spaces) */
  }
  .event-card__more {
    font-weight: 500;
    opacity: 0.85;
  }
  .event-card__cta:hover,
  .event-card__more:hover {
    color: inherit;
    opacity: 1;
  }
</style>
