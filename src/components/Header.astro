---
// Site header: stays pinned to the top while scrolling.
// Wide screens: every link visible. Phones/tablets: logo + a labelled "Menu" button that opens the links.
// Home, then four drop-downs (Events, News & photos, About us, Get involved) and Search; drop-downs are
// small lists on wide screens and accordions inside the phone menu.
// Without JavaScript the links simply show as a wrapped list (nothing is ever hidden).
import DuckLogo from './DuckLogo.astro';
import { getSite } from '../lib/site';
import { getEvents } from '../lib/events';
import { url } from '../lib/url';

const site = await getSite();
const current = Astro.url.pathname;
const home = url('/');
const events = await getEvents();

type Link = { label: string; href: string; also?: string[]; icon?: boolean };
type Item = Link & { children?: Link[]; cta?: boolean };
const nav: Item[] = [
  { label: 'Home', href: home },
  {
    label: 'Events',
    href: url('/events/'),
    also: [url('/christmas-card/'), url('/game/')],
    children: [
      { label: 'All events', href: url('/events/') },
      ...events.map((e) => ({ label: e.data.name, href: url(`/events/${e.id}/`) })),
      { label: 'Play Duck Dash (game)', href: url('/game/') },
    ],
  },
  {
    label: 'News & photos',
    href: url('/news/'),
    also: [url('/photos/'), url('/races/'), url('/wolfspit/'), url('/tour-of-bradwell/')],
    children: [
      { label: 'News', href: url('/news/') },
      { label: 'Photos', href: url('/photos/') },
      { label: 'Race results', href: url('/races/') },
    ],
  },
  {
    label: 'About us',
    href: url('/our-story/'),
    also: [url('/members/'), url('/where-the-money-goes/'), url('/supporters/')],
    children: [
      { label: 'Our story', href: url('/our-story/') },
      { label: 'Meet the dads', href: url('/members/') },
      { label: 'Where the money goes', href: url('/where-the-money-goes/') },
      { label: 'Our supporters', href: url('/supporters/') },
    ],
  },
  { label: 'Search', href: url('/search/'), icon: true },
  {
    label: 'Get involved',
    href: url('/get-involved/'),
    also: [url('/donate/'), url('/contact/')],
    cta: true,
    children: [
      { label: 'Volunteer and join', href: url('/get-involved/') },
      { label: 'Donate', href: url('/donate/') },
      { label: 'Contact us', href: url('/contact/') },
    ],
  },
];
// Home is only "current" on the homepage; other links match their whole section
const isCurrent = (item: Link) =>
  item.href === home ? current === home : [item.href, ...(item.also ?? [])].some((h) => current.startsWith(h));
---

<header class="site-header" data-header>
  <div class="container site-header__inner">
    <a href={home} class="brand">
      <DuckLogo size={40} />
      <span class="brand__name">{site.name}</span>
    </a>

    <button type="button" class="menu-btn" aria-expanded="false" aria-controls="site-nav" data-menu-btn hidden>
      <span class="menu-btn__icon" aria-hidden="true"><span></span><span></span><span></span></span>
      <span class="menu-btn__label" data-menu-label>Menu</span>
    </button>

    <nav id="site-nav" aria-label="Main" class="nav" data-nav>
      <ul class="nav__list" role="list">
        {
          nav.map((item, i) =>
            item.children ? (
              <li class:list={['nav__group', { 'nav__group--cta': item.cta }]} data-nav-group>
                <button type="button" class:list={['nav__link', 'nav__toggle', { 'is-current': isCurrent(item), nav__cta: item.cta }]} aria-expanded="false" aria-controls={`subnav-${i}`} data-toggle>
                  {item.label}
                  <svg class="nav__chev" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M6 9l6 6 6-6" />
                  </svg>
                </button>
                <ul id={`subnav-${i}`} class="subnav" role="list" data-subnav>
                  {item.children.map((c) => (
                    <li>
                      <a href={c.href} class="subnav__link" aria-current={current === c.href ? 'page' : undefined}>
                        {c.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </li>
            ) : (
            <li>
              <a href={item.href} class="nav__link" aria-current={isCurrent(item) ? 'page' : undefined}>
                {item.icon && (
                  <svg class="nav__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" />
                    <path d="M20 20l-3.5-3.5" />
                  </svg>
                )}
                {item.label}
              </a>
            </li>
            ),
          )
        }
      </ul>
    </nav>
  </div>
</header>

<!-- Speed: switch on the compact phone menu the moment the header arrives, rather than after the whole
     page has downloaded (on slow phones the full no-JavaScript menu used to flash up first). The script
     below then adds the opening and closing. Must stay tiny, plain and inline. -->
<script is:inline>
  (function () {
    var h = document.querySelector('[data-header]');
    var b = document.querySelector('[data-menu-btn]');
    if (!h || !b || !document.querySelector('[data-nav]')) return;
    h.classList.add('is-enhanced');
    b.hidden = false;
    document.querySelectorAll('[data-nav-group] [data-subnav]').forEach(function (l) {
      l.hidden = true;
    });
  })();
</script>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');
  if (header && btn && nav && label) {
    header.classList.add('is-enhanced'); // switch on the compact phone layout
    btn.hidden = false;
    const mq = window.matchMedia('(max-width: 1079px)');

    const setOpen = (open: boolean, focusFirst = false) => {
      btn.setAttribute('aria-expanded', String(open));
      header.classList.toggle('is-open', open);
      label.textContent = open ? 'Close' : 'Menu';
      if (open && focusFirst) nav.querySelector<HTMLElement>('a')?.focus();
    };
    btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true', true));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && header.classList.contains('is-open')) {
        setOpen(false);
        btn.focus();
      }
    });
    // Close when tapping a link (same-page anchors) or moving focus/clicks outside the header
    nav.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (header.classList.contains('is-open') && !header.contains(e.target as Node)) setOpen(false);
    });
    header.addEventListener('focusout', (e) => {
      if (mq.matches && header.classList.contains('is-open') && !header.contains(e.relatedTarget as Node | null)) setOpen(false);
    });
    mq.addEventListener('change', () => setOpen(false));
  }

  // Drop-downs ("Events", "About us"): a button that shows or hides its list of links
  const groups = [...document.querySelectorAll<HTMLElement>('[data-nav-group]')].map((g) => ({
    g,
    btn: g.querySelector<HTMLButtonElement>('[data-toggle]')!,
    list: g.querySelector<HTMLElement>('[data-subnav]')!,
  }));
  type Group = (typeof groups)[number];
  const setGroup = (grp: Group, open: boolean) => {
    grp.btn.setAttribute('aria-expanded', String(open));
    grp.list.hidden = !open;
  };
  const wide = window.matchMedia('(min-width: 1080px)');
  groups.forEach((grp) => {
    setGroup(grp, false);
    grp.btn.addEventListener('click', () => {
      const open = grp.btn.getAttribute('aria-expanded') !== 'true';
      groups.forEach((o) => o !== grp && setGroup(o, false)); // one open at a time
      setGroup(grp, open);
    });
    // Wide screens: close when focus moves out of the drop-down (e.g. tabbing past it)
    grp.g.addEventListener('focusout', (e) => {
      if (wide.matches && !grp.g.contains(e.relatedTarget as Node | null)) setGroup(grp, false);
    });
  });
  // Esc closes an open drop-down first (and returns focus to its button) before closing the phone menu
  document.addEventListener(
    'keydown',
    (e) => {
      if (e.key !== 'Escape') return;
      const open = groups.find((grp) => grp.btn.getAttribute('aria-expanded') === 'true');
      if (open) {
        setGroup(open, false);
        open.btn.focus();
        e.stopImmediatePropagation();
      }
    },
    true,
  );
  document.addEventListener('click', (e) => {
    groups.forEach((grp) => !grp.g.contains(e.target as Node) && setGroup(grp, false));
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--green);
    color: var(--white);
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.08), 0 6px 18px rgba(0, 0, 0, 0.12);
  }
  .site-header__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
    min-height: 72px;
    padding-block: 10px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--white);
    text-decoration: none;
    min-height: var(--tap);
  }
  .brand:hover {
    color: var(--white);
  }
  .brand__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 24px;
    letter-spacing: -0.5px;
  }
  .nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 22px;
    list-style: none;
    margin: 0;
    padding: 0;
    font-size: 15px;
    font-weight: 600;
  }
  .nav__link {
    color: var(--white);
    text-decoration: none;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  .nav__icon {
    margin-right: 6px;
  }
  .nav__link:hover,
  .nav__link[aria-current='page'] {
    color: var(--white);
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  /* Drop-down toggles look like the other links */
  .nav__toggle {
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    gap: 6px;
  }
  .nav__toggle.is-current {
    text-decoration: underline;
    text-decoration-color: var(--yellow);
    text-decoration-thickness: 2px;
    text-underline-offset: 6px;
  }
  .nav__chev {
    transition: transform 0.15s ease;
  }
  .nav__toggle[aria-expanded='true'] .nav__chev {
    transform: rotate(180deg);
  }
  .subnav {
    list-style: none;
    margin: 0;
    padding: 0 0 0 16px;
  }
  .subnav__link {
    color: var(--white);
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
  }
  /* Wide screens (with JavaScript): a white panel under the toggle */
  @media (min-width: 1080px) {
    .nav__group {
      position: relative;
    }
    .is-enhanced .subnav {
      position: absolute;
      top: calc(100% + 10px);
      left: -18px;
      min-width: 240px;
      padding: 8px;
      background: var(--white);
      border-radius: var(--radius-sm);
      box-shadow: 0 16px 40px rgba(0, 0, 0, 0.22);
      z-index: 60;
    }
    .is-enhanced .subnav__link {
      display: flex;
      color: var(--text);
      text-decoration: none;
      padding: 0 12px;
      border-radius: 10px;
      white-space: nowrap;
    }
    .is-enhanced .subnav__link:hover,
    .is-enhanced .subnav__link[aria-current='page'] {
      background: var(--surface);
      color: var(--text);
    }
    .is-enhanced .subnav__link[aria-current='page'] {
      box-shadow: inset 3px 0 0 var(--yellow);
    }
  }
  .nav__cta {
    color: var(--text);
    background: var(--yellow);
    text-decoration: none;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    font-weight: 600;
    min-height: var(--tap);
    display: inline-flex;
    align-items: center;
  }
  /* "Get involved" is a drop-down too, styled as the yellow button; its list opens from the right edge */
  .nav__group--cta .nav__toggle.is-current {
    color: var(--text);
  }
  @media (min-width: 1080px) {
    .is-enhanced .nav__group--cta .subnav {
      left: auto;
      right: 0;
    }
  }
  .nav__cta:hover {
    color: var(--text);
    background: #f8cf63;
  }

  /* Menu button (only shown once JavaScript has enhanced the header, and only on smaller screens) */
  .menu-btn {
    display: none;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 16px 0 14px;
    border-radius: var(--radius-pill);
    border: 2px solid rgba(255, 255, 255, 0.45);
    background: transparent;
    color: var(--white);
    font: inherit;
    font-weight: 600;
    font-size: 16px;
    cursor: pointer;
  }
  .menu-btn:hover {
    border-color: var(--white);
  }
  .menu-btn__icon {
    width: 18px;
    display: inline-flex;
    flex-direction: column;
    gap: 4px;
  }
  .menu-btn__icon span {
    height: 2px;
    background: currentColor;
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }
  .is-open .menu-btn__icon span:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .is-open .menu-btn__icon span:nth-child(2) {
    opacity: 0;
  }
  .is-open .menu-btn__icon span:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 1079px) {
    .site-header__inner {
      min-height: 60px;
      padding-block: 8px;
    }
    .brand__name {
      font-size: 21px;
    }
    .brand :global(svg) {
      width: 34px;
      height: 34px;
    }
    /* Enhanced (JS) phone layout: links live in a drop-down panel */
    .is-enhanced .menu-btn {
      display: inline-flex;
    }
    .is-enhanced .nav {
      display: none;
      flex-basis: 100%;
      padding: 6px 0 14px;
      border-top: 1px solid rgba(255, 255, 255, 0.15);
      max-height: calc(100vh - 64px);
      overflow-y: auto;
    }
    .is-enhanced.is-open .nav {
      display: block;
    }
    .is-enhanced .nav__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      font-size: 18px;
    }
    .is-enhanced .nav__link {
      width: 100%;
      min-height: 52px;
      padding-inline: 4px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .is-enhanced .nav__toggle {
      justify-content: space-between;
      text-align: left;
    }
    .is-enhanced .subnav {
      padding: 0 0 6px 16px;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .is-enhanced .subnav__link {
      width: 100%;
      min-height: 46px;
      font-size: 17px;
      text-decoration: none;
      color: var(--on-dark-soft);
    }
    .is-enhanced .subnav__link[aria-current='page'] {
      color: var(--white);
      box-shadow: inset 4px 0 0 var(--yellow);
      padding-left: 12px;
    }
    .is-enhanced .nav__link[aria-current='page'] {
      text-decoration: none;
      box-shadow: inset 4px 0 0 var(--yellow);
      padding-left: 14px;
    }
    .is-enhanced .nav__group--cta {
      margin-top: 14px;
    }
    .is-enhanced .nav__cta {
      width: 100%;
      justify-content: center;
      min-height: 52px;
      font-size: 17px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nav__chev,
    .menu-btn__icon span {
      transition: none;
    }
  }
</style>
