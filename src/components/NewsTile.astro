---
// Stand-in "image" for news stories without a photo: a coloured tile with the duck and the story's tag.
// Stories brought in from Facebook get their own look (the duck in a speech bubble on blue, "From Facebook"),
// so they're easy to tell apart. Deliberately not Facebook's logo, which mustn't be altered or combined.
import DuckLogo from './DuckLogo.astro';
import { getCategory } from '../lib/categories';

interface Props {
  tag: string;
  size?: 'lead' | 'thumb';
  /** The story came from the Bradda Dads Facebook page */
  facebook?: boolean;
}
const { tag, size = 'thumb', facebook = false } = Astro.props;
// Each category has its own colour (editor: Categories → Colour), the same as its labels and News button
const look = facebook ? 'news-tile--facebook' : `cat-${(await getCategory(tag))?.data.colour ?? 'green'}`;
---

<div class:list={['news-tile', `news-tile--${size}`, look]} aria-hidden="true">
  {
    facebook ? (
      <span class="news-tile__bubble">
        <DuckLogo size={size === 'lead' ? 96 : 36} />
      </span>
    ) : (
      <DuckLogo size={size === 'lead' ? 120 : 44} />
    )
  }
  {size === 'lead' && <span class="news-tile__tag">{facebook ? 'From Facebook' : tag}</span>}
</div>

<style>
  .news-tile {
    width: 100%;
    height: 100%;
    /* the speech bubble sizes itself from the tile's shorter side (wide strips on desktop, squares on phones) */
    container-type: size;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    /* the category's colours (cat-… classes in global.css); green if the category isn't in the list */
    background-color: var(--tile-bg, var(--cat-strong, var(--green)));
    background-image: radial-gradient(circle at 20% 20%, rgba(255, 255, 255, 0.12) 0 18%, transparent 19%),
      radial-gradient(circle at 85% 75%, rgba(255, 255, 255, 0.08) 0 26%, transparent 27%);
    color: var(--tile-ink, var(--cat-ink, var(--white)));
  }
  .news-tile--facebook {
    --tile-bg: #1458bf;
    --tile-ink: var(--white);
  }
  /* White speech bubble with a tail at the bottom left, holding the duck */
  .news-tile__bubble {
    position: relative;
    display: grid;
    place-items: center;
    width: min(46cqw, 62cqh);
    aspect-ratio: 1.15;
    background: var(--white);
    border-radius: 28%;
    margin-bottom: 6%;
  }
  .news-tile__bubble::after {
    content: '';
    position: absolute;
    left: 16%;
    bottom: -14%;
    width: 22%;
    height: 22%;
    background: var(--white);
    clip-path: polygon(0 0, 100% 0, 0 100%);
  }
  .news-tile--lead .news-tile__bubble {
    width: min(46cqw, 62cqh, 200px);
  }
  .news-tile__bubble :global(svg) {
    width: 66%;
    height: auto;
  }
  .news-tile__tag {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.3px;
  }
  .news-tile--thumb :global(svg) {
    width: 60%;
    height: auto;
  }
</style>
