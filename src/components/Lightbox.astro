---
// Photo viewer for every `a[data-lb]` on the page, in page order (so it can run across several albums).
// Keyboard: ← → to move, Esc to close (focus returns to the photo you opened). Swipe on touch screens.
// Without JavaScript the links simply open the full-size image.
---

<dialog class="lightbox" aria-label="Photo viewer" data-lightbox>
  <div class="lightbox__frame">
    <img class="lightbox__img" alt="" data-lb-img />
    <p class="lightbox__caption" data-lb-text aria-live="polite"></p>
  </div>
  <button type="button" class="lightbox__btn lightbox__close" data-lb-close aria-label="Close photo viewer">✕</button>
  <button type="button" class="lightbox__btn lightbox__prev" data-lb-prev aria-label="Previous photo">‹</button>
  <button type="button" class="lightbox__btn lightbox__next" data-lb-next aria-label="Next photo">›</button>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-lightbox]');
  if (dialog && typeof dialog.showModal === 'function') {
    const img = dialog.querySelector<HTMLImageElement>('[data-lb-img]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-lb-text]')!;
    // All photos on the page, including ones in collapsed ("Show all") sections
    const items = () => [...document.querySelectorAll<HTMLAnchorElement>('a[data-lb]')];
    let current = 0;
    let opener: HTMLElement | null = null;

    function show(i: number) {
      const list = items();
      current = (i + list.length) % list.length;
      const a = list[current];
      img.removeAttribute('srcset');
      img.src = a.href;
      if (a.dataset.lbSrcset) {
        img.sizes = '100vw';
        img.srcset = a.dataset.lbSrcset;
      }
      img.alt = a.querySelector('img')?.alt ?? '';
      caption.textContent = a.dataset.lbCaption ?? '';
      [current + 1, current - 1].forEach((n) => {
        const near = list[(n + list.length) % list.length];
        if (!near) return;
        const pre = new Image();
        if (near.dataset.lbSrcset) {
          pre.sizes = '100vw';
          pre.srcset = near.dataset.lbSrcset;
        }
        pre.src = near.href;
      });
    }

    document.addEventListener('click', (e) => {
      const a = (e.target as HTMLElement).closest<HTMLAnchorElement>('a[data-lb]');
      if (!a || e.metaKey || e.ctrlKey || e.shiftKey) return; // let people open in a new tab
      e.preventDefault();
      opener = a;
      show(items().indexOf(a));
      dialog.showModal();
    });
    dialog.querySelector('[data-lb-prev]')!.addEventListener('click', () => show(current - 1));
    dialog.querySelector('[data-lb-next]')!.addEventListener('click', () => show(current + 1));
    dialog.querySelector('[data-lb-close]')!.addEventListener('click', () => dialog.close());
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'Tab') {
        const btns = [...dialog.querySelectorAll<HTMLButtonElement>('button')];
        const i = btns.indexOf(document.activeElement as HTMLButtonElement);
        e.preventDefault();
        btns[(i + (e.shiftKey ? -1 : 1) + btns.length) % btns.length].focus();
      }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(current + 1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(current - 1); }
    });
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });
    dialog.addEventListener('close', () => {
      // If the photo you ended on is in a collapsed section, reveal it so focus has somewhere to go
      const last = items()[current];
      const li = last?.closest<HTMLElement>('li[hidden]');
      if (li) li.hidden = false;
      (last && last.offsetParent ? last : opener)?.focus();
    });
    let startX = 0;
    dialog.addEventListener('touchstart', (e) => (startX = e.touches[0].clientX), { passive: true });
    dialog.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - startX;
      if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    });
  }
</script>

<style>
  .lightbox {
    width: 100vw;
    height: 100vh;
    max-width: 100vw;
    max-height: 100vh;
    margin: 0;
    padding: 0;
    border: 0;
    background: rgba(10, 20, 15, 0.94);
    color: var(--white);
  }
  .lightbox::backdrop {
    background: rgba(10, 20, 15, 0.94);
  }
  .lightbox__frame {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding: 64px 64px 24px;
    pointer-events: none;
  }
  .lightbox__img {
    max-width: 100%;
    max-height: calc(100vh - 140px);
    object-fit: contain;
    border-radius: 6px;
    pointer-events: auto;
  }
  .lightbox__caption {
    font-size: 15px;
    font-weight: 500;
    color: var(--on-dark-soft);
    text-align: center;
    max-width: 70ch;
  }
  .lightbox__btn {
    position: absolute;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 0;
    background: rgba(255, 255, 255, 0.14);
    color: var(--white);
    font-size: 30px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .lightbox__btn:hover {
    background: rgba(255, 255, 255, 0.26);
  }
  .lightbox__close {
    top: 14px;
    right: 14px;
    font-size: 22px;
  }
  .lightbox__prev,
  .lightbox__next {
    top: 50%;
    transform: translateY(-50%);
  }
  .lightbox__prev {
    left: 10px;
  }
  .lightbox__next {
    right: 10px;
  }
  @media (max-width: 600px) {
    .lightbox__frame {
      padding: 64px 8px 90px;
    }
    .lightbox__prev,
    .lightbox__next {
      top: auto;
      bottom: 20px;
      transform: none;
    }
    .lightbox__prev {
      left: calc(50% - 64px);
    }
    .lightbox__next {
      right: calc(50% - 64px);
    }
  }
</style>
