---
// "Dates for your diary" from site.yaml (past dates drop off on the daily rebuild).
import { getSite } from '../lib/site';
import { url } from '../lib/url';

interface Props {
  limit?: number;
  title?: string;
}
const { limit = 8, title = 'Dates for your diary' } = Astro.props;
const site = await getSite();
const today = new Date();
today.setHours(0, 0, 0, 0);
const diary = site.diaryDates.filter((d) => d.date >= today).slice(0, limit);
const fmtDay = (d: Date) => d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/London' });
---

{
  diary.length > 0 && (
    <div class="diary-box">
      <h2 class="subhead">{title}</h2>
      <ul class="diary" role="list">
        {diary.map((d) => (
          <li class="diary__item">
            <time class="diary__date" datetime={d.date.toISOString().slice(0, 10)}>
              {d.label ?? fmtDay(d.date)}
            </time>
            {d.url ? <a href={url(d.url)}>{d.text}</a> : <span>{d.text}</span>}
          </li>
        ))}
      </ul>
      <p class="diary__follow">
        Reminders every week on <a href={site.facebookUrl} rel="noopener">our Facebook page</a>.
      </p>
    </div>
  )
}

<style>
  .diary-box {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--white);
  }
  .diary {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .diary__item {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--border-soft);
    font-size: 16px;
    line-height: 1.4;
  }
  .diary__date {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }
  .diary__item a {
    color: var(--text);
    text-decoration: none;
  }
  .diary__item a:hover {
    text-decoration: underline;
  }
  .diary__follow {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .diary__item {
      grid-template-columns: 1fr;
    }
    .diary-box {
      padding: 22px 20px;
    }
  }
</style>
