---
// "Dates for your diary": every event's own date and sign-up deadline (automatic, from the events), plus
// any extra dates typed into Site settings (e.g. Co-op selling days). A typed entry on the same day for
// the same event wins, since it usually says more. Past dates drop off on the daily rebuild.
import { getSite } from '../lib/site';
import { getEvents, deadlineFor } from '../lib/events';
import { url } from '../lib/url';

interface Props {
  limit?: number;
  title?: string;
}
const { limit = 8, title = 'Dates for your diary' } = Astro.props;
const site = await getSite();
const today = new Date();
today.setHours(0, 0, 0, 0);
const dayKey = (d: Date) => d.toLocaleDateString('en-CA', { timeZone: 'Europe/London' });
const manual = site.diaryDates.map((d) => ({ date: d.date, label: d.label, text: d.text, url: d.url }));
const WORDS = { 'Book by': 'Last day to book for the', 'Entries close': 'Last day for entries: the', 'Orders close': 'Last day to order: the', 'Online sales close': 'Last day to buy online: the' } as const;
const auto: typeof manual = [];
for (const e of await getEvents()) {
  const page = `/events/${e.id}/`;
  const taken = (date: Date) => manual.some((m) => dayKey(m.date) === dayKey(date) && (m.url === page || m.url === e.data.ctaUrl));
  if (e.data.start && !taken(e.data.start)) auto.push({ date: e.data.start, label: undefined, text: e.data.name, url: page });
  const dl = deadlineFor(e);
  if (dl && !dl.passed && !taken(dl.date)) auto.push({ date: dl.date, label: undefined, text: `${WORDS[dl.label]} ${e.data.name}`, url: page });
}
const diary = [...manual, ...auto]
  .filter((d) => d.date >= today)
  .sort((a, b) => a.date.getTime() - b.date.getTime())
  .slice(0, limit);
const fmtDay = (d: Date) => d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/London' });
---

{
  diary.length > 0 && (
    <div class="diary-box">
      <h2 class="subhead">{title}</h2>
      <ul class="diary" role="list">
        {diary.map((d) => (
          <li class="diary__item">
            <time class="diary__date" datetime={d.date.toISOString().slice(0, 10)}>
              {d.label ?? fmtDay(d.date)}
            </time>
            {d.url ? <a href={url(d.url)}>{d.text}</a> : <span>{d.text}</span>}
          </li>
        ))}
      </ul>
      <p class="diary__follow">
        Reminders every week on <a href={site.facebookUrl} rel="noopener">our Facebook page</a>.
      </p>
    </div>
  )
}

<style>
  .diary-box {
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 28px 30px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    background: var(--white);
  }
  .diary {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .diary__item {
    display: grid;
    grid-template-columns: 128px 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--border-soft);
    font-size: 16px;
    line-height: 1.4;
  }
  .diary__date {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }
  .diary__item a {
    color: var(--text);
    text-decoration: none;
    display: inline-block;
    padding-block: 3px;
    min-height: 28px;
  }
  .diary__item a:hover {
    text-decoration: underline;
  }
  .diary__follow {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .diary__item {
      grid-template-columns: 1fr;
    }
    .diary-box {
      padding: 22px 20px;
    }
  }
</style>
