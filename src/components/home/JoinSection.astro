---
import { getSite } from '../../lib/site';
import { isPlaceholder } from '../../lib/events';
import { url, thumb } from '../../lib/url';

const site = await getSite();
const posts = site.facebookPosts.filter((p) => !isPlaceholder(p.text));
// Keep dates for the rest of their day
const today = new Date();
today.setHours(0, 0, 0, 0);
const diary = site.diaryDates.filter((d) => d.date >= today).slice(0, 5);
const fmtDay = (d: Date) => d.toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric', month: 'short', timeZone: 'Europe/London' });
---

<section id="join" class="join" aria-label="Join us">
  <div class="container join__grid">
    <div class="join__card">
      <h2 class="join__title">Got kids? Live in Bradwell? You're in.</h2>
      <p class="join__text">
        Bradda Dads is open to any dad in the parish. No experience needed, just a spare pair of hands for a few events a year. We meet {site.meetingInfo}.
      </p>
      <div class="join__actions">
        <a class="btn btn--yellow btn--sm" href={url('/get-involved/')}>Join the dads</a>
        <a class="btn btn--ghost-light btn--sm" href="#donate">Donate</a>
      </div>
    </div>
    {posts.length === 0 ? (
      <div class="fb">
        <div class="fb__head">
          <h2 class="fb__title">Dates for your diary</h2>
          <a class="link-arrow" href={url('/events/')}>All events →</a>
        </div>
        {diary.length > 0 ? (
          <ul class="diary" role="list">
            {diary.map((d) => (
              <li class="diary__item">
                <time class="diary__date" datetime={d.date.toISOString().slice(0, 10)}>
                  {d.label ?? fmtDay(d.date)}
                </time>
                {d.url ? <a href={url(d.url)}>{d.text}</a> : <span>{d.text}</span>}
              </li>
            ))}
          </ul>
        ) : (
          <p class="fb__empty">New dates coming soon.</p>
        )}
        <p class="fb__follow">
          News, photos and reminders every week on <a href={site.facebookUrl} rel="noopener">our Facebook page</a>.
        </p>
      </div>
    ) : (
    <div class="fb">
      <div class="fb__head">
        <h2 class="fb__title">Latest from Facebook</h2>
        <a class="link-arrow" href={site.facebookUrl} rel="noopener">Follow us →</a>
      </div>
      <ul class="fb__list" role="list">
        {
          posts.map((post) => (
            <li class="fb__post">
              {post.image ? (
                <img class="fb__thumb" src={thumb(post.image)} alt={post.imageAlt ?? ''} width="64" height="64" loading="lazy" />
              ) : (
                <div class="fb__thumb fb__thumb--empty" aria-hidden="true">
                  Photo
                </div>
              )}
              <div class="fb__body">
                <span class="fb__when">{post.date}</span>
                <a class="fb__text" href={url(post.url)} rel="noopener">
                  {post.text}
                </a>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
    )}
  </div>
</section>

<style>
  .diary {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .diary__item {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 4px 14px;
    align-items: baseline;
    padding-block: 12px;
    border-bottom: 1px solid var(--border-soft);
    font-size: 16px;
    line-height: 1.4;
  }
  .diary__date {
    font-family: var(--font-heading);
    font-weight: 700;
    color: var(--green);
    white-space: nowrap;
  }
  .diary__item a {
    color: var(--text);
    text-decoration: none;
  }
  .diary__item a:hover {
    text-decoration: underline;
  }
  .fb__empty,
  .fb__follow {
    font-size: 15px;
    color: var(--muted);
  }
  @media (max-width: 420px) {
    .diary__item {
      grid-template-columns: 1fr;
    }
  }
  .join {
    padding-block: var(--section-pad);
  }
  .join__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 24px;
  }
  .join__card {
    border-radius: var(--radius-lg);
    background: var(--green);
    color: var(--white);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .join__title {
    font-weight: 800;
    font-size: clamp(28px, 4vw, 34px);
    line-height: 1.1;
    letter-spacing: -0.6px;
  }
  .join__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--on-dark-soft);
  }
  .join__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .btn--sm {
    min-height: 50px;
    padding: 0 24px;
    font-size: 16px;
  }
  .fb {
    border-radius: var(--radius-lg);
    border: 1px solid var(--border);
    padding: 40px;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .fb__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    flex-wrap: wrap;
  }
  .fb__title {
    font-weight: 800;
    font-size: 28px;
    letter-spacing: -0.4px;
  }
  .fb__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .fb__post {
    display: flex;
    gap: 14px;
    align-items: flex-start;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--border-soft);
  }
  .fb__thumb {
    width: 64px;
    height: 64px;
    border-radius: var(--radius-sm);
    background: var(--surface-green);
    flex-shrink: 0;
    object-fit: cover;
  }
  .fb__thumb--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 11px;
    color: var(--muted);
  }
  .fb__body {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }
  .fb__when {
    font-size: 13px;
    color: var(--muted);
  }
  .fb__text {
    font-size: 15px;
    line-height: 1.45;
    color: var(--text);
    text-decoration: none;
  }
  .fb__text:hover {
    text-decoration: underline;
  }
  @media (max-width: 600px) {
    .join__card,
    .fb {
      padding: 28px 22px;
    }
  }
</style>
