---
import { getCollection } from 'astro:content';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
const timeline = (await getCollection('timeline')).sort((a, b) => a.data.order - b.data.order).slice(0, 6);
---

<section id="story" class="story" aria-labelledby="story-title">
  <div class="container story__inner">
    <div class="story__intro">
      <p class="eyebrow story__eyebrow">Our story</p>
      <h2 id="story-title" class="story__title">It started with a duck race</h2>
      <p class="story__text">{site.storyIntro.replace(/\s*\[[^\]]*\]/g, '')}</p>
      {
        site.storyImage ? (
          <figure class="story__figure">
            <img class="story__photo" src={url(site.storyImage)} alt={site.storyImageAlt ?? ''} loading="lazy" decoding="async" width="560" height="220" />
            {site.storyImageCaption && <figcaption>{site.storyImageCaption}</figcaption>}
          </figure>
        ) : (
          <div class="story__photo story__photo--empty" aria-hidden="true">
            [Archive photo, e.g. the first duck race]
          </div>
        )
      }
      <a class="link-arrow story__link" href={url('/our-story/')}>Read the full history →</a>
    </div>
    <ol class="timeline">
      {
        timeline.map((t) => (
          <li class="timeline__item">
            <div class="timeline__rail" aria-hidden="true">
              <span class="timeline__dot" />
              <span class="timeline__line" />
            </div>
            <div class="timeline__body">
              <span class="timeline__year">{t.data.year}</span>
              <span class="timeline__title">{t.data.title}</span>
              <span class="timeline__text">{t.data.text}</span>
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .story {
    padding-block: 80px;
    background: var(--yellow-panel);
  }
  .story__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }
  .story__intro {
    flex: 1 1 340px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .story__eyebrow {
    color: var(--yellow-ink);
  }
  .story__title {
    font-weight: 800;
    font-size: clamp(34px, 5vw, 44px);
    line-height: 1.02;
    letter-spacing: -1px;
  }
  .story__text {
    font-size: 17px;
    line-height: 1.6;
    color: var(--yellow-body);
  }
  .story__photo {
    width: 100%;
    height: 220px;
    border-radius: var(--radius-card);
    object-fit: cover;
    background: var(--yellow-panel-strong);
  }
  .story__figure {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .story__figure figcaption {
    font-size: 14px;
    color: var(--yellow-ink);
  }
  .story__photo--empty {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--yellow-ink);
    font-size: 14px;
    text-align: center;
    padding: 16px;
  }
  .story__link {
    color: var(--text);
    padding: 8px 0;
  }
  .timeline {
    flex: 999 1 520px;
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
  }
  .timeline__item {
    display: flex;
    gap: 20px;
  }
  .timeline__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex-shrink: 0;
    width: 22px;
  }
  .timeline__dot {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--green);
    border: 4px solid var(--yellow-panel);
    box-shadow: 0 0 0 2px var(--green);
    margin-top: 6px;
  }
  .timeline__line {
    flex-grow: 1;
    width: 2px;
    background: #c9a64a;
  }
  .timeline__item:last-child .timeline__line {
    background: transparent;
  }
  .timeline__body {
    padding-bottom: 28px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .timeline__year {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 24px;
    color: var(--green);
  }
  .timeline__title {
    font-weight: 600;
    font-size: 18px;
  }
  .timeline__text {
    font-size: 15px;
    line-height: 1.5;
    color: var(--yellow-body);
  }
  @media (max-width: 600px) {
    .story {
      padding-block: 56px;
    }
  }
</style>
