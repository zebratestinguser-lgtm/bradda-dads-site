---
import DuckLogo from '../DuckLogo.astro';
import { getSite } from '../../lib/site';
import { isPlaceholder } from '../../lib/events';
import { url } from '../../lib/url';

const site = await getSite();
// The QR column only appears once a real SumUp QR image is set in site.yaml (a fake one could confuse people)
---

<section id="donate" class="donate-wrap" aria-labelledby="donate-title">
  <div class="container">
    <div class="donate">
      <div class="donate__copy">
        <h2 id="donate-title" class="donate__title">Give online</h2>
        <p class="donate__text">
          Pick an amount to pay securely online.
        </p>
        <ul class="amounts" role="list">
          {
            site.donationLinks.map((d) => (
              <li>
                <a class="amount" href={url(d.url)}>
                  <span class="amount__value">£{d.amount}</span>
                  {!isPlaceholder(d.label) && <span class="amount__label">{d.label}</span>}
                  <span class="visually-hidden"> (donate £{d.amount} via SumUp)</span>
                </a>
              </li>
            ))
          }
        </ul>
        <div class="donate__foot">
          <a class="link-arrow" href={url(site.sumupStoreUrl)}>Visit our SumUp shop →</a>
          <span class="donate__secure">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="5" y="11" width="14" height="10" rx="2" />
              <path d="M8 11V8a4 4 0 0 1 8 0v3" />
            </svg>
            Secure payments by SumUp
          </span>
        </div>
      </div>
      {
        site.donationQr ? (
          <div class="donate__qr-col">
            <img class="qr" src={url(site.donationQr)} alt="QR code: scan to donate to Bradda Dads via SumUp" width="200" height="200" loading="lazy" />
            <p class="donate__qr-text">At an event? Scan to donate on your phone.</p>
          </div>
        ) : (
          <div class="donate__art" aria-hidden="true">
            <span class="donate__duck d1"><DuckLogo size={96} /></span>
            <span class="donate__duck d2"><DuckLogo size={72} /></span>
            <span class="donate__duck d3"><DuckLogo size={56} /></span>
            <span class="donate__water" />
          </div>
        )
      }
    </div>
  </div>
</section>

<style>
  .donate-wrap {
    padding-top: 8px;
  }
  .donate {
    background: var(--white);
    border-radius: var(--radius-xl);
    border: 2px solid var(--green);
    padding: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .donate__copy {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .donate__title {
    font-size: clamp(26px, 3.5vw, 32px);
    line-height: 1.1;
  }
  .donate__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
    max-width: 560px;
  }
  .amounts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    max-width: 480px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .amount {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    min-height: 84px;
    height: 100%;
    padding: 10px 6px;
    border-radius: 18px;
    background: var(--surface);
    color: var(--text);
    text-decoration: none;
  }
  .amount:hover {
    color: var(--text);
    background: var(--border);
  }
  .amount__value {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 30px;
  }
  .amount__label {
    font-size: 12px;
    color: var(--muted);
    line-height: 1.3;
  }
  .donate__foot {
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    align-items: center;
    font-size: 14px;
    color: var(--muted);
  }
  .donate__foot .link-arrow {
    font-size: 15px;
    padding: 10px 0;
  }
  .donate__secure {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .donate__qr-col {
    flex: 1 1 240px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
  }
  .qr {
    width: 200px;
    height: 200px;
    border-radius: 20px;
    background: var(--white);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-soft);
  }
  /* Three ducks bobbing on a strip of water (shown until a real QR code is added) */
  .donate__art {
    flex: 1 1 240px;
    position: relative;
    height: 180px;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 6px;
    padding-bottom: 26px;
  }
  .donate__duck {
    position: relative;
    z-index: 1;
    display: block;
  }
  .donate__water {
    position: absolute;
    left: 10%;
    right: 10%;
    bottom: 18px;
    height: 34px;
    border-radius: 999px;
    background: linear-gradient(180deg, #cfe1ee, #8fb7d6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .donate__duck {
      animation: bob 3.2s ease-in-out infinite;
    }
    .donate__duck.d2 {
      animation-delay: -1.1s;
    }
    .donate__duck.d3 {
      animation-delay: -2.2s;
    }
  }
  @keyframes bob {
    0%,
    100% {
      transform: translateY(0) rotate(-3deg);
    }
    50% {
      transform: translateY(-6px) rotate(3deg);
    }
  }
  .donate__qr-text {
    font-size: 14px;
    color: var(--muted);
    text-align: center;
    max-width: 220px;
  }
  @media (max-width: 600px) {
    .donate {
      padding: 28px 20px;
    }
    .amount__value {
      font-size: 26px;
    }
  }
</style>
