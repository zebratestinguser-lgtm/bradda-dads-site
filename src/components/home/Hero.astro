---
import DuckLogo from '../DuckLogo.astro';
import type { EventEntry } from '../../lib/events';
import { formatEventDay, formatTime, inlineBold } from '../../lib/format';
import { url } from '../../lib/url';

interface Props {
  event?: EventEntry;
}
const { event } = Astro.props;

let title = '';
let before = '';
let highlight = '';
let after = '';
let start: Date | undefined;
let confirmed = false;
let initial = { days: 0, hours: 0, mins: 0 };

if (event) {
  const d = event.data;
  title = d.heroTitle ?? d.name;
  const i = d.heroHighlight ? title.indexOf(d.heroHighlight) : -1;
  if (i >= 0 && d.heroHighlight) {
    before = title.slice(0, i);
    highlight = d.heroHighlight;
    after = title.slice(i + d.heroHighlight.length);
  } else {
    before = title;
  }
  start = d.start;
  confirmed = d.startTimeConfirmed;
  if (start) {
    let diff = Math.max(0, start.getTime() - Date.now());
    const days = Math.floor(diff / 864e5);
    diff -= days * 864e5;
    const hours = Math.floor(diff / 36e5);
    diff -= hours * 36e5;
    initial = { days, hours, mins: Math.floor(diff / 6e4) };
  }
}
const pad = (n: number) => String(n);
---

{
  event && (
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="hero__badge">Next up in Bradwell</p>
          <h1 id="hero-title" class="hero__title">
            {before}
            {highlight && <span class="hero__highlight">{highlight}</span>}
            {after}
          </h1>
          <p class="hero__text">{event.data.heroText ?? event.data.summary}</p>
          <ul class="hero__meta" role="list">
            {start && (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M16 3v4M8 3v4M3 10h18" />
                </svg>
                {formatEventDay(start)}
              </li>
            )}
            {start && (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                {confirmed ? formatTime(start) : '[START TIME]'}
              </li>
            )}
            <li>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
                <circle cx="12" cy="10" r="2.5" />
              </svg>
              {event.data.location}
            </li>
          </ul>
          <div class="hero__actions">
            <a class="btn btn--yellow" href={url(event.data.ctaUrl)}>
              {event.data.ctaLabel}
              {event.data.price && ` · ${event.data.price}`}
            </a>
            <a class="btn btn--ghost-light" href={url('/events/')}>All events</a>
          </div>
        </div>

        {start && (
          <div class="hero__side">
            <div class="countdown" data-start={start.toISOString()} data-confirmed={String(confirmed)}>
              <p class="countdown__label" id="countdown-label">
                {event.data.countdownLabel ?? 'Starts in'}
              </p>
              <div class="countdown__grid" role="timer" aria-labelledby="countdown-label" aria-live="off">
                <div class="countdown__cell">
                  <span class="countdown__num" data-unit="days">{pad(initial.days)}</span>
                  <span class="countdown__unit">days</span>
                </div>
                {confirmed ? (
                  <>
                    <div class="countdown__cell">
                      <span class="countdown__num" data-unit="hours">{pad(initial.hours)}</span>
                      <span class="countdown__unit">hours</span>
                    </div>
                    <div class="countdown__cell">
                      <span class="countdown__num" data-unit="mins">{pad(initial.mins)}</span>
                      <span class="countdown__unit">mins</span>
                    </div>
                  </>
                ) : (
                  <div class="countdown__cell countdown__cell--wide">
                    <span class="countdown__tbc">Start time to be confirmed</span>
                  </div>
                )}
              </div>
              {event.data.heroNote && (
                <div class="countdown__note">
                  <DuckLogo size={56} />
                  <p set:html={inlineBold(event.data.heroNote)} />
                </div>
              )}
            </div>
          </div>
        )}
      </div>
    </section>
  )
}

<script>
  // Live countdown: updates every 30 seconds. Without JS the build-time numbers show.
  function tick(el: HTMLElement) {
    const start = new Date(el.dataset.start!).getTime();
    const confirmed = el.dataset.confirmed === 'true';
    let diff = Math.max(0, start - Date.now());
    // Without a confirmed time, count whole days to the date.
    const days = confirmed ? Math.floor(diff / 864e5) : Math.max(0, Math.ceil(diff / 864e5));
    diff -= Math.floor(diff / 864e5) * 864e5;
    const hours = Math.floor(diff / 36e5);
    const mins = Math.floor((diff - hours * 36e5) / 6e4);
    const set = (unit: string, v: number) => {
      const n = el.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
      if (n) n.textContent = String(v);
    };
    set('days', days);
    set('hours', hours);
    set('mins', mins);
  }
  document.querySelectorAll<HTMLElement>('.countdown[data-start]').forEach((el) => {
    tick(el);
    setInterval(() => tick(el), 30_000);
  });
</script>

<style>
  .hero {
    background: var(--green);
    color: var(--white);
    padding-block: 40px 72px;
  }
  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .hero__copy {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero__badge {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .hero__title {
    font-weight: 800;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -1.5px;
  }
  .hero__highlight {
    color: var(--yellow);
  }
  .hero__text {
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-dark-soft);
    max-width: 560px;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .hero__side {
    flex: 1 1 340px;
    display: flex;
    justify-content: center;
  }
  .countdown {
    background: var(--white);
    color: var(--text);
    border-radius: var(--radius-lg);
    padding: 30px 34px;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: var(--shadow-card);
  }
  .countdown__label {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
  }
  .countdown__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    text-align: center;
  }
  .countdown__cell {
    background: var(--surface);
    border-radius: 16px;
    padding: 14px 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .countdown__cell--wide {
    grid-column: span 2;
  }
  .countdown__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 44px;
    line-height: 1;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .countdown__unit {
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }
  .countdown__tbc {
    font-size: 14px;
    font-weight: 600;
    color: var(--muted-strong);
    line-height: 1.3;
  }
  .countdown__note {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .countdown__note :global(svg) {
    flex-shrink: 0;
  }
  .countdown__note p {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted-strong);
  }
  @media (max-width: 480px) {
    .countdown {
      padding: 24px 20px;
    }
    .countdown__num {
      font-size: 36px;
    }
  }
</style>
