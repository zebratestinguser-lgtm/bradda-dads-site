---
import { url } from '../../lib/url';
import Img from '../Img.astro';
import DuckLogo from '../DuckLogo.astro';
import BrookEdge from '../BrookEdge.astro';
import { isPlaceholder, isHappening, formatEventDates, deadlineFor, shortDay, type EventEntry } from '../../lib/events';
import { formatTime, inlineBold } from '../../lib/format';

interface Props {
  event?: EventEntry;
}
const { event } = Astro.props;

let title = '';
let before = '';
let highlight = '';
let after = '';
let start: Date | undefined;
let confirmed = false;
let initial = { days: 0, hours: 0, mins: 0 };

if (event) {
  const d = event.data;
  title = d.heroTitle ?? d.name;
  const i = d.heroHighlight ? title.indexOf(d.heroHighlight) : -1;
  if (i >= 0 && d.heroHighlight) {
    before = title.slice(0, i);
    highlight = d.heroHighlight;
    after = title.slice(i + d.heroHighlight.length);
  } else {
    before = title;
  }
  start = d.start;
  confirmed = d.startTimeConfirmed;
  if (start) {
    let diff = Math.max(0, start.getTime() - Date.now());
    const days = Math.floor(diff / 864e5);
    diff -= days * 864e5;
    const hours = Math.floor(diff / 36e5);
    diff -= hours * 36e5;
    initial = { days, hours, mins: Math.floor(diff / 6e4) };
  }
}
const pad = (n: number) => String(n);
// Multi-day events (e.g. a gala weekend) stay in the hero until their last day, shown as "On now"
const onNow = event ? isHappening(event) : false;
const dates = event ? formatEventDates(event) : undefined;
const deadline = event ? deadlineFor(event) : undefined;
---

{
  event && (
    <section class="hero" aria-labelledby="hero-title">
      <div class="container hero__inner">
        <div class="hero__copy">
          <p class="hero__badge">{onNow ? 'On now in Bradwell' : 'Next up in Bradwell'}</p>
          <h1 id="hero-title" class="hero__title">
            {before}
            {highlight && <span class="hero__highlight">{highlight}</span>}
            {after}
          </h1>
          <p class="hero__text">{event.data.heroText ?? event.data.summary}</p>
          <ul class="hero__meta" role="list">
            {start && (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M16 3v4M8 3v4M3 10h18" />
                </svg>
                {dates}
              </li>
            )}
            {start && (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <circle cx="12" cy="12" r="9" />
                  <path d="M12 7v5l3 2" />
                </svg>
                {confirmed ? formatTime(start) : 'Time to be confirmed'}
              </li>
            )}
            {deadline && (
              <li class:list={['hero__deadline', { 'is-passed': deadline.passed }]}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 4h14M5 20h14M7 4c0 5 5 5 5 8s-5 3-5 8M17 4c0 5-5 5-5 8s5 3 5 8" /></svg>
                {deadline.passed ? deadline.closedText : <>{deadline.label} <strong>{shortDay(deadline.date)}</strong></>}
              </li>
            )}
            {!isPlaceholder(event.data.location) && (
              <li>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11z" />
                  <circle cx="12" cy="10" r="2.5" />
                </svg>
                {event.data.location}
              </li>
            )}
          </ul>
          <div class="hero__actions">
            <a class="btn btn--yellow" href={url(event.data.ctaUrl)}>
              {event.data.ctaLabel}
              {event.data.price && ` · ${event.data.price}`}
            </a>
            <a class="btn btn--ghost-light" href={url('/events/')}>All events</a>
          </div>
        </div>

        {start && (
          <div class:list={['hero__side', { 'hero__side--photo': event.data.heroImage }]}>
            {event.data.heroImage && (
              <figure class="hero__photo">
                <Img kind="large" src={event.data.heroImage} sizes="(max-width: 600px) 100vw, 45vw" alt={event.data.heroImageAlt ?? ''} width="640" height="480" fetchpriority="high" decoding="async" />
                {event.data.heroImageCaption && <figcaption class="hero__photo-date">{event.data.heroImageCaption}</figcaption>}
              </figure>
            )}
            <div class="countdown" data-start={onNow ? undefined : start.toISOString()} data-confirmed={String(confirmed)}>
              <p class="countdown__label" id="countdown-label">
                {onNow ? 'Happening now' : (event.data.countdownLabel ?? 'Starts in')}
              </p>
              {onNow ? (
                <div class="countdown__live">
                  <span class="countdown__live-dot" aria-hidden="true" />
                  <span>On now · {dates}</span>
                </div>
              ) : (
              <div class="countdown__grid" role="timer" aria-labelledby="countdown-label" aria-live="off">
                <div class="countdown__cell">
                  <span class="countdown__num" data-unit="days">{pad(initial.days)}</span>
                  <span class="countdown__unit">days</span>
                </div>
                {confirmed ? (
                  <>
                    <div class="countdown__cell">
                      <span class="countdown__num" data-unit="hours">{pad(initial.hours)}</span>
                      <span class="countdown__unit">hours</span>
                    </div>
                    <div class="countdown__cell">
                      <span class="countdown__num" data-unit="mins">{pad(initial.mins)}</span>
                      <span class="countdown__unit">mins</span>
                    </div>
                  </>
                ) : (
                  <div class="countdown__cell countdown__cell--wide">
                    <span class="countdown__tbc">{shortDay(start)}</span>
                  </div>
                )}
              </div>
              )}
              {event.data.heroNote && (
                <div class="countdown__note">
                  <DuckLogo size={56} />
                  <p set:html={inlineBold(event.data.heroNote)} />
                </div>
              )}
            </div>
          </div>
        )}
      </div>
      <BrookEdge />
    </section>
  )
}

<script>
  // Live countdown: updates every 30 seconds. Without JS the build-time numbers show.
  function tick(el: HTMLElement) {
    const start = new Date(el.dataset.start!).getTime();
    const confirmed = el.dataset.confirmed === 'true';
    let diff = Math.max(0, start - Date.now());
    // Without a confirmed time, count whole days to the date.
    const days = confirmed ? Math.floor(diff / 864e5) : Math.max(0, Math.ceil(diff / 864e5));
    diff -= Math.floor(diff / 864e5) * 864e5;
    const hours = Math.floor(diff / 36e5);
    const mins = Math.floor((diff - hours * 36e5) / 6e4);
    const set = (unit: string, v: number) => {
      const n = el.querySelector<HTMLElement>(`[data-unit="${unit}"]`);
      if (n) n.textContent = String(v);
    };
    set('days', days);
    set('hours', hours);
    set('mins', mins);
  }
  document.querySelectorAll<HTMLElement>('.countdown[data-start]').forEach((el) => {
    tick(el);
    setInterval(() => tick(el), 30_000);
  });
</script>

<style>
  .hero {
    position: relative;
    background: var(--green);
    color: var(--white);
    padding-block: 40px 96px;
  }
  .hero__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .hero__copy {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .hero__badge {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.12);
    border-radius: var(--radius-pill);
    padding: 8px 16px;
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.4px;
    text-transform: uppercase;
  }
  .hero__title {
    font-weight: 800;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 0.98;
    letter-spacing: -1.5px;
  }
  .hero__highlight {
    color: var(--yellow);
  }
  .hero__text {
    font-size: 19px;
    line-height: 1.55;
    color: var(--on-dark-soft);
    max-width: 560px;
  }
  .hero__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    font-size: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* "Book by Fri 27 Nov": the deadline stands out in yellow while it's still to come */
  .hero__deadline:not(.is-passed) strong {
    color: var(--yellow);
  }
  .hero__meta li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }
  .hero__side {
    flex: 1 1 400px;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  /* Photo with the countdown card overlapping its lower edge */
  .hero__photo {
    position: relative;
    margin: 0;
    width: 100%;
    max-width: 480px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    transform: rotate(1.5deg);
    aspect-ratio: 4 / 3;
    background: var(--green-deep);
  }
  .hero__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__photo-date {
    position: absolute;
    top: 14px;
    right: 14px;
    background: rgba(16, 36, 26, 0.85);
    color: var(--white);
    font-size: 13px;
    font-weight: 600;
    padding: 5px 12px;
    border-radius: var(--radius-pill);
  }
  .hero__side--photo .countdown {
    margin-top: -40px;
    position: relative;
    max-width: 380px;
    padding: 24px 28px;
    gap: 14px;
    transform: rotate(-1deg);
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero__photo,
    .hero__side--photo .countdown {
      transition: transform 0.3s ease;
    }
    .hero__side--photo:hover .hero__photo,
    .hero__side--photo:hover .countdown {
      transform: rotate(0deg);
    }
  }
  .countdown {
    background: var(--white);
    color: var(--text);
    border-radius: var(--radius-lg);
    padding: 30px 34px;
    width: 100%;
    max-width: 400px;
    display: flex;
    flex-direction: column;
    gap: 18px;
    box-shadow: var(--shadow-card);
  }
  .countdown__label {
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--muted);
  }
  .countdown__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
    text-align: center;
  }
  .countdown__cell {
    background: var(--surface);
    border-radius: 16px;
    padding: 14px 6px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .countdown__cell--wide {
    grid-column: span 2;
  }
  .countdown__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 44px;
    line-height: 1;
    color: var(--green);
    font-variant-numeric: tabular-nums;
  }
  .countdown__unit {
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }
  /* The day itself when the start time isn't known yet, e.g. "Fri 4 Dec" */
  .countdown__tbc {
    font-family: var(--font-heading);
    font-size: 22px;
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
  }
  .countdown__live {
    display: flex;
    align-items: center;
    gap: 12px;
    background: var(--yellow-panel);
    color: var(--yellow-ink);
    border-radius: 16px;
    padding: 18px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.2;
  }
  .countdown__live-dot {
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--orange);
    flex-shrink: 0;
    box-shadow: 0 0 0 0 rgba(232, 112, 42, 0.6);
  }
  @media (prefers-reduced-motion: no-preference) {
    .countdown__live-dot {
      animation: live-pulse 1.8s ease-out infinite;
    }
  }
  @keyframes live-pulse {
    0% {
      box-shadow: 0 0 0 0 rgba(232, 112, 42, 0.6);
    }
    100% {
      box-shadow: 0 0 0 12px rgba(232, 112, 42, 0);
    }
  }
  .countdown__note {
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--border);
    padding-top: 16px;
  }
  .countdown__note :global(svg) {
    flex-shrink: 0;
  }
  .countdown__note p {
    font-size: 15px;
    line-height: 1.45;
    color: var(--muted-strong);
  }
  /* Phones: get to the point within about one screen. Tighter type, a wide short photo instead of a tall
     one, and a compact countdown card tucked over its lower edge. */
  @media (max-width: 600px) {
    .hero {
      padding-block: 20px 64px;
    }
    .hero__inner {
      gap: 26px;
    }
    .hero__copy {
      gap: 14px;
    }
    .hero__badge {
      font-size: 12px;
      padding: 6px 12px;
    }
    .hero__title {
      font-size: clamp(36px, 10.5vw, 44px);
    }
    .hero__text {
      font-size: 16.5px;
      line-height: 1.5;
    }
    .hero__meta {
      font-size: 15px;
      gap: 6px 16px;
    }
    .hero__actions :global(.btn) {
      flex: 1 1 0;
      justify-content: center;
    }
    .hero__photo {
      aspect-ratio: 16 / 9;
      max-width: none;
      transform: none;
      border-radius: var(--radius-card);
    }
    .hero__side--photo .countdown {
      margin: -28px 12px 0;
      max-width: none;
      padding: 16px 18px;
      gap: 10px;
      transform: none;
    }
    .countdown__label {
      font-size: 12px;
    }
    .countdown__cell {
      padding: 8px 6px;
    }
    .countdown__num {
      font-size: 30px;
    }
    .countdown__tbc {
      font-size: 18px;
    }
    .countdown__note {
      gap: 12px;
    }
    .countdown__note :global(svg) {
      width: 36px;
      height: 36px;
      flex-shrink: 0;
    }
    .countdown__note p {
      font-size: 13.5px;
    }
  }
</style>
