---
// Four photo tiles leading to the main sections (replaces the long homepage sections).
// Photos always show when they were taken.
import { url, thumb, thumbSet } from '../../lib/url';
import { getAlbums } from '../../lib/albums';

// Counted from the albums at every build, so it stays right as albums are added
const albumCount = (await getAlbums()).length;

const tiles = [
  {
    title: 'Photos',
    text: `${albumCount} albums going back to 2001`,
    href: '/photos/',
    img: '/uploads/albums/2012-08-07-duck-race-carnival-2012/010.jpg',
    when: 'Aug 2012',
  },
  {
    title: 'Races',
    text: "Wolf's Pit and Tour of Bradwell results",
    href: '/races/',
    img: '/uploads/albums/2022-02-08-wolfs-pit-fell-race-2022/001.jpg',
    when: 'Before 2022',
  },
  {
    title: 'Our story',
    text: 'From the first duck race in 1999',
    href: '/our-story/',
    img: '/uploads/albums/2001-12-12-first-ever-bradda-dads-pensioners-christmas-lunch-wednesday/001.jpg',
    when: 'Dec 2001',
  },
  {
    title: 'Where the money goes',
    text: 'The groups and projects we help',
    href: '/where-the-money-goes/',
    img: '/uploads/albums/2011-07-10-9-7-11-opening-of-the-multi-use-games-area-muga/001.jpg',
    when: 'Jul 2011',
  },
];
---

<section class="explore" aria-labelledby="explore-title">
  <div class="container">
    <h2 id="explore-title" class="section-title explore__title">Explore</h2>
    <ul class="explore__grid" role="list">
      {
        tiles.map((t) => (
          <li>
            <a class="tile" href={url(t.href)}>
              <span class="tile__media">
                <img src={thumb(t.img)} srcset={thumbSet(t.img)} sizes="(max-width: 600px) 50vw, 320px" alt="" loading="lazy" decoding="async" width="480" height="320" />
                <span class="tile__date">{t.when}</span>
              </span>
              <span class="tile__body">
                <span class="tile__name">{t.title}</span>
                <span class="tile__text">{t.text}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .explore {
    padding-bottom: var(--section-pad);
  }
  .explore__title {
    margin-bottom: 24px;
  }
  .explore__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 18px;
  }
  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--green);
    color: var(--white);
    text-decoration: none;
  }
  .tile:hover {
    color: var(--white);
  }
  .tile__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 2;
    overflow: hidden;
  }
  .tile__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .tile__date {
    position: absolute;
    top: 10px;
    left: 10px;
    background: rgba(16, 36, 26, 0.85);
    color: var(--white);
    font-size: 12px;
    font-weight: 600;
    padding: 3px 9px;
    border-radius: var(--radius-pill);
  }
  .tile__body {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 16px 18px 18px;
  }
  .tile__name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.1;
  }
  .tile__name::after {
    content: ' →';
    color: var(--yellow);
  }
  .tile__text {
    font-size: 15px;
    color: var(--on-dark-soft);
  }
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .tile {
      transition: transform 0.18s ease, box-shadow 0.18s ease;
    }
    .tile img {
      transition: transform 0.4s ease;
    }
    .tile:hover {
      transform: translateY(-3px);
      box-shadow: 0 14px 30px rgba(16, 36, 26, 0.18);
    }
    .tile:hover img {
      transform: scale(1.05);
    }
  }
  /* Phones: two tiles per row, so the four fit in about one screen */
  @media (max-width: 600px) {
    .explore__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }
    .tile__media {
      aspect-ratio: 1 / 1;
    }
    .tile__body {
      padding: 12px 14px 14px;
    }
    .tile__name {
      font-size: 18px;
    }
    .tile__text {
      font-size: 13px;
      line-height: 1.35;
    }
  }
</style>
