---
// "The winners are in!" link on the homepage for two weeks after a duck race's winners are added
// (src/content/duck-winners/, editor form "Duck race winners"). The site rebuilds daily, so it goes by itself.
import { getCollection } from 'astro:content';
import { url } from '../../lib/url';

const DAYS = 14;
const now = Date.now();
const latest = (await getCollection('duckWinners')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime())[0];
const age = latest ? now - latest.data.date.getTime() : Infinity;
const show = latest && age >= 0 && age < DAYS * 864e5;
---

{
  show && (
    <div class="container winners-wrap"><p class="winners-news">
      <span class="winners-news__badge">Results</span>
      <a href={url(`/events/duck-race/winners/#race-${latest.id}`)}>
        The {latest.data.race} duck race {latest.data.date.getFullYear()} winners are in! See if your duck won →
      </a>
    </p></div>
  )
}

<style>
  .winners-wrap {
    padding-top: 24px;
  }
  .winners-news {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin-block: 0 24px;
    padding: 14px 20px;
    border-radius: 18px;
    background: var(--yellow-panel);
    font-weight: 600;
  }
  .winners-news a {
    color: var(--green);
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  .winners-news__badge {
    background: var(--green);
    color: var(--white);
    border-radius: 999px;
    padding: 2px 10px;
    font-size: 13px;
  }
</style>
