---
import { getCollection } from 'astro:content';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
// Newest proper albums (3+ photos), so single posters/logos don't fill the homepage
const all = (await getCollection('albums')).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const albums = [...all.filter((a) => a.data.photos.length >= 3), ...all.filter((a) => a.data.photos.length < 3)].slice(0, 4);
// Placeholder tile colours for albums that don't have photos yet
const swatches = [
  ['#8fb7d6', '#F6C343', '#cfe1ee'],
  ['#3a2a1c', '#7a4a1f', '#F6C343'],
  ['#5b7a5a', '#8aa385', '#dfe8df'],
  ['#b3473a', '#dfe8df', '#fbe9b7'],
];
const isExternal = /^https?:/.test(site.sharePhotosUrl);
---

<section id="photos" class="photos" aria-labelledby="photos-title">
  <div class="container photos__inner">
    <div class="photos__head">
      <div class="photos__intro">
        <h2 id="photos-title" class="section-title">Photos</h2>
        <p>Albums from every event. Took some good ones? Send them in.</p>
      </div>
      <a class="btn btn--green btn--share" href={url(site.sharePhotosUrl)} rel={isExternal ? 'noopener' : undefined}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 20V9M7 14l5-5 5 5M5 4h14" />
        </svg>
        Share your photos
      </a>
    </div>
    {
      albums.length === 0 ? (
        <p class="photos__empty">Albums coming soon.</p>
      ) : (
        <ul class="photos__grid" role="list">
          {albums.map((al, i) => {
            const sw = swatches[i % swatches.length];
            const pics = al.data.photos;
            const cover = al.data.cover ? { src: al.data.cover, alt: al.data.coverAlt ?? '' } : pics[0];
            const rest = pics.filter((p) => p.src !== cover?.src);
            const more = Math.max(0, pics.length - 2 - (al.data.cover ? 0 : 1));
            return (
              <li>
                <a class="album" href={url(`/photos/${al.id}/`)}>
                  <div class="album__tiles" aria-hidden="true">
                    {cover ? (
                      <img class="album__tile album__tile--main" src={url(cover.src)} alt="" loading="lazy" decoding="async" width="400" height="150" />
                    ) : (
                      <div class="album__tile album__tile--main" style={`background:${sw[0]}`} />
                    )}
                    {rest[0] ? (
                      <img class="album__tile" src={url(rest[0].src)} alt="" loading="lazy" decoding="async" width="200" height="80" />
                    ) : (
                      <div class="album__tile" style={`background:${sw[1]}`} />
                    )}
                    <div class="album__tile album__tile--more" style={`background:${sw[2]}`}>
                      {more > 0 ? `+${more}` : ''}
                    </div>
                  </div>
                  <span class="album__name">{al.data.title}</span>
                  <span class="album__count">{pics.length === 0 ? 'Photos coming soon' : `${pics.length} photo${pics.length === 1 ? '' : 's'}`}</span>
                </a>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>
</section>

<style>
  .photos {
    padding-block: 80px;
  }
  .photos__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .photos__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .photos__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .photos__intro p,
  .photos__empty {
    font-size: 17px;
    color: var(--muted);
  }
  .btn--share {
    min-height: 50px;
    padding: 0 22px;
    font-size: 16px;
  }
  .photos__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(250px, 100%), 1fr));
    gap: 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .album {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
    color: var(--text);
  }
  .album:hover {
    color: var(--text);
  }
  .album:hover .album__name {
    text-decoration: underline;
  }
  .album__tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
    border-radius: 18px;
    overflow: hidden;
    margin-bottom: 6px;
  }
  .album__tile {
    width: 100%;
    height: 80px;
    object-fit: cover;
  }
  .album__tile--main {
    grid-column: span 2;
    height: 150px;
  }
  .album__tile--more {
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    color: var(--text);
  }
  .album__name {
    font-weight: 600;
    font-size: 17px;
  }
  .album__count {
    font-size: 14px;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .photos {
      padding-block: 56px;
    }
  }
</style>
