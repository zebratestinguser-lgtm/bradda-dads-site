---
import AlbumCard from '../AlbumCard.astro';
import { getAlbums } from '../../lib/albums';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
// Newest proper albums (3+ photos), so single posters/logos don't fill the homepage
const all = await getAlbums();
const albums = [...all.filter((a) => a.data.photos.length >= 3), ...all.filter((a) => a.data.photos.length < 3)].slice(0, 4);
const isExternal = /^https?:/.test(site.sharePhotosUrl);
---

<section id="photos" class="photos" aria-labelledby="photos-title">
  <div class="container photos__inner">
    <div class="photos__head">
      <div class="photos__intro">
        <h2 id="photos-title" class="section-title">Photos</h2>
        <p>Albums from every event. Took some good ones? Send them in.</p>
      </div>
      <div class="photos__actions">
        <a class="link-arrow" href={url('/photos/')}>All albums →</a>
        <a class="btn btn--green btn--share" href={url(site.sharePhotosUrl)} rel={isExternal ? 'noopener' : undefined}>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20V9M7 14l5-5 5 5M5 4h14" />
          </svg>
          Share your photos
        </a>
      </div>
    </div>
    {
      albums.length === 0 ? (
        <p class="photos__empty">Albums coming soon.</p>
      ) : (
        <ul class="card-grid" role="list">
          {albums.map((al, i) => (
            <li>
              <AlbumCard album={al} index={i} />
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>

<style>
  .photos {
    padding-block: 80px;
  }
  .photos__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .photos__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .photos__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .photos__intro p,
  .photos__empty {
    font-size: 17px;
    color: var(--muted);
  }
  .photos__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 20px;
  }
  .btn--share {
    min-height: 50px;
    padding: 0 22px;
    font-size: 16px;
  }
  @media (max-width: 600px) {
    .photos {
      padding-block: 56px;
    }
  }
</style>
