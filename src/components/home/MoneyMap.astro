---
import { getCollection } from 'astro:content';
import { getSite } from '../../lib/site';
import { url } from '../../lib/url';

const site = await getSite();
const funded = (await getCollection('funded')).sort((a, b) => a.data.name.localeCompare(b.data.name));
const pins = funded.map((f) => ({
  name: f.data.name,
  lat: f.data.lat,
  lng: f.data.lng,
  summary: f.data.summary,
  year: f.data.year,
  confirmed: f.data.locationConfirmed,
}));
---

<section id="map" class="money" aria-labelledby="money-title">
  <div class="container money__inner">
    <div class="money__copy">
      <p class="eyebrow money__eyebrow">Your money at work</p>
      <h2 id="money-title" class="section-title">See where the money goes</h2>
      <p class="money__text">
        From stage lights at the school to grants for local groups, every pound raised stays in the village. Tap a pin to see what it paid for.
      </p>
      <div class="stats">
        <div class="stat">
          <span class="stat__num">£{site.totalRaised}</span>
          <span class="stat__label">raised since 1999</span>
        </div>
        <div class="stat">
          <span class="stat__num">{site.groupsHelped}</span>
          <span class="stat__label">groups and projects helped</span>
        </div>
      </div>
      <a class="link-arrow" href={url('/where-the-money-goes/')}>Open the full map →</a>
    </div>
    <div class="money__map-col">
      <div class="map" data-map={JSON.stringify(pins)} aria-label="Map of Bradwell with pins marking projects funded by Bradda Dads" role="region">
        <noscript><p class="map__noscript">The map needs JavaScript. The list below shows every project.</p></noscript>
      </div>
      <!-- Text list: an accessible alternative to the map -->
      <ul class="pin-list" role="list" aria-label="Projects on the map">
        {
          pins.map((p) => (
            <li>
              <span class="pin-list__dot" aria-hidden="true" />
              <span>
                <strong>{p.name}</strong> · {p.year}
              </span>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<script>
  // Leaflet loads only when the map scrolls near the screen (keeps the page fast).
  type Pin = { name: string; lat: number; lng: number; summary: string; year: string; confirmed: boolean };

  async function init(el: HTMLElement) {
    const [{ default: L }] = await Promise.all([import('leaflet'), import('leaflet/dist/leaflet.css')]);
    const pins: Pin[] = JSON.parse(el.dataset.map!);
    const map = L.map(el, { scrollWheelZoom: false });
    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors',
    }).addTo(map);
    const icon = L.divIcon({ className: 'bd-pin', html: '<span></span>', iconSize: [28, 28], iconAnchor: [14, 14], popupAnchor: [0, -14] });
    const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]!);
    const markers = pins.map((p) =>
      L.marker([p.lat, p.lng], { icon, title: p.name, alt: p.name, keyboard: true })
        .bindPopup(
          `<strong>${esc(p.name)}</strong><br>${esc(p.year)}<br>${esc(p.summary)}` +
            (p.confirmed ? '' : '<br><em>Map position to be confirmed.</em>'),
        )
        .addTo(map),
    );
    if (markers.length) map.fitBounds(L.featureGroup(markers).getBounds().pad(0.6), { maxZoom: 16 });
    else map.setView([53.3286, -1.74], 15); // Bradwell
  }

  document.querySelectorAll<HTMLElement>('[data-map]').forEach((el) => {
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          init(el);
        }
      },
      { rootMargin: '300px' },
    );
    io.observe(el);
  });
</script>

<style>
  .money {
    padding-block: var(--section-pad);
    background: var(--surface);
  }
  .money__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .money__copy {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .money__eyebrow {
    color: var(--green);
  }
  .money__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 6px;
  }
  .stat {
    background: var(--white);
    border-radius: 18px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .stat__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 30px;
    color: var(--green);
    overflow-wrap: anywhere;
  }
  .stat__label {
    font-size: 14px;
    color: var(--muted);
  }
  .money__map-col {
    flex: 999 1 520px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .map {
    height: 420px;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface-green);
    z-index: 0;
  }
  .map__noscript {
    padding: 24px;
    color: var(--muted);
  }
  .map :global(.bd-pin span) {
    display: block;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--orange);
    border: 3px solid var(--white);
    box-shadow: 0 4px 10px rgba(0, 0, 0, 0.25);
  }
  .map :global(.leaflet-popup-content) {
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.45;
  }
  .pin-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 18px;
    font-size: 14px;
    color: var(--muted-strong);
  }
  .pin-list li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .pin-list__dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--orange);
  }
  @media (max-width: 600px) {
    .map {
      height: 320px;
    }
  }
</style>
