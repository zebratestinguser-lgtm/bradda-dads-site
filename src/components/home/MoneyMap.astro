---
import FundedMap from '../FundedMap.astro';
import { getSite } from '../../lib/site';
import { isPlaceholder } from '../../lib/events';
import { url } from '../../lib/url';

const site = await getSite();
---

<section id="map" class="money" aria-labelledby="money-title">
  <div class="container money__inner">
    <div class="money__copy">
      <p class="eyebrow money__eyebrow">Your money at work</p>
      <h2 id="money-title" class="section-title">See where the money goes</h2>
      <p class="money__text">
        From stage lights at the school to grants for local groups, every pound raised stays in the village. Tap a pin to see what it paid for.
      </p>
      {
        (!isPlaceholder(site.totalRaised) || !isPlaceholder(site.groupsHelped)) && (
          <div class="stats">
            {!isPlaceholder(site.totalRaised) && (
              <div class="stat">
                <span class="stat__num">£{site.totalRaised}</span>
                <span class="stat__label">raised since 1999</span>
              </div>
            )}
            {!isPlaceholder(site.groupsHelped) && (
              <div class="stat">
                <span class="stat__num">{site.groupsHelped}</span>
                <span class="stat__label">groups and projects helped</span>
              </div>
            )}
          </div>
        )
      }
      <a class="link-arrow" href={url('/where-the-money-goes/')}>Open the full map →</a>
    </div>
    <div class="money__map-col">
      <FundedMap />
    </div>
  </div>
</section>

<style>
  .money {
    padding-block: var(--section-pad);
    background: var(--surface);
  }
  .money__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .money__copy {
    flex: 1 1 360px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .money__eyebrow {
    color: var(--green);
  }
  .money__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--muted-strong);
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
    margin-top: 6px;
  }
  .stat {
    background: var(--white);
    border-radius: 18px;
    padding: 18px;
    display: flex;
    flex-direction: column;
  }
  .stat__num {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 30px;
    color: var(--green);
    overflow-wrap: anywhere;
  }
  .stat__label {
    font-size: 14px;
    color: var(--muted);
  }
  .money__map-col {
    flex: 999 1 520px;
    min-width: 0;
  }
</style>
