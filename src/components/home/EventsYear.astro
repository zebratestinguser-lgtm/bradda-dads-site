---
import EventCard from '../EventCard.astro';
import type { EventEntry } from '../../lib/events';
import { url } from '../../lib/url';

interface Props {
  events: EventEntry[];
  nextId?: string;
}
const { events, nextId } = Astro.props;
---

<section id="events" class="events" aria-labelledby="events-title">
  <div class="container events__inner">
    <div class="events__head">
      <div class="events__intro">
        <h2 id="events-title" class="section-title">The Bradda Dads year</h2>
        <p>The big dates, all run by volunteer dads, all for the village.</p>
      </div>
      <div class="events__links">
        <a class="link-arrow" href={url('/events/')}>All events →</a>
        <a class="link-arrow" href={url('/events.ics')}>Add to your calendar →</a>
      </div>
    </div>
    <ul class="events__grid" role="list">
      {events.map((e) => <li><EventCard event={e} isNext={e.id === nextId} /></li>)}
    </ul>
  </div>
</section>

<style>
  .events {
    padding-block: var(--section-pad);
  }
  .events__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }
  .events__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
  }
  .events__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .events__intro p {
    font-size: 17px;
    color: var(--muted);
  }
  .events__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }
  .events__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr));
    gap: 20px;
  }
</style>
