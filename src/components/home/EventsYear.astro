---
// "The Bradda Dads year": a swipeable strip of event cards (scroll-snap).
// Phones: swipe. Desktop: arrow buttons or trackpad. Events come in rolling-year order from getEvents():
// whatever is on now first, then upcoming, then this year's finished events (as next year's).
// It loops endlessly: after the last event a "Round again" marker leads into the first again. No auto-play (moving content is hard
// to read and an accessibility problem).
import EventCard from '../EventCard.astro';
import DuckLogo from '../DuckLogo.astro';
import type { EventEntry } from '../../lib/events';
import { url } from '../../lib/url';

interface Props {
  events: EventEntry[];
  nextId?: string;
}
const { events, nextId } = Astro.props;
---

<section id="events" class="events" aria-labelledby="events-title">
  <div class="container events__inner">
    <div class="events__head">
      <div class="events__intro">
        <h2 id="events-title" class="section-title">The Bradda Dads year</h2>
        <p>The big dates, all run by volunteer dads, all for the village.</p>
      </div>
      <div class="events__tools">
        <div class="events__links">
          <a class="link-arrow" href={url('/events/')}>All events →</a>
          <a class="link-arrow" href={url('/events.ics')}>Add to your calendar →</a>
        </div>
        <div class="carousel-btns" data-carousel-btns hidden>
          <button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous events" aria-controls="events-strip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="carousel-btn" data-dir="1" aria-label="Next events" aria-controls="events-strip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="strip-wrap">
    <ul id="events-strip" class="strip" role="list" tabindex="0" aria-label="Events through the year, scroll sideways for more" data-strip>
      {
        events.map((e) => (
          <li class="strip__item" data-next={e.id === nextId ? 'true' : undefined}>
            <EventCard event={e} isNext={e.id === nextId} />
          </li>
        ))
      }
    </ul>
    <template data-loop-marker>
      <li class="strip__loop" aria-hidden="true">
        <span class="loop__duck"><DuckLogo size={40} /></span>
        <span class="loop__title">Round again</span>
        <span class="loop__text">into next year</span>
        <svg class="loop__arrow" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M3 12a9 9 0 0 1 15.5-6.2L21 8" />
          <path d="M21 3v5h-5" />
          <path d="M21 12a9 9 0 0 1-15.5 6.2L3 16" />
          <path d="M3 21v-5h5" />
        </svg>
      </li>
    </template>
  </div>
  <div class="container">
    <div class="strip-dots" data-dots aria-hidden="true">
      {events.map(() => <span class="strip-dot" />)}
    </div>
  </div>
</section>

<script>
  // Endless loop that shows it has looped: the cards are copied once before and once after the real
  // ones, with a "Round again" marker between each lap. The strip quietly jumps back to the matching real
  // card when it drifts into a copy, so it keeps going round instead of springing back to the start.
  // Copies and markers are hidden from screen readers and skipped by Tab (each event is met once).
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const section = strip.closest('section')!;
    const btns = section.querySelector<HTMLElement>('[data-carousel-btns]');
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('.carousel-btn')];
    const dots = [...section.querySelectorAll<HTMLElement>('.strip-dot')];
    const tpl = section.querySelector<HTMLTemplateElement>('template[data-loop-marker]');
    const originals = [...strip.querySelectorAll<HTMLElement>('.strip__item')];
    const n = originals.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Everything fits on screen (or a single card): no need to scroll, loop or show buttons
    if (n < 2 || !tpl || strip.scrollWidth <= strip.clientWidth + 2) return;
    if (btns) btns.hidden = false;

    originals.forEach((o, i) => (o.dataset.i = String(i)));
    const marker = () => tpl.content.firstElementChild!.cloneNode(true) as HTMLElement;
    const copy = (item: HTMLElement) => {
      const c = item.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      // Still clickable (a copy can be the card on screen), but skipped by Tab and screen readers
      c.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
      c.removeAttribute('data-next');
      return c;
    };
    // Laps: [marker, copies] [marker, real cards] [marker, copies]
    const lapBefore = [marker(), ...originals.map(copy)];
    strip.prepend(...lapBefore);
    originals[0].before(marker());
    strip.append(marker(), ...originals.map(copy));

    const first = strip.firstElementChild as HTMLElement;
    const items = () => [...strip.children] as HTMLElement[];
    const pos = (el: HTMLElement) => el.offsetLeft - first.offsetLeft; // scroll position that lines el up at the start
    const lap = () => originals[0].offsetLeft - lapBefore[1].offsetLeft; // width of one lap (marker + cards)
    const home = () => pos(originals[0]);

    const jump = (to: number) => {
      strip.style.scrollSnapType = 'none'; // stop snapping fighting the instant jump
      strip.style.scrollBehavior = 'auto';
      strip.scrollLeft = to;
      strip.style.scrollSnapType = '';
      strip.style.scrollBehavior = '';
    };
    // Back into the real lap if we've drifted more than half a lap either way (looks identical)
    const recentre = () => {
      const x = strip.scrollLeft;
      const h = home();
      const w = lap();
      if (x < h - w / 2) jump(x + w);
      else if (x > h + w / 2) jump(x - w);
    };
    // The item currently lined up at the start of the strip
    const current = () => {
      const x = strip.scrollLeft;
      return items().reduce((best, el) => (Math.abs(pos(el) - x) < Math.abs(pos(best) - x) ? el : best));
    };
    const updateDots = () => {
      const el = current();
      const i = el.dataset.i ?? (el.nextElementSibling as HTMLElement | null)?.dataset.i ?? '0';
      dots.forEach((d, k) => d.classList.toggle('is-active', String(k) === i));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        recentre();
        const el = current();
        const target = (Number(b.dataset.dir) > 0 ? el.nextElementSibling : el.previousElementSibling) as HTMLElement | null;
        if (target) strip.scrollTo({ left: pos(target), behavior: reduce ? 'auto' : 'smooth' });
      }),
    );
    let settle: number | undefined;
    strip.addEventListener(
      'scroll',
      () => {
        updateDots();
        // Fallback for browsers without "scrollend": recentre once scrolling pauses
        clearTimeout(settle);
        settle = window.setTimeout(recentre, 160);
      },
      { passive: true },
    );
    strip.addEventListener('scrollend', recentre);
    window.addEventListener('resize', () => {
      jump(home());
      updateDots();
    });

    // Events are already in rolling-year order (what's on now first), so start on the first real card
    jump(home());
    updateDots();
  });
</script>

<style>
  .events {
    padding-block: var(--section-pad);
    overflow: hidden;
  }
  .events__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .events__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 28px;
  }
  .events__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .events__intro p {
    font-size: 17px;
    color: var(--muted);
  }
  .events__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }
  .events__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }
  .carousel-btns {
    display: flex;
    gap: 8px;
  }
  .carousel-btns[hidden] {
    display: none;
  }
  .carousel-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--green);
    background: var(--white);
    color: var(--green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .carousel-btn:hover:not(:disabled) {
    background: var(--green);
    color: var(--white);
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* The strip lines up with the page content but can scroll out to the screen edges */
  .strip-wrap {
    --edge: max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter)));
  }
  .strip {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 6px var(--edge) 18px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip:focus-visible {
    outline-offset: -3px;
  }
  .strip__item {
    flex: 0 0 min(300px, 78vw);
    scroll-snap-align: start;
    display: flex;
  }
  .strip__item > :global(*) {
    width: 100%;
  }
  /* "Round again" marker between laps of the loop */
  .strip__loop {
    flex: 0 0 150px;
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 6px;
    text-align: center;
    border: 2px dashed var(--brook);
    border-radius: var(--radius-card);
    color: var(--green);
    padding: 16px 12px;
  }
  .loop__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
    line-height: 1.1;
  }
  .loop__text {
    font-size: 14px;
    color: var(--muted);
  }
  .loop__arrow {
    color: var(--green);
    margin-top: 4px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .strip {
      scroll-behavior: smooth;
    }
  }

  .strip-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }
  .strip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background-color 0.2s ease, width 0.2s ease;
  }
  .strip-dot.is-active {
    background: var(--green);
    width: 22px;
    border-radius: 999px;
  }
  /* Phones: swipe instead of arrow buttons (the next card peeks in, and the dots show where you are) */
  @media (max-width: 600px) {
    .carousel-btns {
      display: none !important;
    }
    .events__links {
      gap: 8px 18px;
      font-size: 15px;
    }
    .strip {
      gap: 14px;
    }
    .strip__item {
      flex-basis: 82vw;
    }
    .strip__loop {
      flex-basis: 128px;
    }
  }
</style>
