---
// "The Bradda Dads year": a swipeable strip of event cards (scroll-snap).
// Phones: swipe. Desktop: arrow buttons or trackpad. Events come in rolling-year order from getEvents():
// whatever is on now first, then upcoming, then this year's finished events (as next year's).
// It loops endlessly (after the last event comes the first again). No auto-play (moving content is hard
// to read and an accessibility problem).
import EventCard from '../EventCard.astro';
import type { EventEntry } from '../../lib/events';
import { url } from '../../lib/url';

interface Props {
  events: EventEntry[];
  nextId?: string;
}
const { events, nextId } = Astro.props;
---

<section id="events" class="events" aria-labelledby="events-title">
  <div class="container events__inner">
    <div class="events__head">
      <div class="events__intro">
        <h2 id="events-title" class="section-title">The Bradda Dads year</h2>
        <p>The big dates, all run by volunteer dads, all for the village.</p>
      </div>
      <div class="events__tools">
        <div class="events__links">
          <a class="link-arrow" href={url('/events/')}>All events →</a>
          <a class="link-arrow" href={url('/events.ics')}>Add to your calendar →</a>
        </div>
        <div class="carousel-btns" data-carousel-btns hidden>
          <button type="button" class="carousel-btn" data-dir="-1" aria-label="Previous events" aria-controls="events-strip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6"></path></svg>
          </button>
          <button type="button" class="carousel-btn" data-dir="1" aria-label="Next events" aria-controls="events-strip">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6"></path></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <div class="strip-wrap">
    <ul id="events-strip" class="strip" role="list" tabindex="0" aria-label="Events through the year, scroll sideways for more" data-strip>
      {
        events.map((e) => (
          <li class="strip__item" data-next={e.id === nextId ? 'true' : undefined}>
            <EventCard event={e} isNext={e.id === nextId} />
          </li>
        ))
      }
    </ul>
  </div>
  <div class="container">
    <div class="strip-dots" data-dots aria-hidden="true">
      {events.map(() => <span class="strip-dot" />)}
    </div>
  </div>
</section>

<script>
  // Endless loop: the cards are copied once before and once after the real ones, and the strip quietly
  // jumps back to the matching real card whenever it drifts into a copy. So "next" after the last event
  // comes round to the first again, like the year itself. The copies are hidden from screen readers
  // and skipped by the Tab key, so keyboard and screen reader users meet each event once.
  document.querySelectorAll<HTMLElement>('[data-strip]').forEach((strip) => {
    const section = strip.closest('section')!;
    const btns = section.querySelector<HTMLElement>('[data-carousel-btns]');
    const buttons = [...section.querySelectorAll<HTMLButtonElement>('.carousel-btn')];
    const dots = [...section.querySelectorAll<HTMLElement>('.strip-dot')];
    const originals = [...strip.querySelectorAll<HTMLElement>('.strip__item')];
    const n = originals.length;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Everything fits on screen (or a single card): no need to scroll, loop or show buttons
    if (n < 2 || strip.scrollWidth <= strip.clientWidth + 2) return;
    if (btns) btns.hidden = false;

    const copy = (item: HTMLElement) => {
      const c = item.cloneNode(true) as HTMLElement;
      c.setAttribute('aria-hidden', 'true');
      // Still clickable (a copy can be the card on screen), but skipped by Tab and screen readers
      c.querySelectorAll('a, button').forEach((el) => el.setAttribute('tabindex', '-1'));
      c.removeAttribute('data-next');
      return c;
    };
    strip.prepend(...originals.map(copy));
    strip.append(...originals.map(copy));

    const step = () => originals[1].offsetLeft - originals[0].offsetLeft;
    const setWidth = () => step() * n;
    // Scroll position of the first real card (the copies before it are exactly one set wide)
    const home = () => setWidth();

    const jump = (to: number) => {
      strip.style.scrollSnapType = 'none'; // stop snapping fighting the instant jump
      strip.scrollLeft = to;
      strip.style.scrollSnapType = '';
    };
    // Back into the real set if we've drifted half a set into either copy
    const recentre = () => {
      const x = strip.scrollLeft;
      const w = setWidth();
      if (x < w * 0.5) jump(x + w);
      else if (x > w * 1.5) jump(x - w);
    };
    const updateDots = () => {
      const i = (((Math.round((strip.scrollLeft - home()) / step())) % n) + n) % n;
      dots.forEach((d, k) => d.classList.toggle('is-active', k === i));
    };

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        recentre();
        strip.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: reduce ? 'auto' : 'smooth' });
      }),
    );
    let settle: number | undefined;
    strip.addEventListener(
      'scroll',
      () => {
        updateDots();
        // Fallback for browsers without "scrollend": recentre once scrolling pauses
        clearTimeout(settle);
        settle = window.setTimeout(recentre, 160);
      },
      { passive: true },
    );
    strip.addEventListener('scrollend', recentre);
    window.addEventListener('resize', () => {
      jump(home());
      updateDots();
    });

    // Events are already in rolling-year order (what's on now first), so start on the first real card
    jump(home());
    updateDots();
  });
</script>

<style>
  .events {
    padding-block: var(--section-pad);
    overflow: hidden;
  }
  .events__inner {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  .events__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    margin-bottom: 28px;
  }
  .events__intro {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .events__intro p {
    font-size: 17px;
    color: var(--muted);
  }
  .events__tools {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 22px;
  }
  .events__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 22px;
  }
  .carousel-btns {
    display: flex;
    gap: 8px;
  }
  .carousel-btns[hidden] {
    display: none;
  }
  .carousel-btn {
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 2px solid var(--green);
    background: var(--white);
    color: var(--green);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
  }
  .carousel-btn:hover:not(:disabled) {
    background: var(--green);
    color: var(--white);
  }
  .carousel-btn:disabled {
    opacity: 0.35;
    cursor: default;
  }

  /* The strip lines up with the page content but can scroll out to the screen edges */
  .strip-wrap {
    --edge: max(var(--gutter), calc((100vw - var(--max-width)) / 2 + var(--gutter)));
  }
  .strip {
    position: relative;
    list-style: none;
    margin: 0;
    padding: 6px var(--edge) 18px;
    display: flex;
    gap: 20px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .strip::-webkit-scrollbar {
    display: none;
  }
  .strip:focus-visible {
    outline-offset: -3px;
  }
  .strip__item {
    flex: 0 0 min(300px, 78vw);
    scroll-snap-align: start;
    display: flex;
  }
  .strip__item > :global(*) {
    width: 100%;
  }
  @media (prefers-reduced-motion: no-preference) {
    .strip {
      scroll-behavior: smooth;
    }
  }

  .strip-dots {
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 4px;
  }
  .strip-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--border);
    transition: background-color 0.2s ease, width 0.2s ease;
  }
  .strip-dot.is-active {
    background: var(--green);
    width: 22px;
    border-radius: 999px;
  }
</style>
