---
import { getWording } from '../../lib/wording';
const w = await getWording('home'); // Page wording form
// Only shown while the Christmas card event's status is "open".
import { getEntry } from 'astro:content';
import { isOpen } from '../../lib/events';
import { url } from '../../lib/url';

const card = await getEntry('events', 'christmas-card');
// Shown while entries are open; hides itself after entriesClose (the site rebuilds daily)
const show = card ? isOpen(card) : false;
---

{
  show && card && (
    <section id="card" class="card-wrap" aria-labelledby="card-title">
      <div class="container">
        <div class="card-banner">
          <div class="card-banner__copy">
            <p class="eyebrow card-banner__eyebrow">Open now</p>
            <h2 id="card-title" class="section-title">{card.data.heroTitle ?? card.data.name}</h2>
            <p class="card-banner__text">{card.data.heroText ?? card.data.summary}</p>
            <div class="card-banner__actions">
              <a class="btn btn--green" href={url(card.data.ctaUrl)}>
                {card.data.ctaLabel}
                {card.data.price && ` · ${card.data.price}`}
              </a>
              {card.data.heroNote && <span>{card.data.heroNote}</span>}
            </div>
          </div>
          <div class="card-banner__art" aria-hidden="true">
            <div class="xmas-card">
              <div class="xmas-card__title">{w.text('cardArtTitle')}</div>
              <div class="xmas-card__rule" />
              <div class="xmas-card__names">{w.text('cardArtNames')}</div>
            </div>
          </div>
        </div>
      </div>
    </section>
  )
}

<style>
  .card-wrap {
    padding-bottom: var(--section-pad);
  }
  .card-banner {
    background: var(--yellow-panel);
    border-radius: var(--radius-xl);
    padding: 48px;
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    align-items: center;
  }
  .card-banner__copy {
    flex: 999 1 460px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .card-banner__eyebrow {
    color: var(--yellow-ink);
  }
  .card-banner__text {
    font-size: 17px;
    line-height: 1.55;
    color: var(--yellow-body);
    max-width: 560px;
  }
  .card-banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    margin-top: 4px;
    font-size: 15px;
    color: var(--yellow-body);
  }
  .card-banner__art {
    flex: 1 1 280px;
    display: flex;
    justify-content: center;
  }
  .xmas-card {
    width: 260px;
    max-width: calc(100% - 24px); /* leaves room for the tilt so it stays inside the panel */
    height: 320px;
    background: var(--white);
    border-radius: var(--radius-sm);
    box-shadow: 0 18px 40px rgba(80, 60, 0, 0.18);
    transform: rotate(-3deg);
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .xmas-card__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 22px;
    color: var(--green);
  }
  .xmas-card__rule {
    height: 1px;
    background: var(--border);
  }
  .xmas-card__names {
    font-size: 12px;
    line-height: 1.7;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .card-banner {
      padding: 32px 22px;
    }
  }
</style>
