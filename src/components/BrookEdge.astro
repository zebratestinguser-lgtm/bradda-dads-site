---
// Wavy "brook" edge at the bottom of a green band, optionally with a duck bobbing on it.
// Place as the last child of a section with position: relative.
import DuckLogo from './DuckLogo.astro';

interface Props {
  /** Colour of whatever comes next (default white) */
  fill?: string;
  duck?: boolean;
}
const { fill = 'var(--white)', duck = false } = Astro.props;
---

<div class="brook" aria-hidden="true">
  {
    duck && (
      <span class="brook__duck">
        <DuckLogo size={44} />
      </span>
    )
  }
  <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
    <path d="M0 26 C180 6 360 44 540 26 S900 6 1080 24 S1320 44 1440 22 L1440 48 L0 48 Z" style={`fill:${fill}`}></path>
  </svg>
</div>

<style>
  .brook {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 40px;
    pointer-events: none;
  }
  .brook svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .brook__duck {
    position: absolute;
    left: 12%;
    bottom: 14px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brook__duck {
      animation: brook-bob 3.6s ease-in-out infinite;
    }
  }
  @keyframes brook-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-5px) rotate(4deg);
    }
  }
  @media (max-width: 600px) {
    .brook {
      height: 26px;
    }
    .brook__duck {
      bottom: 8px;
      left: auto;
      right: 8%;
    }
    .brook__duck :global(svg) {
      width: 34px;
      height: 34px;
    }
  }
</style>
