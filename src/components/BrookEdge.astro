---
// Wavy "brook" edge between two differently coloured sections, with a duck bobbing on it.
// Each wave gets 1–3 ducks of different sizes, either in a little family or spread out. Where they sit,
// how big they are and which way they face looks random but is worked out from the page address and the
// wave's seed, so it stays the same on refresh and between rebuilds.
//
//   <BrookEdge />                                    bottom of a section, next section is white
//   <BrookEdge position="top" fill="var(--white)" />  top of a section, previous section is white
//   <BrookEdge position="rise" fill="var(--surface)" />  sits ABOVE a section, in that section's own colour,
//                                                     spilling up into whatever comes before (used by <Band>)
//
// The parent section needs `position: relative` and a little extra padding on that edge (~40px).
// Give each wave on a page a different `seed` so its duck lands somewhere different.
import DuckLogo from './DuckLogo.astro';
import { seeded } from '../lib/seed';

interface Props {
  /** Which edge of the section the wave sits on */
  position?: 'top' | 'bottom' | 'rise';
  /** Colour of the neighbouring section (the one the wave "spills" into) */
  fill?: string;
  duck?: boolean;
  /** Makes this wave's ducks different from the other waves on the page */
  seed?: string;
}
const { position = 'bottom', fill = 'var(--water)', duck = true, seed = position } = Astro.props;
const rand = seeded(`${Astro.url.pathname.replace(/\/?$/, '/')}|${seed}`);

// 1 to 5 ducks of different sizes, either swimming together in a family or spread along the wave.
// Most waves have 1–3; 4 or 5 is a rare treat, and usually a mother duck with her ducklings.
// left = % along the wave; nudge = extra pixels (so a family stays tight at any screen width)
type Duck = { left: number; nudge: number; size: number; flipped: boolean; delay: number };
const roll = rand();
const count = roll < 0.35 ? 1 : roll < 0.63 ? 2 : roll < 0.83 ? 3 : roll < 0.93 ? 4 : 5;
const ducks: Duck[] = [];
let isFamily = false;
let familySpan = 0; // px from the first duck to the last
const familyId = `${Astro.url.pathname}|${seed}`;
const sizes = [52, 44, 38, 32, 28];
if (count > 1 && rand() < (count >= 4 ? 0.8 : 0.45)) {
  // A family: a big duck leading smaller ones, close together and all facing the same way
  const facingRight = rand() < 0.5; // the duck drawing faces right; flipped = facing left
  // Start far enough left that the whole family fits on a phone (bigger families start further left)
  const left = count >= 4 ? 5 + rand() * 25 : 8 + rand() * 42;
  const family: Duck[] = [];
  for (let i = 0; i < count; i++) {
    const size = i === 0 ? sizes[Math.floor(rand() * 2)] : sizes[2 + Math.floor(rand() * 3)];
    family.push({ left, nudge: 0, size, flipped: !facingRight, delay: -i * 0.45 - rand() * 0.3 });
  }
  // Laid out left to right; the leader (first, biggest) goes at the front, i.e. rightmost when facing right
  const order = facingRight ? [...family].reverse() : family;
  let nudge = 0;
  order.forEach((d, i) => {
    if (i > 0) nudge += (order[i - 1].size + d.size) / 2 + 4 + rand() * 10; // a little gap between neighbours
    d.nudge = nudge;
  });
  ducks.push(...family);
  isFamily = true;
  familySpan = nudge;
} else {
  // Spread out: one duck in each slice of the wave so they never overlap
  for (let i = 0; i < count; i++) {
    const slice = 82 / count;
    ducks.push({
      left: 6 + slice * i + rand() * (slice - 6),
      nudge: 0,
      size: sizes[Math.floor(rand() * sizes.length)],
      flipped: rand() < 0.4,
      delay: -rand() * 3.6,
    });
  }
}
---

<div class:list={['brook', `brook--${position}`]} aria-hidden="true">
  <svg viewBox="0 0 1440 48" preserveAspectRatio="none">
    <path d="M0 26 C180 6 360 44 540 26 S900 6 1080 24 S1320 44 1440 22 L1440 48 L0 48 Z" style={`fill:${fill}`}></path>
  </svg>
  {
    duck &&
      ducks.map((d) => (
        <span class:list={['brook__duck', { 'is-flipped': d.flipped }]} data-duck-size={d.size} data-family={isFamily ? familyId : undefined} data-nudge={isFamily ? Math.round(d.nudge) : undefined} data-span={isFamily ? Math.round(familySpan) : undefined} style={`left:calc(${d.left.toFixed(1)}% + ${Math.round(d.nudge)}px);--bob-delay:${d.delay.toFixed(2)}s`}>
          <span class="brook__bob">
            <DuckLogo size={d.size} />
          </span>
        </span>
      ))
  }
</div>

<style>
  .brook {
    position: absolute;
    left: 0;
    right: 0;
    height: 40px;
    pointer-events: none;
    z-index: 1;
    overflow-x: clip; /* a duck near the edge never makes the page scroll sideways */
  }
  .brook--bottom {
    bottom: -1px;
  }
  .brook--top {
    top: -1px;
  }
  .brook--rise {
    top: 1px;
    transform: translateY(-100%);
  }
  .brook--top svg {
    transform: scaleY(-1);
  }
  .brook svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .brook__duck {
    position: absolute;
    left: 12%;
    bottom: 14px;
    transform: translateX(-50%);
    transform-origin: bottom center;
  }
  .brook--top .brook__duck {
    bottom: 16px;
  }
  /* --swim is set by the script below while the page scrolls */
  .brook__duck {
    translate: var(--swim, 0px) 0;
  }
  .brook__duck.is-flipped .brook__bob {
    scale: -1 1;
  }
  .brook__bob {
    display: block;
  }
  @media (prefers-reduced-motion: no-preference) {
    .brook__bob {
      transition: scale 0.3s ease; /* turning round looks like a quick spin rather than a jump */
      animation: brook-bob 3.6s ease-in-out infinite;
      animation-delay: var(--bob-delay, 0s);
    }
  }
  @keyframes brook-bob {
    0%,
    100% {
      transform: translateY(0) rotate(-4deg);
    }
    50% {
      transform: translateY(-5px) rotate(4deg);
    }
  }
  @media (max-width: 600px) {
    .brook {
      height: 26px;
    }
    .brook__duck {
      bottom: 8px;
    }
    .brook--top .brook__duck {
      bottom: 10px;
    }
    .brook__duck {
      scale: 0.72; /* every duck a bit smaller on phones, keeping their different sizes */
    }
  }
</style>

<script>
  // Swimming ducks: while the page scrolls, each duck on screen paddles along its wave in the direction of
  // scrolling (down = to the right, up = to the left), facing the way it's going. When the page stops they
  // glide to a halt and just bob. A family turns round together, and its ducks swap places as they turn so
  // the big duck is always at the front. Nothing moves if the device asks for reduced motion.
  const ducks = [...document.querySelectorAll<HTMLElement>('.brook__duck')];
  const still = window.matchMedia('(prefers-reduced-motion: reduce)');
  if (ducks.length && !still.matches && 'IntersectionObserver' in window) {
    const MAX = 120; // furthest a duck strays from its spot, in px (less if the screen edge is closer)
    const EDGE = 8; // ducks stop this far from the edge of the screen
    const GAIN = 0.9; // px of paddling per px scrolled (the same for every duck, so they never bump)
    const TURN = 60; // px of scrolling the other way before turning round (stops twitchy turning on phones)

    type Duck = {
      el: HTMLElement;
      pos: number; // paddling: where it is now…
      target: number; // …and where it's heading
      form: number; // family formation shift: where it is now…
      formTarget: number; // …and where it's heading (0 = the order it was laid out in)
      ease: number;
      nudge: number; // place in the family, in px from the first duck
      visible: boolean;
    };
    // A "group" is one duck on its own, or a whole family; groups turn round as one
    type Group = { ducks: Duck[]; facingRight: boolean; startRight: boolean; span: number; push: number; lo: number; hi: number };

    const byFamily = new Map<string, Group>();
    const groups: Group[] = [];
    const all: Duck[] = [];
    for (const el of ducks) {
      const size = Number(el.dataset.duckSize) || 44;
      const d: Duck = {
        el,
        pos: 0,
        target: 0,
        form: 0,
        formTarget: 0,
        ease: 0.06 + (52 - size) * 0.002, // small ducks react a little quicker, so they don't move in lockstep
        nudge: Number(el.dataset.nudge) || 0,
        visible: false,
      };
      all.push(d);
      const facingRight = !el.classList.contains('is-flipped'); // the drawing faces right; flipped = facing left
      const fam = el.dataset.family;
      if (fam && byFamily.has(fam)) {
        byFamily.get(fam)!.ducks.push(d);
      } else {
        const g: Group = { ducks: [d], facingRight, startRight: facingRight, span: Number(el.dataset.span) || 0, push: 0, lo: -MAX, hi: MAX };
        groups.push(g);
        if (fam) byFamily.set(fam, g);
      }
    }

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        const d = all.find((x) => x.el === e.target);
        if (d) d.visible = e.isIntersecting;
      }
    });
    all.forEach((d) => io.observe(d.el));

    // How far each group can swim each way before a duck would reach the edge of the screen
    // (measured from where the ducks sit at rest; a family shares one range so it keeps its line-up)
    const measure = () => {
      const w = document.documentElement.clientWidth;
      for (const g of groups) {
        let lo = -MAX;
        let hi = MAX;
        for (const d of g.ducks) {
          const r = d.el.getBoundingClientRect();
          const shift = d.pos + d.form; // undo the current swim to find its resting place
          lo = Math.max(lo, EDGE - (r.left - shift));
          hi = Math.min(hi, w - EDGE - (r.right - shift));
        }
        g.lo = Math.min(0, lo);
        g.hi = Math.max(0, hi);
      }
    };
    measure();
    window.addEventListener('resize', measure);

    // Turning a family round mirrors its line-up, so the leader moves from one end to the other
    const turn = (g: Group, right: boolean) => {
      g.facingRight = right;
      const mirrored = right !== g.startRight;
      for (const d of g.ducks) {
        d.el.classList.toggle('is-flipped', !right);
        d.formTarget = mirrored ? g.span - 2 * d.nudge : 0;
      }
    };

    let lastY = window.scrollY;
    let running = false;
    const tick = () => {
      let moving = false;
      for (const d of all) {
        if (!d.visible) continue;
        d.pos += (d.target - d.pos) * d.ease;
        d.form += (d.formTarget - d.form) * 0.08; // swapping places is a gentle glide
        if (Math.abs(d.target - d.pos) > 0.15 || Math.abs(d.formTarget - d.form) > 0.15) moving = true;
        else {
          d.pos = d.target;
          d.form = d.formTarget;
        }
        d.el.style.setProperty('--swim', (d.pos + d.form).toFixed(2) + 'px');
      }
      running = moving;
      if (moving) requestAnimationFrame(tick);
    };
    const kick = () => {
      if (!running) {
        running = true;
        requestAnimationFrame(tick);
      }
    };

    window.addEventListener(
      'scroll',
      () => {
        const dy = window.scrollY - lastY;
        lastY = window.scrollY;
        if (!dy) return;
        const wantsRight = dy > 0;
        for (const g of groups) {
          if (!g.ducks.some((d) => d.visible)) continue;
          for (const d of g.ducks) d.target = Math.max(g.lo, Math.min(g.hi, d.target + dy * GAIN));
          if (wantsRight !== g.facingRight) {
            g.push += Math.abs(dy);
            if (g.push > TURN) {
              turn(g, wantsRight);
              g.push = 0;
            }
          } else g.push = 0;
        }
        kick();
      },
      { passive: true },
    );

    // If the setting changes while the page is open, settle the ducks back on their spots
    still.addEventListener('change', () => {
      if (!still.matches) return;
      for (const d of all) {
        d.target = d.pos = d.form = d.formTarget = 0;
        d.el.style.removeProperty('--swim');
      }
    });
  }
</script>
